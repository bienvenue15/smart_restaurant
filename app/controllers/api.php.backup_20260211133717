            // Calculate expected amount (opening + all sales during session for the restaurant)
            $query = "SELECT COALESCE(SUM(paid_amount), 0) as total_sales
                      FROM orders
                      WHERE restaurant_uuid = ? 
                      AND payment_status = 'paid'
                      AND paid_at >= ?";
            $stmt = $this->orderModel->db->prepare($query);
            $stmt->execute([$restaurantId, $session['opened_at']]);
            $totalSales = $stmt->fetchColumn();
            
            $expectedAmount = $session['opening_balance'] + $totalSales;
            $variance = $closingBalance - $expectedAmount;
            $notes = isset($data['notes']) ? $data['notes'] : '';
            
            // Update session
            $query = "UPDATE cash_sessions 
                      SET closing_balance = ?,
                          expected_balance = ?,
                          variance = ?,
                          closed_at = NOW(),
                          closed_by = ?,
                          status = 'closed',
                          notes = ?
                      WHERE uuid = ?";
