    /**
     * Cancel order (Customer) - Only pending or confirmed orders
     */
    private function customerCancelOrder() {
        if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Method not allowed'], 405);
            return;
        }
        
        // Validate session
        if (!isset($_SESSION['demo_mode']) || !$_SESSION['demo_mode']) {
            if (!isset($_SESSION['table_id'])) {
                $this->sendResponse(['status' => 'FAIL', 'message' => 'Session expired. Please scan QR code again.'], 401);
                return;
            }
        }
        
        // Extend device lock on activity
        $this->extendDeviceLockOnActivity();
        
        $input = file_get_contents('php://input');
        $data = json_decode($input, true);
        
        if (!isset($data['order_uuid'])) {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Missing order_uuid'], 400);
            return;
        }
        
        $orderUuid = $this->sanitize($data['order_uuid']);
        
        // Validate UUID format
        if (!preg_match('/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i', $orderUuid)) {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Invalid UUID format'], 400);
            return;
        }
        
        $tableId = $_SESSION['table_id'];
        
        // Get order details to verify ownership and status (query by UUID)
        $query = "SELECT uuid, order_number, status, table_uuid FROM orders WHERE uuid = ?";
        $stmt = $this->db->prepare($query);
        $stmt->execute([$orderUuid]);
        $order = $stmt->fetch(PDO::FETCH_ASSOC);
        
        if (!$order) {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Order not found'], 404);
            return;
        }
        
        // Verify order belongs to this table
        if ($order['table_uuid'] != $tableId) {
            error_log("[CUSTOMER CANCEL] Table mismatch - Order table: {$order['table_uuid']}, Session table: {$tableId}");
            $this->sendResponse(['status' => 'FAIL', 'message' => 'This order does not belong to your table'], 403);
            return;
        }
        
        // Check if order can be cancelled (only pending or confirmed)
        if (!in_array($order['status'], ['pending', 'confirmed'])) {
            $this->sendResponse([
                'status' => 'FAIL', 
                'message' => 'Order cannot be cancelled at this stage. It is already being prepared.'
            ], 400);
            return;
        }
        
        // Cancel the order (update by UUID)
        try {
            error_log("[CUSTOMER CANCEL] Cancelling order UUID: {$orderUuid}, Order#: {$order['order_number']}");
            
            $updateQuery = "UPDATE orders SET status = 'cancelled' WHERE uuid = ?";
            $updateStmt = $this->db->prepare($updateQuery);
            $success = $updateStmt->execute([$orderUuid]);
            
            if (!$success) {
                error_log("[CUSTOMER CANCEL] Update failed");
                $this->sendResponse(['status' => 'FAIL', 'message' => 'Failed to cancel order'], 500);
                return;
            }
            
            $rowCount = $updateStmt->rowCount();
            error_log("[CUSTOMER CANCEL] Rows affected: {$rowCount}");
            
            if ($rowCount === 0) {
                error_log("[CUSTOMER CANCEL] No rows updated");
                $this->sendResponse(['status' => 'FAIL', 'message' => 'Order could not be cancelled'], 500);
                return;
            }
            
            error_log("[CUSTOMER CANCEL] ✓ Order {$order['order_number']} cancelled successfully by customer");
            
            // Auto-release table if no active orders remain
            $this->autoReleaseTableIfNoActiveOrders($order['table_uuid']);
            
            $this->sendResponse([
                'status' => 'OK',
                'message' => 'Order cancelled successfully',
                'order_number' => $order['order_number']
            ]);
            
        } catch (PDOException $e) {
            error_log("[CUSTOMER CANCEL] Database error: " . $e->getMessage());
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Database error: ' . $e->getMessage()], 500);
        }
    }
    
