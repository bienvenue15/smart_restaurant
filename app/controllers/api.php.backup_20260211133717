    private function exportAsCSV($data, $filename, $type) {
        header('Content-Type: text/csv; charset=UTF-8');
        header('Content-Disposition: attachment; filename="' . $filename . '.csv"');
        header('Pragma: no-cache');
        header('Expires: 0');
        
        $output = fopen('php://output', 'w');
        
        // UTF-8 BOM for Excel
        fprintf($output, chr(0xEF).chr(0xBB).chr(0xBF));
        
        fputcsv($output, ['Restaurant Report - ' . ucfirst($type)]);
        fputcsv($output, ['Generated: ' . date('Y-m-d H:i:s')]);
        
        if (isset($data['date'])) {
            fputcsv($output, ['Date: ' . $data['date']]);
        } elseif (isset($data['week_start']) && isset($data['week_end'])) {
            fputcsv($output, ['Period: ' . $data['week_start'] . ' to ' . $data['week_end']]);
        } elseif (isset($data['month'])) {
            fputcsv($output, ['Month: ' . $data['month']]);
        } elseif (isset($data['year'])) {
            fputcsv($output, ['Year: ' . $data['year']]);
        } elseif (isset($data['start_date']) && isset($data['end_date'])) {
            fputcsv($output, ['Period: ' . $data['start_date'] . ' to ' . $data['end_date']]);
        }
        
        fputcsv($output, []);
        fputcsv($output, ['Summary']);
        fputcsv($output, ['Total Revenue', 'RWF ' . number_format($data['stats']['total_revenue'], 0)]);
        fputcsv($output, ['Total Orders', $data['stats']['total_orders']]);
        fputcsv($output, ['Average Order', 'RWF ' . number_format($data['stats']['average_order'], 0)]);
        if (isset($data['stats']['paid_orders'])) {
            fputcsv($output, ['Paid Orders', $data['stats']['paid_orders']]);
        }
        
        fclose($output);
        exit;
    }
    
