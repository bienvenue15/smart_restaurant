    /**
     * Staff create order for customers without smartphones
     */
    private function staffCreateOrder() {
        // Check permission
        Permission::require('create_order');
        
        // Check order limit
        $restaurantId = $_SESSION['staff_user']['restaurant_id'] ?? $this->restaurantId;
        if ($restaurantId) {
            $limitCheck = $this->subscriptionManager->checkLimit($restaurantId, 'orders');
            if (!$limitCheck['allowed']) {
                $this->sendResponse([
                    'status' => 'LIMIT_REACHED',
                    'message' => $limitCheck['message'],
                    'current' => $limitCheck['current'],
                    'limit' => $limitCheck['limit']
                ], 403);
                return;
            }
        }
        
        if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Invalid request method'], 400);
            return;
        }
        
        // Get JSON data
        $input = file_get_contents('php://input');
        $data = json_decode($input, true);
        
        if (!$data || !isset($data['table_id']) || !isset($data['items']) || empty($data['items'])) {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Invalid request data. Table ID and items are required.'], 400);
            return;
        }
        
        $tableId = intval($data['table_id']);
        $items = $data['items'];
        $specialInstructions = isset($data['special_instructions']) ? 
                               $this->sanitize($data['special_instructions']) : '';
        $customerName = isset($data['customer_name']) ? 
                       $this->sanitize($data['customer_name']) : '';
        $customerPhone = isset($data['customer_phone']) ? 
                        $this->sanitize($data['customer_phone']) : '';
        
        if ($tableId <= 0 || !is_array($items)) {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Invalid table ID or items'], 400);
            return;
        }
        
        // Get staff info
        $staffId = $_SESSION['staff_user']['id'] ?? 0;
        $restaurantId = $_SESSION['staff_user']['restaurant_id'] ?? 0;
        
        if ($staffId <= 0 || $restaurantId <= 0) {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Staff session invalid'], 401);
            return;
        }
        
        try {
            // Verify table belongs to staff's restaurant
            $query = "SELECT id, table_number, status FROM restaurant_tables WHERE uuid = ? AND restaurant_uuid = ?";
            $stmt = $this->orderModel->db->prepare($query);
            $stmt->execute([$tableId, $restaurantId]);
            $table = $stmt->fetch(PDO::FETCH_ASSOC);
            
            if (!$table) {
                $this->sendResponse(['status' => 'FAIL', 'message' => 'Table not found or access denied'], 404);
                return;
            }
            
            // Check if table is occupied - prevent creating new orders for occupied tables
            if ($table['status'] === 'occupied') {
                $this->sendResponse(['status' => 'FAIL', 'message' => 'This table is currently occupied. Cannot create a new order.'], 400);
                return;
            }
            
            // Validate and sanitize each item
            $sanitizedItems = [];
            $totalAmount = 0;
            
            foreach ($items as $item) {
                if (!isset($item['menu_item_id']) || !isset($item['quantity'])) {
                    $this->sendResponse(['status' => 'FAIL', 'message' => 'Invalid item data'], 400);
                    return;
                }
                
                $menuItemId = intval($item['menu_item_id']);
                $quantity = intval($item['quantity']);
                
                if ($menuItemId <= 0 || $quantity <= 0) {
                    continue; // Skip invalid items
                }
                
                // Get menu item details and verify it belongs to same restaurant
                $itemQuery = "SELECT mi.id, mi.name, mi.price, mi.is_available, mi.restaurant_id
                             FROM menu_items mi
                             WHERE mi.id = ? AND mi.restaurant_id = ?";
                $stmt = $this->orderModel->db->prepare($itemQuery);
                $stmt->execute([$menuItemId, $restaurantId]);
                $menuItem = $stmt->fetch(PDO::FETCH_ASSOC);
                
                if (!$menuItem) {
                    $this->sendResponse(['status' => 'FAIL', 'message' => "Menu item ID $menuItemId not found"], 404);
                    return;
                }
                
                if ($menuItem['is_available'] != 1) {
                    $this->sendResponse(['status' => 'FAIL', 'message' => "{$menuItem['name']} is currently unavailable"], 400);
                    return;
                }
                
                $price = floatval($menuItem['price']);
                $specialRequest = isset($item['special_request']) ? 
                                 $this->sanitize($item['special_request']) : '';
                
                $sanitizedItems[] = [
                    'menu_item_id' => $menuItemId,
                    'name' => $menuItem['name'],
                    'quantity' => $quantity,
                    'price' => $price,
                    'special_request' => $specialRequest
                ];
                
                $totalAmount += ($price * $quantity);
            }
            
            if (empty($sanitizedItems)) {
                $this->sendResponse(['status' => 'FAIL', 'message' => 'No valid items in order'], 400);
                return;
            }
            
            // Begin transaction
            $this->orderModel->db->beginTransaction();
            
            // Generate unique order number
            $orderNumber = 'ORD-' . date('Ymd') . '-' . strtoupper(substr(uniqid(), -6));
            
            // Create order
            $orderQuery = "INSERT INTO orders (restaurant_id, table_id, order_number, total_amount, status, special_instructions, customer_name, customer_phone, created_by_staff, created_at) 
                          VALUES (?, ?, ?, ?, 'confirmed', ?, ?, ?, ?, NOW())";
            $stmt = $this->orderModel->db->prepare($orderQuery);
            $stmt->execute([
                $restaurantId,
                $tableId,
                $orderNumber,
                $totalAmount, 
                $specialInstructions,
                $customerName,
                $customerPhone,
                $staffId
            ]);
            
            $orderId = $this->orderModel->db->lastInsertId();
            
            // Insert order items
            $itemQuery = "INSERT INTO order_items (restaurant_id, order_id, menu_item_id, quantity, unit_price, subtotal, special_request) 
                         VALUES (?, ?, ?, ?, ?, ?, ?)";
            $stmt = $this->orderModel->db->prepare($itemQuery);
            
            foreach ($sanitizedItems as $item) {
                $subtotal = $item['price'] * $item['quantity'];
                $stmt->execute([
                    $restaurantId,
                    $orderId,
                    $item['menu_item_id'],
                    $item['quantity'],
                    $item['price'],
                    $subtotal,
                    $item['special_request']
                ]);
            }
            
            // Update table status to occupied (only if it was available or reserved)
            $updateTable = "UPDATE restaurant_tables SET status = 'occupied' WHERE uuid = ? AND status IN ('available', 'reserved')";
            $stmt = $this->orderModel->db->prepare($updateTable);
            $stmt->execute([$tableId]);
            
            if ($stmt->rowCount() === 0) {
                // Table might already be occupied, log warning but don't fail
                error_log("Warning: Table $tableId status not updated, may already be occupied");
            }
            
            // Commit transaction
            $this->orderModel->db->commit();
            
            // Log audit trail
            Permission::logAudit('create_order', 'orders', $orderId, null, null, 
                                "Created order for table #{$table['table_number']} - " . count($sanitizedItems) . " items, Total: RWF " . number_format($totalAmount, 0));
            
            $this->sendResponse([
                'status' => 'OK', 
                'message' => 'Order created successfully',
                'order_id' => $orderId,
                'total_amount' => $totalAmount,
                'items_count' => count($sanitizedItems)
            ]);
            
        } catch (PDOException $e) {
            // Rollback on error
            if ($this->orderModel->db->inTransaction()) {
                $this->orderModel->db->rollBack();
            }
            
            error_log("Staff create order error: " . $e->getMessage());
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Database error creating order', 'error' => $e->getMessage()], 500);
        }
    }
    
