    </div>

    <script>
        const BASE_URL = '<?php echo BASE_URL; ?>';
        const IS_MANAGER = <?php echo $isManager ? 'true' : 'false'; ?>;
        let currentLiabilities = [];

        // Load statistics
        async function loadStats() {
            try {
                const response = await fetch(`${BASE_URL}/?req=api&action=staff_get_liability_stats&period=month`);
                const data = await response.json();
                
                if (data.status === 'OK') {
                    const summary = data.data.summary;
                    
                    document.getElementById('activeCount').textContent = summary.active_count || 0;
                    document.getElementById('activeAmount').textContent = `RWF ${formatNumber(summary.active_amount || 0)}`;
                    
                    document.getElementById('clearedCount').textContent = summary.cleared_count || 0;
                    document.getElementById('clearedAmount').textContent = `RWF ${formatNumber(summary.cleared_amount || 0)}`;
                    
                    document.getElementById('lossCount').textContent = summary.loss_count || 0;
                    document.getElementById('lossAmount').textContent = `RWF ${formatNumber(summary.loss_amount || 0)}`;
                    
                    document.getElementById('waivedCount').textContent = summary.waived_count || 0;
                    document.getElementById('waivedAmount').textContent = `RWF ${formatNumber(summary.waived_amount || 0)}`;
                    
                    // Load waiter list for filter
                    if (IS_MANAGER && data.data.by_waiter) {
                        loadWaiterFilter(data.data.by_waiter);
                    }
                }
            } catch (error) {
                console.error('Failed to load stats:', error);
            }
        }

        // Load waiter filter options
        function loadWaiterFilter(waiters) {
            const select = document.getElementById('filterWaiter');
            if (!select) return;
            
            select.innerHTML = '<option value="">All Waiters</option>';
            waiters.forEach(waiter => {
                const option = document.createElement('option');
                option.value = waiter.waiter_id;
                option.textContent = `${waiter.waiter_name} (${waiter.loss_count || 0} losses)`;
                select.appendChild(option);
            });
        }

        // Load liabilities
        async function loadLiabilities() {
            const container = document.getElementById('liabilitiesContainer');
            container.innerHTML = '<div class="loading"><i class="fas fa-spinner"></i><p>Loading...</p></div>';
            
            try {
                const status = document.getElementById('filterStatus')?.value || 'active';
                const endpoint = IS_MANAGER ? 'staff_get_all_liabilities' : 'staff_get_my_liabilities';
                const response = await fetch(`${BASE_URL}/?req=api&action=${endpoint}&status=${status}`);
                const data = await response.json();
                
                if (data.status === 'OK') {
                    const liabilities = IS_MANAGER ? data.data.liabilities : data.data.active_liabilities || data.data;
                    currentLiabilities = Array.isArray(liabilities) ? liabilities : [];
                    renderLiabilitiesTable(currentLiabilities);
                    
                    if (IS_MANAGER && data.data.summary) {
                        // Update stats from response
                        loadStats();
                    }
                } else {
                    container.innerHTML = `<div class="alert alert-danger"><i class="fas fa-exclamation-circle"></i><div>${data.message || 'Failed to load liabilities'}</div></div>`;
                }
            } catch (error) {
                console.error('Failed to load liabilities:', error);
                container.innerHTML = '<div class="alert alert-danger"><i class="fas fa-exclamation-circle"></i><div>Error loading liabilities</div></div>';
            }
        }

        // Render liabilities table
        function renderLiabilitiesTable(liabilities) {
            const container = document.getElementById('liabilitiesContainer');
            
            if (!liabilities || liabilities.length === 0) {
                container.innerHTML = `
                    <div class="empty-state">
                        <i class="fas fa-check-circle"></i>
                        <h3>No Liabilities Found</h3>
                        <p>All orders have been paid or no liabilities match the current filters.</p>
                    </div>
                `;
                return;
            }
            
            let html = `
                <table>
                    <thead>
                        <tr>
                            ${IS_MANAGER ? '<th>Waiter</th>' : ''}
                            <th>Order</th>
                            <th>Table</th>
                            <th>Amount</th>
                            <th>Created</th>
                            <th>Duration</th>
                            <th>Status</th>
                            ${IS_MANAGER ? '<th>Actions</th>' : ''}
                        </tr>
                    </thead>
                    <tbody>
            `;
            
            liabilities.forEach(liability => {
                const urgencyBadge = getUrgencyBadge(liability.hours_outstanding || 0, liability.status);
                const statusBadge = getStatusBadge(liability.status);
                
                html += `
                    <tr>
                        ${IS_MANAGER ? `<td>${escapeHtml(liability.waiter_name || 'Unknown')}</td>` : ''}
                        <td><strong>${escapeHtml(liability.order_number || '#' + liability.order_id)}</strong></td>
                        <td>${escapeHtml(liability.table_number || 'N/A')}</td>
                        <td><strong>RWF ${formatNumber(liability.order_amount)}</strong></td>
                        <td>${formatDate(liability.liability_created_at)}</td>
                        <td>${formatDuration(liability.hours_outstanding || 0)} ${urgencyBadge}</td>
                        <td>${statusBadge}</td>
                        ${IS_MANAGER ? `<td>${renderActions(liability)}</td>` : ''}
                    </tr>
                `;
            });
            
            html += '</tbody></table>';
            container.innerHTML = html;
        }

        // Render action buttons
        function renderActions(liability) {
            if (liability.status === 'active') {
                return `
                    <button class="btn btn-sm btn-danger" onclick="openLossModal(${liability.id})" title="Mark as Loss">
                        <i class="fas fa-exclamation-triangle"></i>
                    </button>
                    <button class="btn btn-sm btn-success" onclick="openWaiveModal(${liability.id})" title="Waive Liability">
                        <i class="fas fa-hand-holding-usd"></i>
                    </button>
                `;
            } else if (liability.status === 'loss') {
                return `
                    <button class="btn btn-sm btn-success" onclick="openWaiveModal(${liability.id})" title="Waive Liability">
                        <i class="fas fa-hand-holding-usd"></i> Waive
                    </button>
                `;
            }
            return '<span style="color: #999;">-</span>';
        }

        // Get urgency badge
        function getUrgencyBadge(hours, status) {
            if (status !== 'active') return '';
            if (hours > 2) return '<span class="badge badge-overdue">OVERDUE</span>';
            if (hours > 1) return '<span class="badge badge-warning">WARNING</span>';
            return '';
        }

        // Get status badge
        function getStatusBadge(status) {
            const badges = {
                'active': '<span class="badge badge-active">Active</span>',
                'cleared': '<span class="badge badge-cleared">Cleared</span>',
                'loss': '<span class="badge badge-loss">Loss</span>',
                'waived': '<span class="badge badge-waived">Waived</span>',
                'investigating': '<span class="badge" style="background: #9b59b6; color: white;">Investigating</span>'
            };
            return badges[status] || status;
        }

        // Mark as loss functions
        function openLossModal(liabilityId) {
            document.getElementById('lossLiabilityId').value = liabilityId;
            document.getElementById('lossReason').value = '';
            document.getElementById('lossModal').classList.add('active');
        }

        function closeLossModal() {
            document.getElementById('lossModal').classList.remove('active');
        }

        async function confirmMarkAsLoss() {
            const liabilityId = document.getElementById('lossLiabilityId').value;
            const reason = document.getElementById('lossReason').value.trim();
            
            if (!reason) {
                showAlert('Please provide a reason for marking this as a loss', 'danger');
                return;
            }
            
            try {
                const response = await fetch(`${BASE_URL}/?req=api&action=staff_mark_liability_loss`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ liability_id: parseInt(liabilityId), reason })
                });
                
                const data = await response.json();
                
                if (data.status === 'OK') {
                    showAlert('Liability marked as loss successfully', 'success');
                    closeLossModal();
                    loadLiabilities();
                    loadStats();
                } else {
                    showAlert(data.message || 'Failed to mark as loss', 'danger');
                }
            } catch (error) {
                console.error('Error:', error);
                showAlert('Error marking as loss', 'danger');
            }
        }

        // Waive liability functions
        function openWaiveModal(liabilityId) {
            document.getElementById('waiveLiabilityId').value = liabilityId;
            document.getElementById('waiveReason').value = '';
            document.getElementById('waiveModal').classList.add('active');
        }

        function closeWaiveModal() {
            document.getElementById('waiveModal').classList.remove('active');
        }

        async function confirmWaiveLiability() {
            const liabilityId = document.getElementById('waiveLiabilityId').value;
            const reason = document.getElementById('waiveReason').value.trim();
            
            if (!reason) {
                showAlert('Please provide a reason for waiving this liability', 'danger');
                return;
            }
            
            try {
                const response = await fetch(`${BASE_URL}/?req=api&action=staff_waive_liability`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ liability_id: parseInt(liabilityId), reason })
                });
                
                const data = await response.json();
                
                if (data.status === 'OK') {
                    const message = data.requires_approval 
                        ? 'Liability waived - pending approval for large amount' 
                        : 'Liability waived successfully';
                    showAlert(message, 'success');
                    closeWaiveModal();
                    loadLiabilities();
                    loadStats();
                } else {
                    showAlert(data.message || 'Failed to waive liability', 'danger');
                }
            } catch (error) {
                console.error('Error:', error);
                showAlert('Error waiving liability', 'danger');
            }
        }

        function closeDetailsModal() {
            document.getElementById('detailsModal').classList.remove('active');
        }

        // Utility functions
        function formatNumber(num) {
            return parseFloat(num || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function formatDate(dateString) {
            if (!dateString) return 'N/A';
            const date = new Date(dateString);
            return date.toLocaleString('en-US', { 
                month: 'short', 
                day: 'numeric', 
                hour: '2-digit', 
                minute: '2-digit' 
            });
        }

        function formatDuration(hours) {
            hours = parseFloat(hours) || 0;
            if (hours < 1) return `${Math.round(hours * 60)}m`;
            if (hours < 24) return `${Math.round(hours * 10) / 10}h`;
            return `${Math.round(hours / 24)}d`;
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        function showAlert(message, type = 'info') {
            const container = document.getElementById('alertContainer');
            const icons = {
                success: 'check-circle',
                danger: 'exclamation-circle',
                warning: 'exclamation-triangle',
                info: 'info-circle'
            };
            
            container.innerHTML = `
                <div class="alert alert-${type}">
                    <i class="fas fa-${icons[type]}"></i>
                    <div>${message}</div>
                </div>
            `;
            
            setTimeout(() => {
                container.innerHTML = '';
            }, 5000);
        }

        <?php if ($isManager): ?>
        // Load waiter performance summary
        async function loadPerformanceSummary() {
            try {
                const response = await fetch(`${BASE_URL}/?req=api&action=staff_get_waiter_performance`, {
                    credentials: 'include'
                });
                
                if (!response.ok) throw new Error('HTTP ' + response.status);
                
                const data = await response.json();
                
                if (data.status === 'OK' && data.data) {
                    displayPerformanceSummary(data.data);
                } else {
                    document.getElementById('performanceContainer').innerHTML = `
                        <div style="text-align: center; padding: 40px; color: #999;">
                            <i class="fas fa-exclamation-circle" style="font-size: 48px; margin-bottom: 15px;"></i>
                            <p>${data.message || 'No performance data available'}</p>
                        </div>
                    `;
                }
            } catch (error) {
                console.error('[Performance] Error:', error);
                document.getElementById('performanceContainer').innerHTML = `
                    <div style="text-align: center; padding: 40px; color: #e74c3c;">
                        <i class="fas fa-exclamation-triangle" style="font-size: 48px; margin-bottom: 15px;"></i>
                        <p>Failed to load performance data</p>
                    </div>
                `;
            }
        }

        // Display performance summary
        function displayPerformanceSummary(waiters) {
            const container = document.getElementById('performanceContainer');
            
            if (!waiters || waiters.length === 0) {
                container.innerHTML = `
                    <div style="text-align: center; padding: 40px; color: #999;">
                        <i class="fas fa-users" style="font-size: 48px; margin-bottom: 15px;"></i>
                        <p>No waiter performance data available</p>
                    </div>
                `;
                return;
            }

            let html = `
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Waiter</th>
                                <th>Active Liabilities</th>
                                <th>Total Amount</th>
                                <th>Oldest Liability</th>
                                <th>Performance</th>
                            </tr>
                        </thead>
                        <tbody>
            `;

            waiters.forEach(waiter => {
                const amount = parseFloat(waiter.total_amount) || 0;
                const count = parseInt(waiter.liability_count) || 0;
                
                let performanceBadge = '';
                
                if (count === 0) {
                    performanceBadge = '<span class="badge" style="background: #27ae60;">Excellent</span>';
                } else if (amount < 5000) {
                    performanceBadge = '<span class="badge" style="background: #3498db;">Good</span>';
                } else if (amount < 20000) {
                    performanceBadge = '<span class="badge" style="background: #f39c12;">Fair</span>';
                } else {
                    performanceBadge = '<span class="badge" style="background: #e74c3c;">Needs Attention</span>';
                }

                html += `
                    <tr>
                        <td>
                            <strong>${escapeHtml(waiter.full_name)}</strong><br>
                            <small style="color: #999;">${escapeHtml(waiter.role)}</small>
                        </td>
                        <td>
                            <span class="badge" style="background: ${count > 0 ? '#e74c3c' : '#95a5a6'};">
                                ${count}
                            </span>
                        </td>
                        <td>
                            <strong style="color: ${amount > 10000 ? '#e74c3c' : '#2c3e50'};">
                                RWF ${amount.toLocaleString()}
                            </strong>
                        </td>
                        <td>N/A</td>
                        <td>${performanceBadge}</td>
                    </tr>
                `;
            });

            html += `
                        </tbody>
                    </table>
                </div>
            `;

            container.innerHTML = html;
        }
        <?php endif; ?>

        // Initial load
        document.addEventListener('DOMContentLoaded', () => {
            loadStats();
            loadLiabilities();
            <?php if ($isManager): ?>
            loadPerformanceSummary();
            <?php endif; ?>
            
            // Auto-refresh every 60 seconds
            setInterval(() => {
                loadStats();
                if (document.getElementById('filterStatus')?.value === 'active') {
                    loadLiabilities();
                }
                <?php if ($isManager): ?>
                loadPerformanceSummary();
                <?php endif; ?>
            }, 60000);
        });

        // Close modals on escape key
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                closeLossModal();
                closeWaiveModal();
                closeDetailsModal();
            }
        });
        
        // Mobile menu toggle functions
        function toggleMobileMenu() {
            const sidebar = document.querySelector('.sidebar');
            const overlay = document.querySelector('.mobile-overlay');
            if (sidebar && overlay) {
                sidebar.classList.toggle('mobile-open');
                overlay.classList.toggle('active');
                document.body.style.overflow = sidebar.classList.contains('mobile-open') ? 'hidden' : '';
            }
        }
        
        function closeMobileMenu() {
            const sidebar = document.querySelector('.sidebar');
            const overlay = document.querySelector('.mobile-overlay');
            if (sidebar && overlay) {
                sidebar.classList.remove('mobile-open');
                overlay.classList.remove('active');
                document.body.style.overflow = '';
            }
        }
    </script>
</body>
</html>
