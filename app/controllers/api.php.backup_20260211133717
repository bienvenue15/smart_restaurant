    /**
     * Check device lock status (Customer)
     */
    private function checkDeviceLock() {
        $baseDir = dirname(dirname(__DIR__));
        require_once $baseDir . '/app/core/DeviceTableLock.php';
        
        $deviceFingerprint = DeviceTableLock::generateFingerprint();
        $restaurantId = $this->restaurantId ?? ($_SESSION['restaurant_id'] ?? null);
        
        if (!$restaurantId) {
            $this->sendResponse([
                'status' => 'OK',
                'locked' => false,
                'message' => 'No restaurant context - not locked',
                'device_fingerprint' => substr($deviceFingerprint, 0, 16) . '...'
            ]);
            return;
        }
        
        try {
            $deviceLock = new DeviceTableLock();
            $lock = $deviceLock->getDeviceLock($deviceFingerprint, $restaurantId);
            
            if ($lock) {
                $this->sendResponse([
                    'status' => 'OK',
                    'locked' => true,
                    'table_id' => $lock['table_id'],
                    'table_number' => $lock['table_number'],
                    'locked_at' => $lock['locked_at'],
                    'expires_at' => $lock['expires_at'],
                    'device_fingerprint' => substr($deviceFingerprint, 0, 16) . '...'
                ]);
            } else {
                $this->sendResponse([
                    'status' => 'OK',
                    'locked' => false,
                    'device_fingerprint' => substr($deviceFingerprint, 0, 16) . '...'
                ]);
            }
        } catch (Exception $e) {
            error_log('[API] checkDeviceLock error: ' . $e->getMessage());
            $this->sendResponse([
                'status' => 'OK',
                'locked' => false,
                'error' => $e->getMessage(),
                'device_fingerprint' => substr($deviceFingerprint, 0, 16) . '...'
            ]);
        }
    }
    
