# ============================================================
# Smart Restaurant — Environment Configuration (new stack)
# Copy to .env and fill in real values. Never commit .env.
#
# NOTE ON THE LEGACY APP: src/config.php hardcoded production DB/SMTP
# credentials as PHP fallback defaults (docs/SECURITY_AUDIT.md #1). The
# new backend fails to start if any of the required variables below are
# missing — there is no hardcoded fallback anywhere in the new codebase.
# ============================================================

# ---------- Database ----------
DATABASE_URL=postgresql://smartresto:changeme@localhost:5432/smartresto?schema=public
POSTGRES_USER=smartresto
POSTGRES_PASSWORD=changeme
POSTGRES_DB=smartresto

# ---------- Backend ----------
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# JWT secrets — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---------- Frontend ----------
NUXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# ---------- Email (optional, leave unset to no-op sends in dev) ----------
MAIL_DISABLE_DELIVERY=true
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Smart Restaurant
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_SMTP_ENCRYPTION=tls

# ---------- Seeding ----------
# Set to "true" only in local/dev to seed a demo restaurant + admin user.
SEED_DEMO_DATA=false
