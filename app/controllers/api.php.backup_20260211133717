     * Accept waiter call - First come first serve (waiter, manager, admin only)
     */
    private function staffAcceptCall() {
        if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Method not allowed'], 405);
            return;
        }
        
        $input = file_get_contents('php://input');
        $data = json_decode($input, true);
        
        if (!$data || !isset($data['call_id'])) {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Missing call_id'], 400);
            return;
        }
        
        $callId = intval($data['call_id']);
        $staffId = $_SESSION['staff_uuid'];
        
        try {
            // Check if call is still pending and unassigned (with restaurant filter)
            $checkQuery = "SELECT id, status, assigned_to FROM waiter_calls WHERE uuid = ? AND restaurant_uuid = ? FOR UPDATE";
            $stmt = $this->orderModel->db->prepare($checkQuery);
            $stmt->execute([$callId, $this->restaurantId]);
            $call = $stmt->fetch(PDO::FETCH_ASSOC);
            
            if (!$call) {
                $this->sendResponse(['status' => 'FAIL', 'message' => 'Call not found or access denied'], 404);
                return;
            }
            
            if ($call['status'] !== 'pending') {
                $this->sendResponse(['status' => 'FAIL', 'message' => 'Call already processed'], 400);
                return;
            }
            
            if (!empty($call['assigned_to']) && $call['assigned_to'] != $staffId) {
                $this->sendResponse(['status' => 'FAIL', 'message' => 'Call already assigned to another waiter'], 400);
                return;
            }
            
            // Assign to first waiter who accepts
            $updateQuery = "UPDATE waiter_calls SET assigned_to = ?, status = 'acknowledged', assigned_at = NOW() WHERE uuid = ? AND restaurant_uuid = ?";
            $stmt = $this->orderModel->db->prepare($updateQuery);
            $stmt->execute([$staffId, $callId, $this->restaurantId]);
            
            if ($stmt->rowCount() === 0) {
                $this->sendResponse(['status' => 'FAIL', 'message' => 'Failed to accept call'], 500);
                return;
            }
            
            Permission::logAudit('accept_waiter_call', 'waiter_calls', $callId, 'pending', 'acknowledged');
            
            $this->sendResponse(['status' => 'OK', 'message' => 'Call accepted! You are now assigned to this table.']);
            
        } catch (PDOException $e) {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Database error', 'error' => $e->getMessage()], 500);
        }
    }
    
