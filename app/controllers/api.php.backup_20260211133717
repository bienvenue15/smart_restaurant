    private function staffMarkLiabilityLoss() {
        Permission::require('manage_staff');
        
        if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Method not allowed'], 405);
            return;
        }
        
        $input = file_get_contents('php://input');
        $data = json_decode($input, true);
        
        if (!$data || !isset($data['liability_uuid']) || !isset($data['reason'])) {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Missing required fields (liability_uuid, reason)'], 400);
            return;
        }
        
        // Validate UUID format
        if (!UuidHelper::isValidUuid($data['liability_uuid'])) {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Invalid UUID format. For security, only UUIDs are accepted, not integer IDs.'], 400);
            return;
