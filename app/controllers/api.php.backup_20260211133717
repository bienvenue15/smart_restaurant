    /**
     * Create a new order
     */
    private function createOrder() {
        // Comprehensive API validation
        $validation = ApiValidator::validateRequest([
            'methods' => ['POST'],
            'require_json' => true,
            'require_auth' => false, // Session checked separately for demo mode
            'required_params' => ['table_id', 'items'],
            'max_size' => 5242880, // 5MB
            'rate_limit' => [
                'identifier' => $_SERVER['REMOTE_ADDR'],
                'max' => 50,
                'window' => 60
            ]
        ]);
        
        if (!$validation['valid']) {
            ApiValidator::sendError($validation['error']);
            return;
        }
        
        $data = $validation['data'];
        
        // Validate session (unless demo mode)
        if (!isset($_SESSION['demo_mode']) || !$_SESSION['demo_mode']) {
            if (!isset($_SESSION['table_id'])) {
                $this->sendResponse(['status' => 'FAIL', 'message' => 'Session expired. Please scan QR code again.'], 401);
                return;
            }
        }
        
        // Extend device lock on activity
        $this->extendDeviceLockOnActivity();
        
        // Sanitize and validate table_id
        $tableId = $data['table_id'] ?? '';
        $items = $data['items'];
        $specialInstructions = $data['special_instructions'] ?? '';
        
        // Server-side validation
        $tableError = ValidationHelper::required($tableId, 'Table ID') ?? ValidationHelper::integer($tableId, 'Table ID');
        if ($tableError) {
            $this->sendResponse(['status' => 'FAIL', 'message' => $tableError], 400);
            return;
        }
        
        $tableId = intval($tableId);
        
        // Validate special instructions length
        if (!empty($specialInstructions)) {
            $lengthError = ValidationHelper::length($specialInstructions, 0, 500, 'Special instructions');
            if ($lengthError) {
                $this->sendResponse(['status' => 'FAIL', 'message' => $lengthError], 400);
                return;
            }
        }
        
        $specialInstructions = ValidationHelper::sanitize($specialInstructions);
        
        // Verify table_id matches session (security check)
        if (!isset($_SESSION['demo_mode']) || !$_SESSION['demo_mode']) {
            if ($tableId !== $_SESSION['table_id']) {
                $this->sendResponse(['status' => 'FAIL', 'message' => 'Table ID mismatch. Security violation.'], 403);
                return;
            }
        }
        
        if ($tableId <= 0 || empty($items) || !is_array($items)) {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Invalid order data'], 400);
            return;
        }
        
        // Validate and sanitize each item
        $sanitizedItems = [];
        foreach ($items as $index => $item) {
            if (!isset($item['id']) || !isset($item['quantity']) || !isset($item['price'])) {
                $this->sendResponse(['status' => 'FAIL', 'message' => 'Invalid item data at position ' . ($index + 1)], 400);
                return;
            }
            
            // Validate item fields
            $itemIdError = ValidationHelper::integer($item['id'], 'Item ID');
            $quantityError = ValidationHelper::range($item['quantity'], 1, 100, 'Quantity');
            $priceError = ValidationHelper::range($item['price'], 0, 9999999, 'Price');
            
            if ($itemIdError || $quantityError || $priceError) {
                $error = $itemIdError ?? $quantityError ?? $priceError;
                $this->sendResponse(['status' => 'FAIL', 'message' => "Item " . ($index + 1) . ": " . $error], 400);
                return;
            }
            
            $sanitizedItems[] = [
                'id' => intval($item['id']),
                'quantity' => intval($item['quantity']),
                'price' => floatval($item['price']),
                'special_request' => isset($item['special_request']) ? 
                                   ValidationHelper::sanitize(substr($item['special_request'], 0, 200)) : ''
            ];
        }
        
        // Create order
        $result = $this->orderModel->createOrder($tableId, $sanitizedItems, $specialInstructions);
        
        // If order created successfully, ensure device is locked to the table
        if ($result['status'] === 'OK' && !isset($_SESSION['demo_mode'])) {
            try {
                require_once __DIR__ . '/../core/DeviceTableLock.php';
                $deviceFingerprint = $_SESSION['device_fingerprint'] ?? DeviceTableLock::generateFingerprint();
                
                // Get restaurant_id from session
                $restaurantId = $_SESSION['restaurant_id'] ?? null;
                
                if ($restaurantId && $deviceFingerprint) {
                    $deviceLock = new DeviceTableLock();
                    
                    // Lock device to table (2 hour duration)
                    $lockResult = $deviceLock->lockDeviceToTable($restaurantId, $tableId, $deviceFingerprint, 120);
                    
                    if ($lockResult['success']) {
                        error_log("[ORDER_CREATE] ✓ Device locked to table $tableId after order placement");
                        
                        // Link lock to order if we have order ID
                        if (isset($result['data']['order_id']) && isset($lockResult['lock_id'])) {
                            $deviceLock->linkLockToOrder($lockResult['lock_id'], $result['data']['order_id']);
                        }
                    } else {
                        error_log("[ORDER_CREATE] ⚠ Failed to lock device: " . $lockResult['message']);
                    }
                }
            } catch (Exception $e) {
                error_log("[ORDER_CREATE] Device lock error: " . $e->getMessage());
                // Don't fail order creation if device lock fails
            }
        }
        
        // Kitchen will be notified when order is confirmed by waiter, not on initial creation
        
        $this->sendResponse($result);
    }
    
