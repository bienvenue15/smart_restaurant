    /**
     * Get current cash session
     */
    private function staffGetCashSession() {
        if (!Permission::check('handle_cash')) {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Permission denied. You need cash handling permissions.'], 403);
            return;
        }
        
        $restaurantId = $_SESSION['staff_user']['restaurant_id'] ?? null;
        
        if (!$restaurantId) {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Restaurant context not found'], 401);
            return;
        }
        
        try {
            // Get the restaurant's active session (regardless of who opened it)
            $query = "SELECT cs.*, 
                      su.full_name as opened_by,
                      COALESCE(SUM(o.paid_amount), 0) as sales_today,
                      COUNT(DISTINCT o.id) as transaction_count
                      FROM cash_sessions cs
                      LEFT JOIN staff_users su ON cs.staff_id = su.id
                      LEFT JOIN orders o ON o.restaurant_id = cs.restaurant_id 
                          AND o.payment_status = 'paid'
                          AND o.paid_at >= cs.opened_at
                      WHERE cs.restaurant_id = ? AND cs.status = 'open'
                      GROUP BY cs.id
                      LIMIT 1";
            $stmt = $this->orderModel->db->prepare($query);
            $stmt->execute([$restaurantId]);
            $session = $stmt->fetch(PDO::FETCH_ASSOC);
            
            if ($session) {
                // Get all cash transactions for this session to calculate accurate cash_in_hand
                $transQuery = "SELECT 
                    COALESCE(SUM(CASE 
                        WHEN transaction_type IN ('sale', 'deposit') THEN amount
                        WHEN transaction_type IN ('expense', 'withdrawal', 'refund') THEN -amount
                        ELSE 0 
                    END), 0) as transaction_total
                    FROM cash_transactions 
                    WHERE cash_session_id = ?";
                $transStmt = $this->orderModel->db->prepare($transQuery);
                $transStmt->execute([$session['id']]);
                $transactionTotal = $transStmt->fetchColumn();
                
                // Calculate accurate cash_in_hand: opening + sales + transactions
                $session['cash_in_hand'] = floatval($session['opening_balance']) + floatval($session['sales_today']) + floatval($transactionTotal);
                $session['transaction_adjustments'] = $transactionTotal;
                
                $this->sendResponse(['status' => 'OK', 'data' => $session]);
            } else {
                $this->sendResponse(['status' => 'OK', 'data' => null, 'message' => 'No open session']);
            }
            
        } catch (PDOException $e) {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Database error', 'error' => $e->getMessage()], 500);
        }
    }
    
