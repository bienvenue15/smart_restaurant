// Smart Restaurant — PostgreSQL schema
// See docs/DATABASE_MIGRATION_PLAN.md for the full legacy-to-new mapping rationale.
// Design decisions: UUID primary keys everywhere (not the legacy int auto-increment
// scheme), real foreign keys on every relationship (legacy enforced only 2 of 32),
// native Postgres enums extracted from the legacy MySQL ENUM columns.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────

enum StaffRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  WAITER
  KITCHEN
  CASHIER
}

enum SecurityLevel {
  STANDARD
  ELEVATED
  ADMIN
}

enum SubscriptionPlanName {
  TRIAL
  BASIC
  PREMIUM
  ENTERPRISE
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum OrderItemStatus {
  PENDING
  PREPARING
  READY
  SERVED
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_MONEY
  BANK_TRANSFER
}

enum PaymentRecordStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum AdjustmentType {
  DISCOUNT
  REFUND
  VOID
  COMP
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PermissionCategory {
  ORDERS
  PAYMENTS
  TABLES
  MENU
  STAFF
  REPORTS
  SYSTEM
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ShiftStatus {
  ACTIVE
  COMPLETED
  BREAK
}

enum WaiterCallRequestType {
  ORDER
  ASSISTANCE
  BILL
  COMPLAINT
  OTHER
}

enum WaiterCallPriority {
  LOW
  NORMAL
  HIGH
}

enum WaiterCallStatus {
  PENDING
  ACKNOWLEDGED
  COMPLETED
  CANCELLED
}

enum LiabilityStatus {
  ACTIVE
  CLEARED
  LOSS
  WAIVED
  INVESTIGATING
}

enum DeductionStatus {
  NONE
  PENDING
  DEDUCTED
  DISPUTED
}

enum CashSessionStatus {
  OPEN
  CLOSED
  AUDITING
  DISCREPANCY
}

enum CashTransactionType {
  SALE
  REFUND
  EXPENSE
  DEPOSIT
  WITHDRAWAL
  ADJUSTMENT
}

enum SupportMessageChannel {
  EMAIL
  CHAT
  PHONE
  WEB
}

enum SupportMessageStatus {
  NEW
  READ
  ARCHIVED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SupportTicketChannel {
  EMAIL
  CHAT
  PHONE
  IN_APP
}

enum ReplySenderType {
  RESTAURANT
  SUPPORT
  SYSTEM
}

enum SystemNotificationType {
  INFO
  SUCCESS
  WARNING
  DANGER
}

enum SystemNotificationContext {
  SYSTEM
  BILLING
  SUPPORT
  SECURITY
}

enum AnnouncementType {
  INFO
  WARNING
  SUCCESS
  DANGER
  PROMOTION
}

enum AnnouncementAudience {
  ALL
  STAFF
  CUSTOMERS
  ADMINS
}

enum AnnouncementPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// ─────────────────────────────────────────────────────────────────────────
// Tenant root
// ─────────────────────────────────────────────────────────────────────────

model Restaurant {
  id                String               @id @default(uuid()) @db.Uuid
  name              String
  slug              String               @unique
  email             String               @unique
  phone             String?
  tin               String?
  address           String?
  city              String?
  country           String               @default("Rwanda")
  currency          String               @default("RWF")
  timezone          String               @default("Africa/Kigali")
  logoUrl           String?              @map("logo_url")
  primaryColor      String               @default("#2563eb") @map("primary_color")
  secondaryColor    String               @default("#1e40af") @map("secondary_color")
  taxRate           Decimal              @default(0) @map("tax_rate") @db.Decimal(5, 2)
  serviceCharge     Decimal              @default(0) @map("service_charge") @db.Decimal(5, 2)
  isActive          Boolean              @default(true) @map("is_active")
  maxTables         Int                  @default(50) @map("max_tables")
  maxUsers          Int                  @default(20) @map("max_users")
  subscriptionPlan  SubscriptionPlanName @default(TRIAL) @map("subscription_plan")
  subscriptionStart DateTime?            @map("subscription_start") @db.Date
  subscriptionEnd   DateTime?            @map("subscription_end") @db.Date
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  staffUsers        StaffUser[]
  menuCategories    MenuCategory[]
  menuItems         MenuItem[]
  tables            RestaurantTable[]
  orders            Order[]
  payments          Payment[]
  settings          RestaurantSetting[]
  waiterCalls       WaiterCall[]
  waiterLiabilities WaiterLiability[]
  cashSessions      CashSession[]
  cashTransactions  CashTransaction[]
  deviceTableLocks  DeviceTableLock[]
  notifications     Notification[]
  announcements     Announcement[]
  auditTrail        AuditTrail[]
  supportMessages   SupportMessage[]
  supportTickets    SupportTicket[]

  @@map("restaurants")
}

// ─────────────────────────────────────────────────────────────────────────
// Staff / RBAC
// ─────────────────────────────────────────────────────────────────────────

model StaffUser {
  id                 String        @id @default(uuid()) @db.Uuid
  restaurantId       String?       @map("restaurant_id") @db.Uuid
  restaurant         Restaurant?   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  username           String        @unique
  passwordHash       String        @map("password_hash")
  fullName           String        @map("full_name")
  email              String?
  phone              String?
  role               StaffRole
  isActive           Boolean       @default(true) @map("is_active")
  canHandleCash      Boolean       @default(false) @map("can_handle_cash")
  maxDiscountPercent Decimal       @default(0) @map("max_discount_percent") @db.Decimal(5, 2)
  securityLevel      SecurityLevel @default(STANDARD) @map("security_level")
  lastLoginAt        DateTime?     @map("last_login_at") @db.Timestamptz
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  confirmedOrders      Order[]                 @relation("OrderConfirmedBy")
  servedOrders         Order[]                 @relation("OrderServedBy")
  paidOrders           Order[]                 @relation("OrderPaidTo")
  createdOrders        Order[]                 @relation("OrderCreatedByStaff")
  receivedPayments     Payment[]               @relation("PaymentReceivedBy")
  verifiedPayments     Payment[]               @relation("PaymentVerifiedBy")
  assignedWaiterCalls  WaiterCall[]            @relation("WaiterCallAssignedTo")
  liabilities          WaiterLiability[]       @relation("LiabilityWaiter")
  clearedLiabilities   WaiterLiability[]       @relation("LiabilityClearedBy")
  cashSessions         CashSession[]
  closedCashSessions   CashSession[]           @relation("CashSessionClosedBy")
  cashTransactions     CashTransaction[]
  shifts               StaffShift[]
  activityLog          StaffActivityLog[]
  notifications        Notification[]
  tableResets          TableReset[]
  announcementDismiss  AnnouncementDismissal[]
  auditTrail           AuditTrail[]
  supportTicketsOwned  SupportTicket[]
  supportTicketReplies SupportTicketReply[]

  @@index([restaurantId])
  @@map("staff_users")
}

model Permission {
  id               String             @id @default(uuid()) @db.Uuid
  code             String             @unique
  name             String
  description      String?
  category         PermissionCategory
  riskLevel        RiskLevel          @default(LOW) @map("risk_level")
  requiresApproval Boolean            @default(false) @map("requires_approval")
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id             String     @id @default(uuid()) @db.Uuid
  role           StaffRole
  permissionCode String     @map("permission_code")
  permission     Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz

  @@unique([role, permissionCode])
  @@map("role_permissions")
}

model StaffShift {
  id           String      @id @default(uuid()) @db.Uuid
  staffId      String      @map("staff_id") @db.Uuid
  staff        StaffUser   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  restaurantId String      @map("restaurant_id") @db.Uuid
  clockIn      DateTime    @default(now()) @map("clock_in") @db.Timestamptz
  clockOut     DateTime?   @map("clock_out") @db.Timestamptz
  status       ShiftStatus @default(ACTIVE)
  notes        String?
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  @@index([staffId, status])
  @@map("staff_shifts")
}

model StaffActivityLog {
  id          String    @id @default(uuid()) @db.Uuid
  staffId     String    @map("staff_id") @db.Uuid
  staff       StaffUser @relation(fields: [staffId], references: [id], onDelete: Cascade)
  action      String
  description String?
  ipAddress   String?   @map("ip_address")
  userAgent   String?   @map("user_agent")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([staffId])
  @@map("staff_activity_log")
}

// ─────────────────────────────────────────────────────────────────────────
// Menu
// ─────────────────────────────────────────────────────────────────────────

model MenuCategory {
  id           String     @id @default(uuid()) @db.Uuid
  restaurantId String     @map("restaurant_id") @db.Uuid
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  displayOrder Int        @default(0) @map("display_order")
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz

  items MenuItem[]

  @@index([restaurantId])
  @@map("menu_categories")
}

model MenuItem {
  id              String       @id @default(uuid()) @db.Uuid
  restaurantId    String       @map("restaurant_id") @db.Uuid
  restaurant      Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categoryId      String       @map("category_id") @db.Uuid
  category        MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  price           Decimal      @db.Decimal(10, 2)
  imageUrl        String?      @map("image_url")
  isAvailable     Boolean      @default(true) @map("is_available")
  isSpecial       Boolean      @default(false) @map("is_special")
  displayOrder    Int          @default(0) @map("display_order")
  preparationTime Int          @default(15) @map("preparation_time")
  dietaryInfo     String?      @map("dietary_info")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  orderItems OrderItem[]

  @@index([restaurantId])
  @@index([categoryId])
  @@map("menu_items")
}

// ─────────────────────────────────────────────────────────────────────────
// Tables / QR / device locking
// ─────────────────────────────────────────────────────────────────────────

model RestaurantTable {
  id             String      @id @default(uuid()) @db.Uuid
  restaurantId   String      @map("restaurant_id") @db.Uuid
  restaurant     Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableNumber    String      @map("table_number")
  qrCode         String      @unique @map("qr_code")
  seats          Int         @default(4)
  status         TableStatus @default(AVAILABLE)
  lastOccupiedAt DateTime?   @map("last_occupied_at") @db.Timestamptz
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  orders           Order[]
  waiterCalls      WaiterCall[]
  deviceTableLocks DeviceTableLock[]
  tableResets      TableReset[]

  @@index([restaurantId])
  @@map("restaurant_tables")
}

model DeviceTableLock {
  id                String          @id @default(uuid()) @db.Uuid
  restaurantId      String          @map("restaurant_id") @db.Uuid
  restaurant        Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableId           String          @map("table_id") @db.Uuid
  table             RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  deviceFingerprint String          @map("device_fingerprint")
  ipAddress         String?         @map("ip_address")
  userAgent         String?         @map("user_agent")
  lockedAt          DateTime        @default(now()) @map("locked_at") @db.Timestamptz
  expiresAt         DateTime        @map("expires_at") @db.Timestamptz
  lastActivity      DateTime        @default(now()) @map("last_activity") @db.Timestamptz
  orderId           String?         @map("order_id") @db.Uuid
  isActive          Boolean         @default(true) @map("is_active")

  @@index([deviceFingerprint])
  @@index([restaurantId, tableId])
  @@index([isActive, expiresAt])
  @@map("device_table_locks")
}

model TableReset {
  id             String          @id @default(uuid()) @db.Uuid
  tableId        String          @map("table_id") @db.Uuid
  table          RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  staffId        String          @map("staff_id") @db.Uuid
  staff          StaffUser       @relation(fields: [staffId], references: [id], onDelete: Cascade)
  previousStatus TableStatus?    @map("previous_status")
  newStatus      TableStatus?    @map("new_status")
  notes          String?
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz

  @@map("table_resets")
}

// ─────────────────────────────────────────────────────────────────────────
// Orders
// ─────────────────────────────────────────────────────────────────────────

model Order {
  id                  String          @id @default(uuid()) @db.Uuid
  restaurantId        String          @map("restaurant_id") @db.Uuid
  restaurant          Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableId             String          @map("table_id") @db.Uuid
  table               RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Restrict)
  orderNumber         String          @unique @map("order_number")
  status              OrderStatus     @default(PENDING)
  totalAmount         Decimal         @default(0) @map("total_amount") @db.Decimal(10, 2)
  specialInstructions String?         @map("special_instructions")
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  confirmedById String?    @map("confirmed_by") @db.Uuid
  confirmedBy   StaffUser? @relation("OrderConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  confirmedAt   DateTime?  @map("confirmed_at") @db.Timestamptz

  servedById String?    @map("served_by") @db.Uuid
  servedBy   StaffUser? @relation("OrderServedBy", fields: [servedById], references: [id], onDelete: SetNull)
  servedAt   DateTime?  @map("served_at") @db.Timestamptz

  paymentStatus PaymentStatus @default(UNPAID) @map("payment_status")
  paymentMethod String?       @map("payment_method")
  paidAmount    Decimal       @default(0) @map("paid_amount") @db.Decimal(10, 2)
  paidAt        DateTime?     @map("paid_at") @db.Timestamptz
  paidToId      String?       @map("paid_to") @db.Uuid
  paidTo        StaffUser?    @relation("OrderPaidTo", fields: [paidToId], references: [id], onDelete: SetNull)

  createdByStaffId String?    @map("created_by_staff") @db.Uuid
  createdByStaff   StaffUser? @relation("OrderCreatedByStaff", fields: [createdByStaffId], references: [id], onDelete: SetNull)

  customerName  String? @map("customer_name")
  customerPhone String? @map("customer_phone")

  liabilityRecorded Boolean   @default(false) @map("liability_recorded")
  liabilityWaived   Boolean   @default(false) @map("liability_waived")
  escalationLevel   Int       @default(0) @map("escalation_level")
  firstReminderAt   DateTime? @map("first_reminder_at") @db.Timestamptz
  escalatedAt       DateTime? @map("escalated_at") @db.Timestamptz

  items            OrderItem[]
  payments         Payment[]
  adjustments      OrderAdjustment[]
  liability        WaiterLiability?
  cashTransactions CashTransaction[]

  @@index([restaurantId])
  @@index([tableId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id             String          @id @default(uuid()) @db.Uuid
  orderId        String          @map("order_id") @db.Uuid
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId     String          @map("menu_item_id") @db.Uuid
  menuItem       MenuItem        @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  quantity       Int             @default(1)
  unitPrice      Decimal         @map("unit_price") @db.Decimal(10, 2)
  subtotal       Decimal         @db.Decimal(10, 2)
  specialRequest String?         @map("special_request")
  status         OrderItemStatus @default(PENDING)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz

  @@index([orderId, status])
  @@map("order_items")
}

model OrderAdjustment {
  id             String         @id @default(uuid()) @db.Uuid
  orderId        String         @map("order_id") @db.Uuid
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  adjustmentType AdjustmentType @map("adjustment_type")
  amount         Decimal        @db.Decimal(10, 2)
  reason         String
  requestedById  String         @map("requested_by") @db.Uuid
  approvedById   String?        @map("approved_by") @db.Uuid
  approvedAt     DateTime?      @map("approved_at") @db.Timestamptz
  status         ApprovalStatus @default(PENDING)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz

  @@map("order_adjustments")
}

// ─────────────────────────────────────────────────────────────────────────
// Payments / cash
// ─────────────────────────────────────────────────────────────────────────

model Payment {
  id               String              @id @default(uuid()) @db.Uuid
  restaurantId     String              @map("restaurant_id") @db.Uuid
  restaurant       Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderId          String              @map("order_id") @db.Uuid
  order            Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentMethod    PaymentMethod       @map("payment_method")
  amount           Decimal             @db.Decimal(10, 2)
  receivedAmount   Decimal             @map("received_amount") @db.Decimal(10, 2)
  changeAmount     Decimal             @default(0) @map("change_amount") @db.Decimal(10, 2)
  receivedById     String              @map("received_by") @db.Uuid
  receivedBy       StaffUser           @relation("PaymentReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  paymentReference String?             @map("payment_reference")
  status           PaymentRecordStatus @default(COMPLETED)
  paymentDate      DateTime            @default(now()) @map("payment_date") @db.Timestamptz
  verifiedById     String?             @map("verified_by") @db.Uuid
  verifiedBy       StaffUser?          @relation("PaymentVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt       DateTime?           @map("verified_at") @db.Timestamptz
  notes            String?

  @@index([restaurantId])
  @@index([orderId])
  @@map("payments")
}

model CashSession {
  id              String            @id @default(uuid()) @db.Uuid
  restaurantId    String            @map("restaurant_id") @db.Uuid
  restaurant      Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  staffId         String            @map("staff_id") @db.Uuid
  staff           StaffUser         @relation(fields: [staffId], references: [id], onDelete: Restrict)
  openingBalance  Decimal           @map("opening_balance") @db.Decimal(10, 2)
  cashInHand      Decimal           @default(0) @map("cash_in_hand") @db.Decimal(10, 2)
  closingBalance  Decimal?          @map("closing_balance") @db.Decimal(10, 2)
  expectedBalance Decimal?          @map("expected_balance") @db.Decimal(10, 2)
  variance        Decimal           @default(0) @db.Decimal(10, 2)
  openedAt        DateTime          @default(now()) @map("opened_at") @db.Timestamptz
  closedAt        DateTime?         @map("closed_at") @db.Timestamptz
  closedById      String?           @map("closed_by") @db.Uuid
  closedBy        StaffUser?        @relation("CashSessionClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  status          CashSessionStatus @default(OPEN)
  notes           String?

  transactions CashTransaction[]

  @@index([restaurantId, staffId])
  @@map("cash_sessions")
}

model CashTransaction {
  id              String              @id @default(uuid()) @db.Uuid
  cashSessionId   String              @map("cash_session_id") @db.Uuid
  cashSession     CashSession         @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
  restaurantId    String              @map("restaurant_id") @db.Uuid
  restaurant      Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  staffId         String              @map("staff_id") @db.Uuid
  staff           StaffUser           @relation(fields: [staffId], references: [id], onDelete: Restrict)
  transactionType CashTransactionType @map("transaction_type")
  amount          Decimal             @db.Decimal(10, 2)
  orderId         String?             @map("order_id") @db.Uuid
  order           Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  description     String?
  referenceNumber String?             @map("reference_number")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz

  @@map("cash_transactions")
}

// ─────────────────────────────────────────────────────────────────────────
// Waiter calls / liability
// ─────────────────────────────────────────────────────────────────────────

model WaiterCall {
  id           String                @id @default(uuid()) @db.Uuid
  restaurantId String                @map("restaurant_id") @db.Uuid
  restaurant   Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableId      String                @map("table_id") @db.Uuid
  table        RestaurantTable       @relation(fields: [tableId], references: [id], onDelete: Cascade)
  requestType  WaiterCallRequestType @map("request_type")
  message      String?
  priority     WaiterCallPriority    @default(NORMAL)
  status       WaiterCallStatus      @default(PENDING)
  assignedToId String?               @map("assigned_to") @db.Uuid
  assignedTo   StaffUser?            @relation("WaiterCallAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedAt   DateTime?             @map("assigned_at") @db.Timestamptz
  completedAt  DateTime?             @map("completed_at") @db.Timestamptz
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz

  @@index([restaurantId, status])
  @@map("waiter_calls")
}

model WaiterLiability {
  id                 String          @id @default(uuid()) @db.Uuid
  restaurantId       String          @map("restaurant_id") @db.Uuid
  restaurant         Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderId            String          @unique @map("order_id") @db.Uuid
  order              Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  waiterId           String          @map("waiter_id") @db.Uuid
  waiter             StaffUser       @relation("LiabilityWaiter", fields: [waiterId], references: [id], onDelete: Cascade)
  orderAmount        Decimal         @map("order_amount") @db.Decimal(10, 2)
  liabilityCreatedAt DateTime        @default(now()) @map("liability_created_at") @db.Timestamptz
  liabilityClearedAt DateTime?       @map("liability_cleared_at") @db.Timestamptz
  status             LiabilityStatus @default(ACTIVE)
  clearedById        String?         @map("cleared_by") @db.Uuid
  clearedBy          StaffUser?      @relation("LiabilityClearedBy", fields: [clearedById], references: [id], onDelete: SetNull)
  paymentMethod      String?         @map("payment_method")
  notes              String?
  deductionStatus    DeductionStatus @default(NONE) @map("deduction_status")
  deductedAmount     Decimal         @default(0) @map("deducted_amount") @db.Decimal(10, 2)
  deductedAt         DateTime?       @map("deducted_at") @db.Timestamptz

  @@index([restaurantId])
  @@index([waiterId, status])
  @@index([liabilityCreatedAt])
  @@map("waiter_liabilities")
}

// ─────────────────────────────────────────────────────────────────────────
// Settings
// ─────────────────────────────────────────────────────────────────────────

model RestaurantSetting {
  id           String     @id @default(uuid()) @db.Uuid
  restaurantId String     @map("restaurant_id") @db.Uuid
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  settingKey   String     @map("setting_key")
  settingValue String?    @map("setting_value")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([restaurantId, settingKey])
  @@map("restaurant_settings")
}

model SystemSetting {
  id           String   @id @default(uuid()) @db.Uuid
  settingKey   String   @unique @map("setting_key")
  settingValue String?  @map("setting_value")
  description  String?
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("system_settings")
}

model SubscriptionPlan {
  id                String               @id @default(uuid()) @db.Uuid
  planName          SubscriptionPlanName @unique @map("plan_name")
  displayName       String               @map("display_name")
  description       String?
  priceMonthly      Decimal              @default(0) @map("price_monthly") @db.Decimal(10, 2)
  priceYearly       Decimal              @default(0) @map("price_yearly") @db.Decimal(10, 2)
  durationDays      Int                  @default(30) @map("duration_days")
  maxTables         Int                  @default(10) @map("max_tables")
  maxUsers          Int                  @default(5) @map("max_users")
  maxMenuItems      Int                  @default(50) @map("max_menu_items")
  maxOrdersPerMonth Int                  @default(200) @map("max_orders_per_month")
  features          Json?
  badgeColor        String               @default("#6c757d") @map("badge_color")
  isActive          Boolean              @default(true) @map("is_active")
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  @@map("subscription_plans")
}

// ─────────────────────────────────────────────────────────────────────────
// Notifications / announcements / audit
// ─────────────────────────────────────────────────────────────────────────

model Notification {
  id           String     @id @default(uuid()) @db.Uuid
  restaurantId String     @map("restaurant_id") @db.Uuid
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  userId       String     @map("user_id") @db.Uuid
  user         StaffUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String
  title        String
  message      String
  data         Json?
  orderId      String?    @map("order_id") @db.Uuid
  isRead       Boolean    @default(false) @map("is_read")
  readAt       DateTime?  @map("read_at") @db.Timestamptz
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId, isRead])
  @@index([restaurantId])
  @@index([type])
  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model Announcement {
  id             String               @id @default(uuid()) @db.Uuid
  title          String
  message        String
  type           AnnouncementType     @default(INFO)
  targetAudience AnnouncementAudience @default(ALL) @map("target_audience")
  priority       AnnouncementPriority @default(NORMAL)
  restaurantId   String?              @map("restaurant_id") @db.Uuid
  restaurant     Restaurant?          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  isActive       Boolean              @default(true) @map("is_active")
  isDismissible  Boolean              @default(true) @map("is_dismissible")
  startDate      DateTime?            @map("start_date") @db.Timestamptz
  endDate        DateTime?            @map("end_date") @db.Timestamptz
  createdById    String?              @map("created_by") @db.Uuid
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  dismissals AnnouncementDismissal[]

  @@map("announcements")
}

model AnnouncementDismissal {
  id             String       @id @default(uuid()) @db.Uuid
  announcementId String       @map("announcement_id") @db.Uuid
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id") @db.Uuid
  user           StaffUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  dismissedAt    DateTime     @default(now()) @map("dismissed_at") @db.Timestamptz

  @@unique([announcementId, userId])
  @@map("announcement_dismissals")
}

model SystemNotification {
  id        String                    @id @default(uuid()) @db.Uuid
  title     String
  message   String
  type      SystemNotificationType    @default(INFO)
  context   SystemNotificationContext @default(SYSTEM)
  linkUrl   String?                   @map("link_url")
  icon      String                    @default("bell")
  isRead    Boolean                   @default(false) @map("is_read")
  createdAt DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  readAt    DateTime?                 @map("read_at") @db.Timestamptz

  @@map("system_notifications")
}

model AuditTrail {
  id               String         @id @default(uuid()) @db.Uuid
  restaurantId     String?        @map("restaurant_id") @db.Uuid
  restaurant       Restaurant?    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  staffId          String         @map("staff_id") @db.Uuid
  staff            StaffUser      @relation(fields: [staffId], references: [id], onDelete: Cascade)
  actionType       String         @map("action_type")
  tableName        String?        @map("table_name")
  recordId         String?        @map("record_id")
  oldValue         String?        @map("old_value")
  newValue         String?        @map("new_value")
  reason           String?
  ipAddress        String?        @map("ip_address")
  userAgent        String?        @map("user_agent")
  requiresApproval Boolean        @default(false) @map("requires_approval")
  approvedById     String?        @map("approved_by") @db.Uuid
  approvedAt       DateTime?      @map("approved_at") @db.Timestamptz
  status           ApprovalStatus @default(APPROVED)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz

  @@index([restaurantId])
  @@map("audit_trail")
}

// ─────────────────────────────────────────────────────────────────────────
// Support
// ─────────────────────────────────────────────────────────────────────────

model SupportMessage {
  id           String                @id @default(uuid()) @db.Uuid
  restaurantId String?               @map("restaurant_id") @db.Uuid
  restaurant   Restaurant?           @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  subject      String
  message      String
  channel      SupportMessageChannel @default(WEB)
  status       SupportMessageStatus  @default(NEW)
  contactName  String?               @map("contact_name")
  contactEmail String?               @map("contact_email")
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz

  @@map("support_messages")
}

model SupportTicket {
  id             String                @id @default(uuid()) @db.Uuid
  restaurantId   String?               @map("restaurant_id") @db.Uuid
  restaurant     Restaurant?           @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  staffId        String?               @map("staff_id") @db.Uuid
  staff          StaffUser?            @relation(fields: [staffId], references: [id], onDelete: SetNull)
  subject        String
  description    String?
  status         SupportTicketStatus   @default(OPEN)
  priority       SupportTicketPriority @default(MEDIUM)
  channel        SupportTicketChannel  @default(IN_APP)
  contactName    String?               @map("contact_name")
  contactEmail   String?               @map("contact_email")
  contactPhone   String?               @map("contact_phone")
  assignedTo     String?               @map("assigned_to")
  tags           String?
  lastResponseAt DateTime?             @map("last_response_at") @db.Timestamptz
  nextFollowUp   DateTime?             @map("next_follow_up") @db.Timestamptz
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  replies SupportTicketReply[]

  @@map("support_tickets")
}

model SupportTicketReply {
  id            String          @id @default(uuid()) @db.Uuid
  ticketId      String          @map("ticket_id") @db.Uuid
  ticket        SupportTicket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  isSuperadmin  Boolean         @default(false) @map("is_superadmin")
  staffId       String?         @map("staff_id") @db.Uuid
  staff         StaffUser?      @relation(fields: [staffId], references: [id], onDelete: SetNull)
  senderType    ReplySenderType @default(SUPPORT) @map("sender_type")
  message       String
  attachmentUrl String?         @map("attachment_url")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz

  @@map("support_ticket_replies")
}
