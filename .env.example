# ============================================================
# Smart Restaurant — Environment
# Copy to .env and fill real values. Never commit .env.
# Backend will not boot if JWT secrets or DATABASE_URL are missing.
# Docker Compose also requires CORS_ORIGIN, FRONTEND_URL, SUPERADMIN_PASSWORD.
# ============================================================

# ---------- Database ----------
DATABASE_URL=postgresql://smartresto:changeme@localhost:5432/smartresto?schema=public
POSTGRES_USER=smartresto
POSTGRES_PASSWORD=changeme
POSTGRES_DB=smartresto

# ---------- Backend ----------
NODE_ENV=development
PORT=4000
# Public site origin(s), comma-separated. Never *.
# npm run dev → http://localhost:3000
# docker compose (port 80) → http://localhost
# production → https://your.domain
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Generate with: openssl rand -base64 48  (min 32 characters)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---------- Frontend ----------
# Same-origin /api/v1 (Nginx or Nuxt proxy). Full https URL only if the API is on another host.
NUXT_PUBLIC_API_BASE_URL=/api/v1
API_PROXY_TARGET=http://127.0.0.1:4000

# ---------- Email (MAIL_DISABLE_DELIVERY=false to send) ----------
MAIL_DISABLE_DELIVERY=true
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Smart Restaurant
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_SMTP_ENCRYPTION=tls
MAIL_NOTIFY_ADDRESS=

# ---------- SMS / WhatsApp (off until *_DISABLE_DELIVERY=false) ----------
SMS_DISABLE_DELIVERY=true
SMS_AT_USERNAME=
SMS_AT_API_KEY=
SMS_SENDER_ID=
WHATSAPP_DISABLE_DELIVERY=true
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ---------- MySQL cutover (optional) ----------
# MYSQL_CUTOVER_URL=mysql://user:pass@host:3306/legacy_db

# ---------- Seeding ----------
SEED_DEMO_DATA=false
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=ChangeMe123!
SUPERADMIN_EMAIL=
