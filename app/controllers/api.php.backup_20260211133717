        // Get liability ID from UUID
        $liabilityId = $this->uuidHelper->getLiabilityIdByUuid($data['liability_uuid']);
        if (!$liabilityId) {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Liability not found'], 404);
            return;
        }
        
        $reason = $this->sanitize($data['reason']);
        $staffId = $_SESSION['staff_id'];
        
        try {
            require_once __DIR__ . '/../models/WaiterLiability.php';
            $liabilityModel = new WaiterLiability($this->orderModel->db);
            
            $result = $liabilityModel->markAsLoss($liabilityId, $reason, $staffId);
            $this->sendResponse($result);
            
        } catch (Exception $e) {
            error_log("Mark Liability Loss Error: " . $e->getMessage());
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Failed to mark liability as loss'], 500);
        }
    }
    
