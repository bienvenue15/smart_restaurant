        <?php 
        // Check subscription status
        require_once 'app/core/SubscriptionManager.php';
        $subscriptionManager = SubscriptionManager::getInstance();
        $subscriptionDetails = $subscriptionManager->getPlanDetails($user['restaurant_id']);
        $daysRemaining = $subscriptionDetails['days_remaining'] ?? 0;
        $isExpired = $subscriptionDetails['is_expired'] ?? false;
        $showSubscriptionWarning = ($daysRemaining <= 14 && $daysRemaining > 0) || $isExpired;
        ?>
        
        <?php if ($showSubscriptionWarning && in_array($role, ['admin', 'manager'])): ?>
        <div class="subscription-warning-banner <?php echo $isExpired ? 'expired' : 'expiring'; ?>">
            <div class="warning-content">
                <i class="fas fa-<?php echo $isExpired ? 'times-circle' : 'exclamation-triangle'; ?>"></i>
                <div class="warning-info">
                    <?php if ($isExpired): ?>
                        <strong>Subscription Expired</strong>
                        <span>Your subscription expired. Please renew to continue using the service.</span>
                    <?php else: ?>
                        <strong><?php echo $daysRemaining; ?> Days Remaining</strong>
                        <span>Your <?php echo strtoupper($subscriptionDetails['plan']); ?> plan expires on <?php echo date('F d, Y', strtotime($subscriptionDetails['subscription_end'])); ?></span>
                    <?php endif; ?>
                </div>
                <button onclick="window.open('mailto:<?php echo SystemSettings::getSupportEmail(); ?>?subject=Subscription Renewal', '_blank')" class="btn-renew">
                    <i class="fas fa-envelope"></i> Contact Support
                </button>
            </div>
        </div>
        <?php endif; ?>
        
