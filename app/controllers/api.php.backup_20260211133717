    /**
     * Update order status (staff only)
     */
    private function staffUpdateOrder() {
        $role = $_SESSION['staff_role'] ?? '';
        
        // Different permissions based on role
        if ($role === 'kitchen' || $role === 'waiter') {
            Permission::require('modify_order');
        } else {
            // Managers and admins
            Permission::require('manage_orders');
        }
        
        if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Method not allowed'], 405);
            return;
        }
        
        $input = file_get_contents('php://input');
        $data = json_decode($input, true);
        
        if (!$data || !isset($data['order_uuid']) || !isset($data['status'])) {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Missing required fields (order_uuid and status required)'], 400);
            return;
        }
        
        // Validate UUID format
        if (!UuidHelper::isValidUuid($data['order_uuid'])) {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Invalid UUID format. For security, only UUIDs are accepted, not integer IDs.'], 400);
            return;
        }
        
        // Get order ID from UUID
        $orderId = $this->uuidHelper->getOrderIdByUuid($data['order_uuid']);
        if (!$orderId) {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Order not found'], 404);
            return;
        }
        
        $orderUuid = $data['order_uuid'];
        $newStatus = $this->sanitize($data['status']);
        $staffId = $_SESSION['staff_uuid'];
        
        // Get current order status
        $query = "SELECT status FROM orders WHERE uuid = ?";
        $stmt = $this->orderModel->db->prepare($query);
        $stmt->execute([$orderUuid]);
        $oldStatus = $stmt->fetchColumn();
        
        // Validate waiter permissions for specific status changes
        if ($role === 'waiter') {
            $allowedTransitions = [
                'pending' => ['confirmed'],
                'ready' => ['completed'],
                'served' => ['completed']
            ];
            
            if (!isset($allowedTransitions[$oldStatus]) || !in_array($newStatus, $allowedTransitions[$oldStatus])) {
                $this->sendResponse([
                    'status' => 'FAIL', 
                    'message' => 'Waiters can only confirm pending orders or complete ready/served orders'
                ], 403);
                return;
            }
        }
        
        // Update order
        $result = $this->staffModel->updateOrderStatus($orderId, $newStatus, $staffId);
        
        if ($result['status'] === 'OK') {
            // Log audit trail
            Permission::logAudit('update_order_status', 'orders', $orderId, $oldStatus, $newStatus);
            
            // Notify kitchen when order is confirmed by waiter
            if ($newStatus === 'confirmed' && $oldStatus === 'pending') {
                try {
                    // Get order details for notification
                    $orderQuery = "SELECT order_number, table_uuid FROM orders WHERE uuid = ?";
                    $orderStmt = $this->orderModel->db->prepare($orderQuery);
                    $orderStmt->execute([$orderUuid]);
                    $order = $orderStmt->fetch(PDO::FETCH_ASSOC);
                    
                    if ($order) {
                        $this->notifyKitchenNewOrder(
                            $this->restaurantId,
                            $orderUuid,
                            $order['order_number'],
                            $order['table_uuid']
                        );
                    }
                } catch (Exception $e) {
                    error_log('[Order Status] Failed to notify kitchen: ' . $e->getMessage());
                    // Don't fail the status update if notification fails
                }
            }
        }
        
        $this->sendResponse([
            'status' => 'OK',
            'message' => 'Order status updated',
            'order_uuid' => $orderUuid,
            'order_id' => $orderId
        ]);
    }
    
    /**
     * Update order item quantity (staff only)
     */
    private function staffUpdateOrderItem() {
        Permission::require('modify_order');
        
        if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Method not allowed'], 405);
            return;
        }
        
        $input = file_get_contents('php://input');
        $data = json_decode($input, true);
        
        if (!$data || !isset($data['order_item_id']) || !isset($data['quantity'])) {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Missing required fields'], 400);
            return;
        }
        
        $orderItemId = intval($data['order_item_id']);
        $newQuantity = intval($data['quantity']);
        
        if ($newQuantity < 1) {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Quantity must be at least 1'], 400);
            return;
        }
        
        try {
            $this->orderModel->db->beginTransaction();
            
            // Get order item details and check order status
            $query = "SELECT oi.*, o.status, o.total_amount, o.created_by_staff FROM order_items oi 
                      INNER JOIN orders o ON oi.order_id = o.id 
                      WHERE oi.id = ?";
            $stmt = $this->orderModel->db->prepare($query);
            $stmt->execute([$orderItemId]);
            $item = $stmt->fetch(PDO::FETCH_ASSOC);
            
            if (!$item) {
                $this->orderModel->db->rollBack();
                $this->sendResponse(['status' => 'FAIL', 'message' => 'Order item not found'], 404);
                return;
            }
            
            // Prevent waiters from editing system-created orders (placed by customers)
            $role = $_SESSION['staff_role'] ?? '';
            if ($role === 'waiter' && empty($item['created_by_staff'])) {
                $this->orderModel->db->rollBack();
                $this->sendResponse(['status' => 'FAIL', 'message' => 'Waiters cannot modify customer-placed orders'], 403);
                return;
            }
            
            // Only allow modification of pending/confirmed orders
            if (!in_array($item['status'], ['pending', 'confirmed'])) {
                $this->orderModel->db->rollBack();
                $this->sendResponse(['status' => 'FAIL', 'message' => 'Can only modify pending or confirmed orders'], 400);
                return;
            }
            
            // Calculate new subtotal
            $newSubtotal = $item['unit_price'] * $newQuantity;
            $oldSubtotal = $item['subtotal'];
            
            // Update item quantity and subtotal
            $updateQuery = "UPDATE order_items SET quantity = ?, subtotal = ? WHERE uuid = ?";
            $updateStmt = $this->orderModel->db->prepare($updateQuery);
            $updateStmt->execute([$newQuantity, $newSubtotal, $orderItemId]);
            
            // Update order total
            $newOrderTotal = $item['total_amount'] - $oldSubtotal + $newSubtotal;
            $totalQuery = "UPDATE orders SET total_amount = ?, updated_at = NOW() WHERE uuid = ?";
            $totalStmt = $this->orderModel->db->prepare($totalQuery);
            $totalStmt->execute([$newOrderTotal, $item['order_uuid']]);
            
            $this->orderModel->db->commit();
            
            $this->sendResponse([
                'status' => 'OK',
                'message' => 'Item quantity updated successfully',
                'new_total' => $newOrderTotal
            ]);
            
        } catch (PDOException $e) {
            $this->orderModel->db->rollBack();
            error_log('[API] Update order item error: ' . $e->getMessage());
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Database error'], 500);
        }
    }
    
