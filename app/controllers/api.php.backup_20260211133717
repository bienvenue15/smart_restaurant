    /**
     * Get waiter's own liabilities
     */
    private function staffGetMyLiabilities() {
        // Staff authentication is already handled in constructor
        if (!isset($_SESSION['staff_id']) || !isset($_SESSION['staff_user'])) {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Unauthorized'], 401);
            return;
        }
        
        $staffId = $_SESSION['staff_id'];
        $restaurantId = $_SESSION['staff_user']['restaurant_id'] ?? null;
        $status = isset($_GET['status']) ? $this->sanitize($_GET['status']) : null;
        
        if (!$restaurantId) {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Restaurant context not found'], 400);
            return;
        }
        
        try {
            require_once __DIR__ . '/../models/WaiterLiability.php';
            $liabilityModel = new WaiterLiability($this->orderModel->db);
            
            if ($status === 'active') {
                $liabilities = $liabilityModel->getActiveLiabilities($staffId, $restaurantId);
                $totalLiability = $liabilityModel->getTotalLiability($staffId, $restaurantId);
                
                $this->sendResponse([
                    'status' => 'OK',
                    'data' => [
                        'active_liabilities' => $liabilities,
                        'total_active_amount' => $totalLiability,
                        'count' => count($liabilities)
                    ]
                ]);
            } else if ($status === 'loss') {
                $losses = $liabilityModel->getWaiterLosses($staffId, $restaurantId);
                
                $this->sendResponse([
                    'status' => 'OK',
                    'data' => [
                        'losses' => $losses,
                        'total_loss_amount' => array_sum(array_column($losses, 'order_amount')),
                        'count' => count($losses)
                    ]
                ]);
            } else {
                // Get all liabilities for this waiter
                $query = "SELECT wl.*, o.order_number, t.table_number,
                                TIMESTAMPDIFF(HOUR, wl.liability_created_at, NOW()) as hours_outstanding
                          FROM waiter_liabilities wl
                          INNER JOIN orders o ON wl.order_id = o.id
                          INNER JOIN restaurant_tables t ON o.table_id = t.id
                          WHERE wl.waiter_id = ? AND wl.restaurant_id = ?
                          ORDER BY wl.liability_created_at DESC
                          LIMIT 50";
                
                $stmt = $this->orderModel->db->prepare($query);
                $stmt->execute([$staffId, $restaurantId]);
                $allLiabilities = $stmt->fetchAll(PDO::FETCH_ASSOC);
                
                $this->sendResponse([
                    'status' => 'OK',
                    'data' => $allLiabilities
                ]);
            }
            
        } catch (PDOException $e) {
            error_log("Get My Liabilities Error: " . $e->getMessage());
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Failed to retrieve liabilities'], 500);
        }
    }
    
