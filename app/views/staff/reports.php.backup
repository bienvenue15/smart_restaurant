    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        // Cache buster - v2.1
        const SCRIPT_VERSION = '2.1';
        console.log('[REPORTS] Script version:', SCRIPT_VERSION);
        
        const BASE_URL = '<?php echo rtrim(BASE_URL, '/'); ?>';
        const BASE_PATH = BASE_URL;
        const RESTAURANT_ID = <?php echo isset($restaurant_id) && $restaurant_id ? $restaurant_id : ($_SESSION['staff_user']['restaurant_id'] ?? 'null'); ?>;
        let currentTab = 'daily';
        let charts = {};
        
        // Audio notification system
        <?php include __DIR__ . '/../includes/audio_notification.js'; ?>
        
        // Switch between tabs
        function switchTab(tab) {
            currentTab = tab;
            
            // Update tab buttons
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            event.target.classList.add('active');
            
            // Update panels
            document.querySelectorAll('.report-panel').forEach(panel => panel.classList.remove('active'));
            document.getElementById(tab + '-panel').classList.add('active');
            
            // Load data if not loaded
            const statsDiv = document.getElementById(tab + 'Stats');
            if (statsDiv && statsDiv.innerHTML.includes('Loading')) {
                switch(tab) {
                    case 'daily': loadDailyReport(); break;
                    case 'weekly': loadWeeklyReport(); break;
                    case 'monthly': loadMonthlyReport(); break;
                    case 'yearly': loadYearlyReport(); break;
                    case 'custom': loadCustomReport(); break;
                }
            }
        }
        
        // Load reports on page load
        document.addEventListener('DOMContentLoaded', function() {
            loadDailyReport();
        });
        
        // Load Daily Report
        function loadDailyReport() {
            const date = document.getElementById('dailyDate').value;
            const statsDiv = document.getElementById('dailyStats');
            statsDiv.innerHTML = '<div class="loading"><i class="fas fa-spinner"></i><p>Loading report...</p></div>';
            
            fetch(`${BASE_URL}/?req=api&action=get_daily_report&date=${date}&restaurant_id=${RESTAURANT_ID}`)
                .then(response => response.json())
                .then(data => {
                    if (data.status === 'OK') {
                        displayDailyStats(data);
                    } else {
                        showError('dailyStats', data.message || 'Failed to load report');
                    }
                })
                .catch(error => {
                    showError('dailyStats', 'Failed to load report');
                });
        }
        
        function displayDailyStats(data) {
            console.log('Daily Stats Data:', data);
            console.log('Top Items:', data.top_items);
            
            const stats = data.stats || {};
            const statsHtml = `
                <div class="stat-card">
                    <h3>Total Revenue</h3>
                    <div class="stat-value">RWF ${parseInt(stats.total_revenue || 0).toLocaleString()}</div>
                    <div class="stat-change">
                        <i class="fas fa-calendar-day"></i> ${data.date}
                    </div>
                </div>
                <div class="stat-card">
                    <h3>Total Orders</h3>
                    <div class="stat-value">${stats.total_orders || 0}</div>
                    <div class="stat-change">
                        <i class="fas fa-check-circle"></i> ${stats.paid_orders || 0} paid
                    </div>
                </div>
                <div class="stat-card">
                    <h3>Average Order</h3>
                    <div class="stat-value">RWF ${parseInt(stats.average_order || 0).toLocaleString()}</div>
                    <div class="stat-change">
                        ${stats.total_orders > 0 ? 'Per order' : 'No orders yet'}
                    </div>
                </div>
                <div class="stat-card">
                    <h3>Tables Served</h3>
                    <div class="stat-value">${stats.tables_served || 0}</div>
                    <div class="stat-change">
                        <i class="fas fa-chair"></i> Unique tables
                    </div>
                </div>
            `;
            
            document.getElementById('dailyStats').innerHTML = statsHtml;
            
            // Show top selling items
            console.log('Checking top items:', data.top_items, 'Length:', data.top_items ? data.top_items.length : 0);
            if (data.top_items && data.top_items.length > 0) {
                console.log('Displaying top items...');
                displayTopItems(data.top_items);
                document.getElementById('dailyTable').style.display = 'block';
            } else {
                console.log('No top items to display');
                document.getElementById('dailyTable').style.display = 'none';
            }
            
            // Show charts
            if (data.hourly && data.hourly.length > 0) {
                displayDailyChart(data.hourly);
                document.getElementById('dailyCharts').style.display = 'block';
            }
        }
        
        function displayTopItems(items) {
            console.log('[TOP ITEMS] Function called with items:', items);
            
            const tbody = document.querySelector('#dailyOrdersTable tbody');
            
            if (!tbody) {
                console.error('[TOP ITEMS] Table body not found!');
                return;
            }
            
            // Clear existing content
            tbody.innerHTML = '';
            
            // Add each item as a row
            items.forEach((item, index) => {
                const row = tbody.insertRow();
                row.innerHTML = `
                    <td><strong>#${index + 1}</strong></td>
                    <td>${item.name || 'Unknown'}</td>
                    <td><span class="badge">${item.quantity_sold || 0}</span></td>
                    <td><strong>RWF ${parseInt(item.revenue || 0).toLocaleString()}</strong></td>
                `;
            });
            
            console.log('[TOP ITEMS] Table updated. Rows added:', items.length);
        }
        
        function displayDailyChart(hourlySales) {
            const ctx = document.getElementById('dailyChart').getContext('2d');
            
            if (charts.daily) {
                charts.daily.destroy();
            }
            
            charts.daily = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: hourlySales.map(h => h.hour + ':00'),
                    datasets: [{
                        label: 'Hourly Sales',
                        data: hourlySales.map(h => h.revenue),
                        backgroundColor: 'rgba(54, 162, 235, 0.5)',
                        borderColor: 'rgba(54, 162, 235, 1)',
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    return 'RWF ' + parseInt(value).toLocaleString();
                                }
                            }
                        }
                    }
                }
            });
        }
        
        // Load Weekly Report
        function loadWeeklyReport() {
            const weekInput = document.getElementById('weeklyDate').value;
            // Convert week input (YYYY-Wnn) to week start date (YYYY-MM-DD)
            const weekParts = weekInput.split('-W');
            const year = weekParts[0];
            const week = weekParts[1];
            // Calculate Monday of that week
            const jan1 = new Date(year, 0, 1);
            const daysToMonday = (week - 1) * 7 - jan1.getDay() + 1;
            const weekStart = new Date(year, 0, 1 + daysToMonday);
            const weekStartStr = weekStart.toISOString().split('T')[0];
            
            const statsDiv = document.getElementById('weeklyStats');
            statsDiv.innerHTML = '<div class="loading"><i class="fas fa-spinner"></i><p>Loading report...</p></div>';
            
            fetch(`${BASE_URL}/?req=api&action=get_weekly_report&week_start=${weekStartStr}&restaurant_id=${RESTAURANT_ID}`)
                .then(response => response.json())
                .then(data => {
                    if (data.status === 'OK') {
                        displayWeeklyStats(data);
                    } else {
                        showError('weeklyStats', data.message || 'Failed to load report');
                    }
                })
                .catch(error => {
                    showError('weeklyStats', 'Failed to load report');
                });
        }
        
        function displayWeeklyStats(data) {
            const stats = data.stats || {};
            const daily = data.daily || [];
            let bestDay = { revenue: 0, date: 'N/A' };
            if (daily.length > 0) {
                bestDay = daily.reduce((max, d) => parseFloat(d.revenue) > parseFloat(max.revenue) ? d : max);
            }
            const avgDaily = stats.total_orders > 0 ? (parseFloat(stats.total_revenue) / (stats.days_active || 1)) : 0;
            
            const statsHtml = `
                <div class="stat-card">
                    <h3>Weekly Revenue</h3>
                    <div class="stat-value">RWF ${parseInt(stats.total_revenue || 0).toLocaleString()}</div>
                    <div class="stat-change">
                        <i class="fas fa-calendar-week"></i> ${data.week_start} to ${data.week_end}
                    </div>
                </div>
                <div class="stat-card">
                    <h3>Total Orders</h3>
                    <div class="stat-value">${stats.total_orders || 0}</div>
                    <div class="stat-change">
                        ${parseFloat((stats.total_orders || 0) / (stats.days_active || 1)).toFixed(1)} avg/day
                    </div>
                </div>
                <div class="stat-card">
                    <h3>Best Day</h3>
                    <div class="stat-value">${bestDay.day_name || 'N/A'}</div>
                    <div class="stat-change">
                        RWF ${parseInt(bestDay.revenue || 0).toLocaleString()}
                    </div>
                </div>
                <div class="stat-card">
                    <h3>Average Daily</h3>
                    <div class="stat-value">RWF ${parseInt(avgDaily).toLocaleString()}</div>
                    <div class="stat-change">
                        Per day average
                    </div>
                </div>
            `;
            
            document.getElementById('weeklyStats').innerHTML = statsHtml;
            
            if (data.daily && data.daily.length > 0) {
                displayWeeklyChart(data.daily);
                document.getElementById('weeklyCharts').style.display = 'block';
            }
        }
        
        function displayWeeklyChart(dailySales) {
            const ctx = document.getElementById('weeklyChart').getContext('2d');
            
            if (charts.weekly) {
                charts.weekly.destroy();
            }
            
            charts.weekly = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: dailySales.map(d => d.day_name || new Date(d.date).toLocaleDateString('en-US', { weekday: 'short' })),
                    datasets: [{
                        label: 'Daily Revenue',
                        data: dailySales.map(d => d.revenue),
                        borderColor: 'rgb(75, 192, 192)',
                        backgroundColor: 'rgba(75, 192, 192, 0.2)',
                        borderWidth: 2,
                        tension: 0.1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    return 'RWF ' + parseInt(value).toLocaleString();
                                }
                            }
                        }
                    }
                }
            });
        }
        
        // Load Monthly Report
        function loadMonthlyReport() {
            const month = document.getElementById('monthlyDate').value;
            const statsDiv = document.getElementById('monthlyStats');
            statsDiv.innerHTML = '<div class="loading"><i class="fas fa-spinner"></i><p>Loading report...</p></div>';
            
            fetch(`${BASE_URL}/?req=api&action=get_monthly_report&month=${month}&restaurant_id=${RESTAURANT_ID}`)
                .then(response => response.json())
                .then(data => {
                    if (data.status === 'OK') {
                        displayMonthlyStats(data);
                    } else {
                        showError('monthlyStats', data.message || 'Failed to load report');
                    }
                })
                .catch(error => {
                    showError('monthlyStats', 'Failed to load report: ' + error.message);
                });
        }
        
        function displayMonthlyStats(data) {
            const stats = data.stats || {};
            const daily = data.daily || [];
            const avgDaily = stats.total_orders > 0 ? (parseFloat(stats.total_revenue) / (stats.days_active || 1)) : 0;
            
            const statsHtml = `
                <div class="stat-card">
                    <h3>Monthly Revenue</h3>
                    <div class="stat-value">RWF ${parseInt(stats.total_revenue || 0).toLocaleString()}</div>
                    <div class="stat-change">
                        <i class="fas fa-calendar-alt"></i> ${data.month}
                    </div>
                </div>
                <div class="stat-card">
                    <h3>Total Orders</h3>
                    <div class="stat-value">${stats.total_orders || 0}</div>
                    <div class="stat-change">
                        ${stats.days_active || 0} active days
                    </div>
                </div>
                <div class="stat-card">
                    <h3>Avg Daily Revenue</h3>
                    <div class="stat-value">RWF ${parseInt(avgDaily).toLocaleString()}</div>
                    <div class="stat-change">
                        Per day
                    </div>
                </div>
                <div class="stat-card">
                    <h3>Average Order</h3>
                    <div class="stat-value">RWF ${parseInt(stats.average_order || 0).toLocaleString()}</div>
                    <div class="stat-change">
                        Per order
                    </div>
                </div>
            `;
            
            document.getElementById('monthlyStats').innerHTML = statsHtml;
            
            if (data.daily && data.daily.length > 0) {
                displayMonthlyChart(data.daily);
                document.getElementById('monthlyCharts').style.display = 'block';
            }
        }
        
        function displayMonthlyChart(dailyData) {
            const ctx = document.getElementById('monthlyChart').getContext('2d');
            
            if (charts.monthly) {
                charts.monthly.destroy();
            }
            
            charts.monthly = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: dailyData.map(d => new Date(d.date).getDate()),
                    datasets: [{
                        label: 'Daily Revenue',
                        data: dailyData.map(d => d.revenue),
                        backgroundColor: 'rgba(153, 102, 255, 0.2)',
                        borderColor: 'rgba(153, 102, 255, 1)',
                        borderWidth: 2,
                        tension: 0.1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    return 'RWF ' + parseInt(value).toLocaleString();
                                }
                            }
                        },
                        x: {
                            title: {
                                display: true,
                                text: 'Day of Month'
                            }
                        }
                    }
                }
            });
        }
        
        // Load Yearly Report
        function loadYearlyReport() {
            const year = document.getElementById('yearlyDate').value;
            const statsDiv = document.getElementById('yearlyStats');
            statsDiv.innerHTML = '<div class="loading"><i class="fas fa-spinner"></i><p>Loading report...</p></div>';
            
            fetch(`${BASE_URL}/?req=api&action=get_yearly_report&year=${year}&restaurant_id=${RESTAURANT_ID}`)
                .then(response => response.json())
                .then(data => {
                    if (data.status === 'OK') {
                        displayYearlyStats(data);
                    } else {
                        showError('yearlyStats', data.message || 'Failed to load report');
                    }
                })
                .catch(error => {
                    showError('yearlyStats', 'Failed to load report: ' + error.message);
                });
        }
        
        function displayYearlyStats(data) {
            const stats = data.stats || {};
            const monthly = data.monthly || [];
            let bestMonth = { revenue: 0, month_name: 'N/A' };
            if (monthly.length > 0) {
                bestMonth = monthly.reduce((max, m) => parseFloat(m.revenue) > parseFloat(max.revenue) ? m : max);
            }
            const avgMonthly = monthly.length > 0 ? (parseFloat(stats.total_revenue) / monthly.length) : 0;
            
            const statsHtml = `
                <div class="stat-card">
                    <h3>Annual Revenue</h3>
                    <div class="stat-value">RWF ${parseInt(stats.total_revenue || 0).toLocaleString()}</div>
                    <div class="stat-change">
                        <i class="fas fa-calendar"></i> ${data.year}
                    </div>
                </div>
                <div class="stat-card">
                    <h3>Total Orders</h3>
                    <div class="stat-value">${stats.total_orders || 0}</div>
                    <div class="stat-change">
                        ${stats.days_active || 0} active days
                    </div>
                </div>
                <div class="stat-card">
                    <h3>Best Month</h3>
                    <div class="stat-value">${bestMonth.month_name || 'N/A'}</div>
                    <div class="stat-change">
                        RWF ${parseInt(bestMonth.revenue || 0).toLocaleString()}
                    </div>
                </div>
                <div class="stat-card">
                    <h3>Monthly Average</h3>
                    <div class="stat-value">RWF ${parseInt(avgMonthly).toLocaleString()}</div>
                    <div class="stat-change">
                        Per month
                    </div>
                </div>
            `;
            
            document.getElementById('yearlyStats').innerHTML = statsHtml;
            
            if (data.monthly && data.monthly.length > 0) {
                displayYearlyChart(data.monthly);
                document.getElementById('yearlyCharts').style.display = 'block';
            }
        }
        
        function displayYearlyChart(monthlyData) {
            const ctx = document.getElementById('yearlyChart').getContext('2d');
            
            if (charts.yearly) {
                charts.yearly.destroy();
            }
            
            charts.yearly = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: monthlyData.map(m => m.month_name || new Date(m.month + '-01').toLocaleDateString('en-US', { month: 'short' })),
                    datasets: [{
                        label: 'Monthly Revenue',
                        data: monthlyData.map(m => m.revenue),
                        borderColor: 'rgb(255, 99, 132)',
                        backgroundColor: 'rgba(255, 99, 132, 0.2)',
                        borderWidth: 2,
                        tension: 0.4,
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    return 'RWF ' + parseInt(value).toLocaleString();
                                }
                            }
                        }
                    }
                }
            });
        }
        
        // Load Custom Date Range Report
        function loadCustomReport() {
            const startDate = document.getElementById('customStartDate').value;
            const endDate = document.getElementById('customEndDate').value;
            
            if (!startDate || !endDate) {
                alert('Please select both start and end dates');
                return;
            }
            
            if (new Date(startDate) > new Date(endDate)) {
                alert('Start date must be before end date');
                return;
            }
            
            const statsDiv = document.getElementById('customStats');
            statsDiv.innerHTML = '<div class="loading"><i class="fas fa-spinner"></i><p>Loading report...</p></div>';
            
            fetch(`${BASE_URL}/?req=api&action=get_custom_report&start_date=${startDate}&end_date=${endDate}&restaurant_id=${RESTAURANT_ID}`)
                .then(response => response.json())
                .then(data => {
                    if (data.status === 'OK') {
                        displayCustomStats(data);
                    } else {
                        showError('customStats', data.message || 'Failed to load report');
                    }
                })
                .catch(error => {
                    showError('customStats', 'Failed to load report: ' + error.message);
                });
        }
        
        function displayCustomStats(data) {
            const stats = data.stats || {};
            const days = Math.ceil((new Date(data.end_date) - new Date(data.start_date)) / (1000 * 60 * 60 * 24)) + 1;
            const avgDaily = stats.total_orders > 0 ? (parseFloat(stats.total_revenue) / days) : 0;
            
            const statsHtml = `
                <div class="stat-card">
                    <h3>Total Revenue</h3>
                    <div class="stat-value">RWF ${parseInt(stats.total_revenue || 0).toLocaleString()}</div>
                    <div class="stat-change">
                        <i class="fas fa-calendar-alt"></i> ${data.start_date} to ${data.end_date}
                    </div>
                </div>
                <div class="stat-card">
                    <h3>Total Orders</h3>
                    <div class="stat-value">${stats.total_orders || 0}</div>
                    <div class="stat-change">
                        <i class="fas fa-check-circle"></i> ${stats.paid_orders || 0} paid
                    </div>
                </div>
                <div class="stat-card">
                    <h3>Avg Daily Revenue</h3>
                    <div class="stat-value">RWF ${parseInt(avgDaily).toLocaleString()}</div>
                    <div class="stat-change">
                        Over ${days} days
                    </div>
                </div>
                <div class="stat-card">
                    <h3>Average Order</h3>
                    <div class="stat-value">RWF ${parseInt(stats.average_order || 0).toLocaleString()}</div>
                    <div class="stat-change">
                        Per order
                    </div>
                </div>
            `;
            
            document.getElementById('customStats').innerHTML = statsHtml;
            
            // Show top selling items
            if (data.top_items && data.top_items.length > 0) {
                displayCustomTopItems(data.top_items);
                document.getElementById('customTable').style.display = 'block';
            }
            
            // Show daily trend chart
            if (data.daily && data.daily.length > 0) {
                displayCustomChart(data.daily);
                document.getElementById('customCharts').style.display = 'block';
            }
        }
        
        function displayCustomTopItems(items) {
            const table = document.getElementById('customItemsTable');
            const tbody = table.querySelector('tbody');
            
            tbody.innerHTML = items.map((item, index) => `
                <tr>
                    <td><strong>#${index + 1}</strong></td>
                    <td>${item.name}</td>
                    <td><span class="badge">${item.quantity_sold}</span></td>
                    <td><strong>RWF ${parseInt(item.revenue || 0).toLocaleString()}</strong></td>
                </tr>
            `).join('');
        }
        
        function displayCustomChart(dailyData) {
            const ctx = document.getElementById('customChart').getContext('2d');
            
            if (charts.custom) {
                charts.custom.destroy();
            }
            
            charts.custom = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: dailyData.map(d => new Date(d.date).toLocaleDateString()),
                    datasets: [{
                        label: 'Daily Revenue',
                        data: dailyData.map(d => d.revenue),
                        backgroundColor: 'rgba(255, 159, 64, 0.2)',
                        borderColor: 'rgba(255, 159, 64, 1)',
                        borderWidth: 2,
                        tension: 0.1,
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    return 'RWF ' + parseInt(value).toLocaleString();
                                }
                            }
                        }
                    }
                }
            });
        }
        
        // Export Report
        function exportReport(type, format) {
            let params = `type=${type}&format=${format}&restaurant_id=${RESTAURANT_ID}`;
            
            switch(type) {
                case 'daily':
                    const dailyDate = document.getElementById('dailyDate').value;
                    params += `&date=${dailyDate}`;
                    break;
                case 'weekly':
                    const weekInput = document.getElementById('weeklyDate').value;
                    const weekParts = weekInput.split('-W');
                    const year = weekParts[0];
                    const week = weekParts[1];
                    const jan1 = new Date(year, 0, 1);
                    const daysToMonday = (week - 1) * 7 - jan1.getDay() + 1;
                    const weekStart = new Date(year, 0, 1 + daysToMonday);
                    params += `&week_start=${weekStart.toISOString().split('T')[0]}`;
                    break;
                case 'monthly':
                    const month = document.getElementById('monthlyDate').value;
                    params += `&month=${month}`;
                    break;
                case 'yearly':
                    const year2 = document.getElementById('yearlyDate').value;
                    params += `&year=${year2}`;
                    break;
                case 'custom':
                    const startDate = document.getElementById('customStartDate').value;
                    const endDate = document.getElementById('customEndDate').value;
                    params += `&start_date=${startDate}&end_date=${endDate}`;
                    break;
            }
            
            window.open(`${BASE_URL}/?req=api&action=export_report&${params}`, '_blank');
        }
        
        // Show error
        function showError(containerId, message) {
            document.getElementById(containerId).innerHTML = `
                <div class="empty-state">
                    <i class="fas fa-exclamation-triangle"></i>
                    <p>${message}</p>
                </div>
            `;
        }
        
        // Update current time with seconds - accurate live clock
        function updateTime() {
            const now = new Date();
            const timeStr = now.toLocaleTimeString('en-US', { 
                hour: '2-digit', 
                minute: '2-digit', 
                second: '2-digit',
                hour12: true 
            });
            document.getElementById('currentTime').textContent = timeStr;
        }
        updateTime();
        setInterval(updateTime, 1000); // Update every second
        
        // Auto-refresh reports every 30 seconds
        setInterval(() => {
            location.reload();
        }, 30000);
        
        // Mobile menu toggle functions
        function toggleMobileMenu() {
            const sidebar = document.querySelector('.sidebar');
            const overlay = document.querySelector('.mobile-overlay');
            if (sidebar && overlay) {
                sidebar.classList.toggle('mobile-open');
                overlay.classList.toggle('active');
                document.body.style.overflow = sidebar.classList.contains('mobile-open') ? 'hidden' : '';
            }
        }
        
        function closeMobileMenu() {
            const sidebar = document.querySelector('.sidebar');
            const overlay = document.querySelector('.mobile-overlay');
            if (sidebar && overlay) {
                sidebar.classList.remove('mobile-open');
                overlay.classList.remove('active');
                document.body.style.overflow = '';
            }
        }
    </script>
    
    <footer style="text-align: center; padding: 20px; color: #666; margin-top: 40px;">
        © 2026 Inovasiyo Ltd. All rights reserved.
    </footer>
</body>
</html>
