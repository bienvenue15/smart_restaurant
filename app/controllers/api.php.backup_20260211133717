    private function getTodayTransactions() {
        // Clear any output buffer to ensure clean JSON response
        while (ob_get_level() > 0) {
            ob_end_clean();
        }
        ob_start();
        
        $restaurantId = $_GET['restaurant_id'] ?? $this->restaurantId ?? $this->getRestaurantId();
        
        try {
            $stmt = $this->orderModel->db->prepare("
                SELECT 
                    o.id,
                    COALESCE(o.order_number, CONCAT('#', o.id)) as order_number,
                    COALESCE(t.table_number, 'N/A') as table_number,
                    o.total_amount,
                    CASE 
                        WHEN o.payment_status = 'unpaid' THEN 'pending'
                        ELSE o.payment_status
                    END as payment_status,
                    o.payment_method,
                    o.status,
                    o.created_at,
                    o.customer_name,
                    o.customer_phone,
                    s.full_name as waiter_name,
                    s.role as waiter_role
                FROM orders o
                LEFT JOIN restaurant_tables t ON o.table_id = t.id
                LEFT JOIN staff_users s ON o.created_by_staff = s.id
                WHERE o.restaurant_id = ?
                AND DATE(o.created_at) = CURDATE()
                AND o.status != 'cancelled'
                ORDER BY 
                    CASE 
                        WHEN o.status = 'ready' THEN 1
                        WHEN o.status = 'served' THEN 2
                        WHEN o.status = 'preparing' THEN 3
                        WHEN o.status = 'confirmed' THEN 4
                        ELSE 5
                    END,
                    o.created_at DESC
            ");
            $stmt->execute([$restaurantId]);
            $transactions = $stmt->fetchAll(PDO::FETCH_ASSOC);
            
            ob_end_clean();
            $this->sendResponse([
                'status' => 'OK',
                'data' => $transactions
            ]);
            
        } catch (Exception $e) {
            ob_end_clean();
            $this->sendResponse(['status' => 'FAIL', 'message' => $e->getMessage()], 500);
        }
    }
    
    private function getSessionSummary() {
        // Clear any output buffer to ensure clean JSON response
        while (@ob_get_level() > 0) {
            @ob_end_clean();
        }
        @ob_start();
        
        // Suppress PHP warnings/notices for clean JSON
        error_reporting(E_ERROR | E_PARSE);
        
        $restaurantId = $_GET['restaurant_id'] ?? $this->restaurantId ?? $this->getRestaurantId();
        
        if (!$restaurantId) {
            // Return empty data instead of error
            ob_end_clean();
            $this->sendResponse([
                'status' => 'OK',
                'data' => [
                    'total_orders' => 0,
                    'paid_orders' => 0,
                    'pending_orders' => 0,
                    'total_revenue' => 0,
                    'cash_payments' => 0,
                    'card_payments' => 0,
                    'mobile_payments' => 0
                ],
                'message' => 'No restaurant context available'
            ]);
            return;
        }
        
        try {
            // Get today's orders summary
            $stmt = $this->orderModel->db->prepare("
                SELECT 
                    COUNT(*) as total_orders,
                    SUM(CASE WHEN payment_status = 'paid' THEN 1 ELSE 0 END) as paid_orders,
                    SUM(CASE WHEN payment_status = 'unpaid' OR payment_status = 'pending' THEN 1 ELSE 0 END) as pending_orders,
                    COALESCE(SUM(CASE WHEN payment_status = 'paid' THEN total_amount ELSE 0 END), 0) as total_revenue,
                    COALESCE(SUM(CASE WHEN payment_status = 'paid' AND payment_method = 'cash' THEN total_amount ELSE 0 END), 0) as cash_payments,
                    COALESCE(SUM(CASE WHEN payment_status = 'paid' AND payment_method = 'card' THEN total_amount ELSE 0 END), 0) as card_payments,
                    COALESCE(SUM(CASE WHEN payment_status = 'paid' AND payment_method = 'mobile_money' THEN total_amount ELSE 0 END), 0) as mobile_payments
                FROM orders
                WHERE restaurant_uuid = ?
                AND DATE(created_at) = CURDATE()
            ");
            $stmt->execute([$restaurantId]);
            $summary = $stmt->fetch(PDO::FETCH_ASSOC);
            
            // If no data, return zeros
            if (!$summary || $summary['total_orders'] === null) {
                $summary = [
                    'total_orders' => 0,
                    'paid_orders' => 0,
                    'pending_orders' => 0,
                    'total_revenue' => 0,
                    'cash_payments' => 0,
                    'card_payments' => 0,
                    'mobile_payments' => 0
                ];
            }
            
            ob_end_clean();
            $this->sendResponse([
                'status' => 'OK',
                'data' => $summary
            ]);
            
        } catch (Exception $e) {
            ob_end_clean();
            $this->sendResponse(['status' => 'FAIL', 'message' => $e->getMessage()], 500);
        }
    }
    
    private function createStaffTicket() {
        // Check authentication
        if (!isset($_SESSION['staff_user'])) {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Not authenticated'], 401);
            return;
        }
        
        $input = json_decode(file_get_contents('php://input'), true);
        
        if (!$input) {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Invalid JSON input'], 400);
            return;
        }
        
        $subject = $input['subject'] ?? '';
        $message = $input['message'] ?? '';
        $priority = $input['priority'] ?? 'medium';
        $restaurantId = $input['restaurant_id'] ?? $_SESSION['staff_user']['restaurant_id'] ?? null;
        $staffId = $input['staff_id'] ?? $_SESSION['staff_user']['id'] ?? null;
        
        if (empty($subject) || empty($message)) {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Subject and message are required'], 400);
            return;
        }
        
        if (!$staffId) {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Staff ID not found in session'], 401);
            return;
        }
        
        if (!$restaurantId) {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Restaurant ID not found'], 400);
            return;
        }
        
        try {
            $stmt = $this->orderModel->db->prepare("
                INSERT INTO support_tickets (restaurant_id, staff_id, subject, description, priority, status, created_at)
                VALUES (?, ?, ?, ?, ?, 'open', NOW())
            ");
            $stmt->execute([$restaurantId, $staffId, $subject, $message, $priority]);
            
            $this->sendResponse([
                'status' => 'OK',
                'message' => 'Ticket created successfully',
                'ticket_id' => $this->orderModel->db->lastInsertId()
            ]);
        } catch (Exception $e) {
            error_log('Create Ticket Error: ' . $e->getMessage());
            $this->sendResponse(['status' => 'FAIL', 'message' => $e->getMessage()], 500);
        }
    }
    
    private function getStaffTickets() {
        // Check authentication
        if (!isset($_SESSION['staff_user'])) {
            error_log('Get Tickets: No staff_user in session');
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Not authenticated'], 401);
            return;
        }
        
        $staffId = $_GET['staff_id'] ?? $_SESSION['staff_user']['id'] ?? null;
        
        if (!$staffId) {
            error_log('Get Tickets: No staff ID found');
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Staff ID not found in session'], 401);
            return;
        }
        
        error_log('Get Tickets: Loading tickets for staff ID: ' . $staffId);
        
        try {
            // First check if staff_id column exists
            $checkColumn = $this->orderModel->db->query("SHOW COLUMNS FROM support_tickets LIKE 'staff_id'");
            if ($checkColumn->rowCount() === 0) {
                error_log('Get Tickets: staff_id column does not exist in support_tickets table');
                // Return empty array if column doesn't exist yet
                $this->sendResponse([
                    'status' => 'OK',
                    'data' => [],
                    'message' => 'Database schema needs to be updated. Run setup_staff_tickets.sql'
                ]);
                return;
            }
            
            $stmt = $this->orderModel->db->prepare("
                SELECT 
                    t.*,
                    t.description as message,
                    (SELECT COUNT(*) FROM support_ticket_replies r WHERE r.ticket_id = t.id) as reply_count
                FROM support_tickets t
                WHERE t.staff_id = ?
                ORDER BY t.created_at DESC
            ");
            $stmt->execute([$staffId]);
            $tickets = $stmt->fetchAll(PDO::FETCH_ASSOC);
            
            error_log('Get Tickets: Found ' . count($tickets) . ' tickets');
            
            $this->sendResponse([
                'status' => 'OK',
                'data' => $tickets
            ]);
        } catch (Exception $e) {
            error_log('Get Tickets Error: ' . $e->getMessage());
            error_log('Get Tickets Error Stack: ' . $e->getTraceAsString());
            $this->sendResponse(['status' => 'FAIL', 'message' => $e->getMessage(), 'debug' => $e->getTraceAsString()], 500);
        }
    }
    
    private function getStaffTicketDetail() {
        // Check authentication
        if (!isset($_SESSION['staff_user'])) {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Not authenticated'], 401);
            return;
        }
        
        $ticketId = $_GET['ticket_id'] ?? null;
        $staffId = $_SESSION['staff_user']['id'] ?? null;
        
        if (!$ticketId) {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Ticket ID required'], 400);
            return;
        }
        
        if (!$staffId) {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Staff ID not found in session'], 401);
            return;
        }
        
        try {
            // Get ticket details
            $stmt = $this->orderModel->db->prepare("
                SELECT t.*, t.description as message, s.full_name as staff_name
                FROM support_tickets t
                LEFT JOIN staff s ON t.staff_id = s.id
                WHERE t.id = ? AND (t.staff_id = ? OR t.staff_id IS NULL)
            ");
            $stmt->execute([$ticketId, $staffId]);
            $ticket = $stmt->fetch(PDO::FETCH_ASSOC);
            
            if (!$ticket) {
                $this->sendResponse(['status' => 'FAIL', 'message' => 'Ticket not found'], 404);
                return;
            }
            
            // Get replies
            $stmt = $this->orderModel->db->prepare("
                SELECT r.*, s.full_name as replier_name,
                       COALESCE(r.is_superadmin, 0) as is_admin,
                       CASE WHEN r.sender_type = 'support' THEN 1 ELSE 0 END as is_support
                FROM support_ticket_replies r
                LEFT JOIN staff s ON r.staff_id = s.id
                WHERE r.ticket_id = ?
                ORDER BY r.created_at ASC
            ");
            $stmt->execute([$ticketId]);
            $replies = $stmt->fetchAll(PDO::FETCH_ASSOC);
            
            // Mark is_admin based on sender_type or is_superadmin
            foreach ($replies as &$reply) {
                $reply['is_admin'] = ($reply['is_support'] == 1 || $reply['is_admin'] == 1) ? 1 : 0;
            }
            
            $ticket['replies'] = $replies;
            
            $this->sendResponse([
                'status' => 'OK',
                'data' => $ticket
            ]);
        } catch (Exception $e) {
            error_log('Get Ticket Detail Error: ' . $e->getMessage());
            $this->sendResponse(['status' => 'FAIL', 'message' => $e->getMessage()], 500);
        }
    }
    
