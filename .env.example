# ============================================================
# Smart Restaurant System - Environment Configuration
# ============================================================
# Copy this file to .env and update with your values
# 
# LOCAL DEVELOPMENT: Use localhost settings
# PRODUCTION: Use smartresto.inovasiyo.rw settings
# ============================================================

# ============================================================
# DATABASE CONFIGURATION
# ============================================================
# Local Development
DB_HOST=localhost
DB_NAME=db_restaurant
DB_USER=root
DB_PWD=

# Production (uncomment and update for deployment)
# DB_HOST=localhost
# DB_NAME=db_restaurant
# DB_USER=smartresto_user
# DB_PWD=CHANGE_THIS_PASSWORD

# ============================================================
# APPLICATION URL
# ============================================================
# Production
APP_BASE_URL=https://smartresto.inovasiyo.rw

# Local Development (comment out for production)
# APP_BASE_URL=http://localhost/restaurant

# ============================================================
# MAIL CONFIGURATION (SMTP)
# ============================================================
# Mail Settings
MAIL_FROM_ADDRESS=info@inovasiyo.rw
MAIL_FROM_NAME=Smart Restaurant System
MAIL_SUPPORT_ADDRESS=info@inovasiyo.rw

# Production SMTP Settings
MAIL_DISABLE_DELIVERY=false
MAIL_SMTP_HOST=mail.inovasiyo.rw
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=info@inovasiyo.rw
MAIL_SMTP_PASSWORD=CHANGE_THIS_PASSWORD
MAIL_SMTP_ENCRYPTION=tls

# ============================================================
# OPTIONAL: MULTI-TENANT CONFIGURATION
# ============================================================
# If using subdomain-based tenancy
# TENANT_MODE=subdomain
# MAIN_DOMAIN=smartresto.inovasiyo.rw

# ============================================================
# SECURITY SETTINGS
# ============================================================
# SESSION_TIMEOUT=1440
# AUTO_TABLE_RELEASE=120
# MAINTENANCE_MODE=off
