    <script>
        const BASE_PATH = '<?php echo rtrim(BASE_URL, '/'); ?>';
        const RESTAURANT_ID = <?php echo $restaurant_id; ?>;
        const USER_ROLE = '<?php echo $user['role']; ?>';
        
        // Track current open order for refresh
        let currentOrderId = null;
        
        // Real-time clock update
        function updateTime() {
            const now = new Date();
            const timeStr = now.toLocaleTimeString('en-US', { 
                hour: '2-digit', 
                minute: '2-digit', 
                second: '2-digit',
                hour12: true 
            });
            const dateStr = now.toLocaleDateString('en-US', {
                weekday: 'long',
                year: 'numeric',
                month: 'long',
                day: 'numeric'
            });
            const timeEl = document.getElementById('currentTime');
            const dateEl = document.getElementById('currentDate');
            if (timeEl) timeEl.textContent = timeStr;
            if (dateEl) dateEl.textContent = dateStr;
        }
        updateTime();
        setInterval(updateTime, 1000);
        
        // Audio notification system
        <?php include __DIR__ . '/../../includes/audio_notification.js'; ?>
        
        // Load orders on page load
        document.addEventListener('DOMContentLoaded', function() {
            const urlParams = new URLSearchParams(window.location.search);
            const shouldCreate = urlParams.get('create');
            
            // Load orders
            loadOrders();
            
            if (shouldCreate === '1') {
                // Small delay to ensure everything is loaded
                setTimeout(() => {
                    openCreateOrderModal();
                }, 300);
            }
        });
        
        // Auto-refresh orders every 10 seconds for real-time updates
        setInterval(() => {
            loadOrders();
        }, 10000);
        
        function loadOrders() {
            const status = document.getElementById('status-filter')?.value || 'all';
            const date = document.getElementById('date-filter')?.value || '';
            const tbody = document.getElementById('orders-table-body');
            
            if (!tbody) return;
            
            tbody.innerHTML = '<tr><td colspan="6" style="text-align: center; padding: 20px;"><i class="fas fa-spinner fa-spin"></i> Loading orders...</td></tr>';
            
            const params = new URLSearchParams();
            params.append('status', status);
            if (date) params.append('date', date);
            params.append('include_items', 'true');
            
            fetch(`${BASE_PATH}/?req=api&action=staff_get_orders&${params.toString()}`, {
                method: 'GET',
                credentials: 'include',
                headers: { 'Accept': 'application/json' }
            })
            .then(r => r.json())
            .then(data => {
                if (data.status === 'OK') {
                    renderOrdersTable(data.data || []);
                } else {
                    tbody.innerHTML = `<tr><td colspan="6" class="no-data">${data.message || 'Error loading orders'}</td></tr>`;
                }
            })
            .catch(err => {
                tbody.innerHTML = '<tr><td colspan="6" class="no-data">Error loading orders. Please refresh the page.</td></tr>';
            });
        }
        
        function renderOrdersTable(orders) {
            const tbody = document.getElementById('orders-table-body');
            const isKitchen = USER_ROLE === 'kitchen';
            
            if (orders.length === 0) {
                tbody.innerHTML = '<tr><td colspan="7" class="no-data">No orders found</td></tr>';
                return;
            }
            
            tbody.innerHTML = orders.map(order => {
                const statusBadge = `<span class="badge badge-${order.status}">${order.status}</span>`;
                const createdDate = new Date(order.created_at).toLocaleString('en-US', {
                    year: 'numeric',
                    month: '2-digit',
                    day: '2-digit',
                    hour: '2-digit',
                    minute: '2-digit'
                });
                const waiterName = order.created_by_name ? escapeHtml(order.created_by_name) : '<em style="color: #999;">System</em>';
                const hasCustomer = order.customer_name ? `<i class="fas fa-user" style="color: #2196f3; margin-left: 5px;" title="Customer: ${escapeHtml(String(order.customer_name || '')).replace(/"/g, '&quot;')}"></i>` : '';
                
                // Check if this is an assigned table (waiter has active order on this table)
                const isAssignedTable = order.table_assigned_waiter && order.table_assigned_waiter !== order.created_by_name;
                const tableIndicator = isAssignedTable ? `<i class="fas fa-link" style="color: #ff9800; margin-left: 5px;" title="Assigned table - Created by ${escapeHtml(String(order.created_by_name || '')).replace(/"/g, '&quot;')}"></i>` : '';
                
                // Check if this is a self-service order (created by customer)
                const isSystemOrder = !order.created_by_name;
                const assignButton = isSystemOrder ? 
                    `<button class="btn btn-warning" onclick="showAssignWaiterModal(${order.id}, '${escapeHtml(String(order.table_number || '')).replace(/'/g, '\\\'')}')" style="padding: 5px 10px; margin-left: 5px;">
                        <i class="fas fa-user-plus"></i> Assign
                    </button>` : '';
                
                return `
                    <tr>
                        <td>#${order.id}${hasCustomer}${tableIndicator}</td>
                        <td>Table ${escapeHtml(order.table_number)}</td>
                        ${isKitchen ? 
                            `<td>${order.items_count || 0} items</td>` : 
                            `<td>${formatCurrency(order.total_amount || 0)}</td>`
                        }
                        <td>${waiterName}</td>
                        <td>${statusBadge}</td>
                        <td>${createdDate}</td>
                        <td>
                            <button class="btn btn-primary" onclick="viewOrderDetails(${order.id})" style="padding: 5px 10px;">
                                <i class="fas fa-eye"></i> View
                            </button>
                            ${assignButton}
                        </td>
                    </tr>
                `;
            }).join('');
        }
        
        function applyFilters() {
            loadOrders();
        }
        
        function clearFilters() {
            document.getElementById('status-filter').value = 'all';
            document.getElementById('date-filter').value = '';
            applyFilters();
        }
        
        function viewOrderDetails(orderId) {
            const modal = document.getElementById('order-modal');
            const content = document.getElementById('order-details-content');
            
            // Set current order ID for refresh
            currentOrderId = orderId;
            
            modal.classList.add('active');
            content.innerHTML = '<div class="loading">Loading order details...</div>';
            
            // Fetch order details
            fetch(`${BASE_PATH}/?req=staff&action=api&api_action=get_order_details&order_id=${orderId}`, {
                method: 'GET',
                credentials: 'include'
            })
            .then(r => r.json())
            .then(data => {
                if (data.status === 'OK') {
                    renderOrderDetails(data.data);
                } else {
                    content.innerHTML = '<div class="alert alert-error">' + (data.message || 'Error loading order details') + '</div>';
                }
            })
            .catch(err => {
                content.innerHTML = '<div class="alert alert-error">Error: ' + err.message + '</div>';
            });
        }
        
        function renderOrderDetails(order) {
            const content = document.getElementById('order-details-content');
            document.getElementById('order-id-display').textContent = order.id;
            
            const isKitchen = USER_ROLE === 'kitchen';
            
            const itemsHtml = order.items ? order.items.map(item => {
                const itemStatus = item.item_status || 'pending';
                const statusColors = {
                    'pending': '#6c757d',
                    'preparing': '#ffc107',
                    'ready': '#17a2b8',
                    'served': '#28a745'
                };
                const statusColor = statusColors[itemStatus] || '#6c757d';
                
                // Determine what controls to show
                const canUpdateStatus = ['kitchen', 'waiter', 'manager', 'admin'].includes(USER_ROLE) && 
                                       !['completed', 'cancelled'].includes(order.status);
                
                // Check if item is beverage for waiter permissions
                const categoryLower = (item.category || '').toLowerCase();
                const isBeverage = ['beverages', 'beverage', 'drinks', 'drink', 'beer', 'wine', 'cocktails', 'soft drinks'].includes(categoryLower);
                
                let statusButtons = '';
                if (canUpdateStatus && itemStatus !== 'served') {
                    // Kitchen, Manager, Admin - full control
                    if ((USER_ROLE === 'kitchen' || USER_ROLE === 'manager' || USER_ROLE === 'admin')) {
                        if (itemStatus === 'pending') {
                            statusButtons += `<button class="btn" onclick="updateItemStatus(${item.id}, 'preparing')" style="background: #ffc107; color: #000; padding: 4px 10px; font-size: 0.75rem; margin-top: 6px;">Start Preparing</button> `;
                        }
                        if (itemStatus === 'preparing') {
                            statusButtons += `<button class="btn" onclick="updateItemStatus(${item.id}, 'ready')" style="background: #17a2b8; color: white; padding: 4px 10px; font-size: 0.75rem; margin-top: 6px;">Mark Ready</button> `;
                        }
                        if (itemStatus === 'ready') {
                            statusButtons += `<button class="btn" onclick="updateItemStatus(${item.id}, 'served')" style="background: #28a745; color: white; padding: 4px 10px; font-size: 0.75rem; margin-top: 6px;">Mark Served</button>`;
                        }
                    }
                    // Waiters can update beverage items at any stage
                    if (USER_ROLE === 'waiter' && isBeverage) {
                        if (itemStatus === 'pending') {
                            statusButtons += `<button class="btn" onclick="updateItemStatus(${item.id}, 'preparing')" style="background: #ffc107; color: #000; padding: 4px 10px; font-size: 0.75rem; margin-top: 6px;">Start Preparing</button> `;
                        }
                        if (itemStatus === 'preparing') {
                            statusButtons += `<button class="btn" onclick="updateItemStatus(${item.id}, 'ready')" style="background: #17a2b8; color: white; padding: 4px 10px; font-size: 0.75rem; margin-top: 6px;">Mark Ready</button> `;
                        }
                        if (itemStatus === 'ready') {
                            statusButtons += `<button class="btn" onclick="updateItemStatus(${item.id}, 'served')" style="background: #28a745; color: white; padding: 4px 10px; font-size: 0.75rem; margin-top: 6px;">Mark Served</button>`;
                        }
                    }
                }
                
                return `
                <div class="order-item">
                    <div>
                        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
                            <strong>${escapeHtml(item.name || 'Item')}</strong>
                            <span style="background: ${statusColor}; color: white; padding: 2px 8px; border-radius: 3px; font-size: 0.7rem; font-weight: 600;">${itemStatus.toUpperCase()}</span>
                        </div>
                        ${item.category ? `<div style="color: #999; font-size: 12px;">${escapeHtml(item.category)}</div>` : ''}
                        ${isKitchen ? `<div style="color: #666; font-size: 13px;">Quantity: ${item.quantity}</div>` : `<div style="color: #666; font-size: 13px;">x${item.quantity} @ ${formatCurrency(item.unit_price || 0)}</div>`}
                        ${item.special_request ? `<div style="color: #f57c00; font-size: 12px; font-style: italic;"><i class="fas fa-comment"></i> ${escapeHtml(item.special_request)}</div>` : ''}
                        ${statusButtons}
                    </div>
                    ${isKitchen ? '' : `<div><strong>${formatCurrency(item.subtotal || 0)}</strong></div>`}
                </div>
                `;
            }).join('') : '<p>No items found</p>';
            
            content.innerHTML = `
                <div>
                    ${order.customer_name ? `
                    <div style="background: #e3f2fd; padding: 12px; border-radius: 5px; margin-bottom: 15px; border-left: 4px solid #2196f3;">
                        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 5px;">
                            <i class="fas fa-user" style="color: #2196f3;"></i>
                            <strong style="font-size: 16px;">${escapeHtml(order.customer_name)}</strong>
                        </div>
                        ${order.customer_phone ? `
                        <div style="color: #666; font-size: 14px;">
                            <i class="fas fa-phone" style="color: #2196f3; width: 16px;"></i> ${escapeHtml(order.customer_phone)}
                        </div>
                        ` : ''}
                    </div>
                    ` : ''}
                    <div style="margin-bottom: 20px;">
                        <strong>Table:</strong> ${order.table_number || 'N/A'}
                        ${order.table_assigned_waiter ? ` <span style="color: #ff9800; font-size: 12px;">(Assigned to: ${escapeHtml(order.table_assigned_waiter)})</span>` : ''}
                        <br>
                        <strong>Status:</strong> <span class="badge badge-${order.status || 'pending'}">${order.status || 'Pending'}</span><br>
                        <strong>Created:</strong> ${new Date(order.created_at).toLocaleString()}<br>
                        ${order.created_by_name ? `<strong>Created By:</strong> <span style="color: #2196f3; font-weight: 600;">${escapeHtml(order.created_by_name)}</span><br>` : ''}
                        ${isKitchen ? '' : `<strong>Total:</strong> <strong style="font-size: 18px;">${formatCurrency(order.total_amount || 0)}</strong>`}
                    </div>
                    ${order.special_instructions ? `
                    <div style="background: #fff3cd; padding: 10px; border-radius: 5px; margin-bottom: 15px;">
                        <strong><i class="fas fa-info-circle"></i> Special Instructions:</strong><br>
                        ${escapeHtml(order.special_instructions)}
                    </div>
                    ` : ''}
                    <div class="order-items">
                        <h4 style="display: flex; justify-content: space-between; align-items: center;">
                            <span>${isKitchen ? 'Items to Prepare' : 'Order Items'}</span>
                            ${(USER_ROLE === 'waiter' || USER_ROLE === 'manager' || USER_ROLE === 'admin') && 
                              (order.status === 'pending' || order.status === 'confirmed') ? `
                                <button class="btn btn-primary" onclick="showAddItemsToOrder(${order.id})" style="font-size: 14px; padding: 6px 12px;">
                                    <i class="fas fa-plus"></i> Add Items
                                </button>
                            ` : ''}
                        </h4>
                        ${itemsHtml}
                    </div>
                    ${getOrderStatusButtons(order)}
                </div>
            `;
        }
        
        function getOrderStatusButtons(order) {
            const status = order.status;
            let buttons = '<div style="margin-top: 20px; display: flex; gap: 10px; flex-wrap: wrap;">';
            
            // Kitchen workflow: confirmed → preparing → ready
            if (USER_ROLE === 'kitchen') {
                if (status === 'confirmed') {
                    buttons += `<button class="btn btn-warning" onclick="updateOrderStatus(${order.id}, 'preparing')" style="flex: 1;">
                        <i class="fas fa-fire"></i> Start Preparing
                    </button>`;
                } else if (status === 'preparing') {
                    buttons += `<button class="btn btn-success" onclick="updateOrderStatus(${order.id}, 'ready')" style="flex: 1;">
                        <i class="fas fa-check-double"></i> Mark as Ready
                    </button>`;
                }
            }
            // Manager/Admin: Full control
            else if (USER_ROLE === 'admin' || USER_ROLE === 'manager') {
                if (status === 'pending') {
                    buttons += `<button class="btn btn-success" onclick="updateOrderStatus(${order.id}, 'confirmed')">
                        <i class="fas fa-check"></i> Confirm Order
                    </button>`;
                    buttons += `<button class="btn btn-danger" onclick="updateOrderStatus(${order.id}, 'cancelled')">
                        <i class="fas fa-times"></i> Cancel Order
                    </button>`;
                } else if (status === 'confirmed') {
                    buttons += `<button class="btn btn-warning" onclick="updateOrderStatus(${order.id}, 'preparing')">
                        <i class="fas fa-fire"></i> Start Preparing
                    </button>`;
                } else if (status === 'preparing') {
                    buttons += `<button class="btn btn-success" onclick="updateOrderStatus(${order.id}, 'ready')">
                        <i class="fas fa-check-double"></i> Mark as Ready
                    </button>`;
                } else if (status === 'ready') {
                    buttons += `<button class="btn btn-success" onclick="updateOrderStatus(${order.id}, 'completed')">
                        <i class="fas fa-flag-checkered"></i> Complete Order
                    </button>`;
                }
            }
            // Waiter: Can confirm orders, modify pending/confirmed orders, and complete ready/served orders
            else if (USER_ROLE === 'waiter') {
                if (status === 'pending') {
                    buttons += `<button class="btn btn-success" onclick="updateOrderStatus(${order.id}, 'confirmed')" style="flex: 1;">
                        <i class="fas fa-check"></i> Confirm Order
                    </button>`;
                } else if (status === 'ready' || status === 'served') {
                    buttons += `<button class="btn btn-success" onclick="updateOrderStatus(${order.id}, 'completed')" style="flex: 1;">
                        <i class="fas fa-flag-checkered"></i> Complete Order
                    </button>`;
                }
            }
            
            buttons += '</div>';
            return buttons;
        }
        
        function updateOrderStatus(orderId, newStatus) {
            if (!confirm(`Change order status to ${newStatus}?`)) {
                return;
            }
            
            fetch(`${BASE_PATH}/?req=api&action=staff_update_order`, {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({
                    order_id: orderId,
                    status: newStatus
                }),
                credentials: 'include'
            })
            .then(r => r.json())
            .then(data => {
                if (data.status === 'OK') {
                    showAlert('Order status updated successfully!', 'success');
                    closeOrderModal();
                    loadOrders(); // Refresh the orders list
                } else {
                    showAlert(data.message || 'Error updating order status', 'error');
                }
            })
            .catch(err => {
                showAlert('Error: ' + err.message, 'error');
            });
        }
        
        function showAlert(message, type) {
            // Create alert element
            const alert = document.createElement('div');
            alert.className = `alert alert-${type === 'success' ? 'success' : 'error'}`;
            alert.style.cssText = 'position: fixed; top: 20px; right: 20px; z-index: 10000; padding: 15px 20px; border-radius: 5px; box-shadow: 0 4px 6px rgba(0,0,0,0.1);';
            alert.textContent = message;
            document.body.appendChild(alert);
            
            setTimeout(() => {
                alert.remove();
            }, 3000);
        }
        
        function closeOrderModal() {
            document.getElementById('order-modal').classList.remove('active');
        }
        
        // Modify Order Item Quantity
        function updateItemQuantity(orderId, itemId, newQuantity) {
            if (newQuantity < 1) {
                showAlert('Quantity cannot be less than 1. Use remove button to delete item.', 'error');
                return;
            }
            
            fetch(`${BASE_PATH}/?req=api&action=staff_update_order_item`, {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({
                    order_item_id: itemId,
                    quantity: newQuantity
                }),
                credentials: 'include'
            })
            .then(r => r.json())
            .then(data => {
                if (data.status === 'OK') {
                    showAlert('Item quantity updated!', 'success');
                    viewOrderDetails(orderId); // Refresh order details
                    loadOrders(); // Refresh orders list
                } else {
                    showAlert(data.message || 'Error updating quantity', 'error');
                }
            })
            .catch(err => {
                showAlert('Error: ' + err.message, 'error');
            });
        }
        
        // Remove Order Item
        function removeOrderItem(orderId, itemId) {
            if (!confirm('Remove this item from the order?')) {
                return;
            }
            
            fetch(`${BASE_PATH}/?req=api&action=staff_remove_order_item`, {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({
                    order_item_id: itemId
                }),
                credentials: 'include'
            })
            .then(r => r.json())
            .then(data => {
                if (data.status === 'OK') {
                    showAlert('Item removed successfully!', 'success');
                    viewOrderDetails(orderId);
                    loadOrders();
                } else {
                    showAlert(data.message || 'Error removing item', 'error');
                }
            })
            .catch(err => {
                showAlert('Error: ' + err.message, 'error');
            });
        }
        
        // Show Add Items Modal (redirects to create order page with pre-filled order ID)
        function showAddItemsToOrder(orderId) {
            // For simplicity, redirect to create order page with order_id parameter
            showAlert('Feature coming soon: Use "Create Order" for the same table to add more items', 'info');
        }
        
        // Update individual item status (kitchen/waiter workflow)
        function updateItemStatus(itemId, newStatus) {
            if (!confirm('Mark this item as ' + newStatus + '?')) {
                return;
            }
            
            fetch(`${BASE_PATH}/?req=api&action=staff_update_item_status`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    order_item_id: itemId,
                    status: newStatus
                }),
                credentials: 'include'
            })
            .then(response => response.json())
            .then(data => {
                if (data.status === 'OK') {
                    showAlert('Item status updated to ' + newStatus, 'success');
                    // Refresh both order details and list
                    if (currentOrderId) {
                        viewOrderDetails(currentOrderId);
                    }
                    loadOrders();
                } else {
                    showAlert(data.message || 'Failed to update item status', 'error');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                showAlert('Error updating item status', 'error');
            });
        }
        
        function formatCurrency(amount) {
            return new Intl.NumberFormat('en-RW', {
                style: 'currency',
                currency: 'RWF',
                minimumFractionDigits: 0
            }).format(amount);
        }
        
        function escapeHtml(text) {
            if (!text && text !== 0) return '';
            const div = document.createElement('div');
            div.textContent = String(text);
            return div.innerHTML;
        }
        
        // Create Order Functions
        let menuItems = [];
        let selectedItems = {};
        let tables = [];
        
        function openCreateOrderModal() {
            const tableId = new URLSearchParams(window.location.search).get('table_id');
            const modal = document.getElementById('create-order-modal');
            modal.classList.add('active');
            
            // Load tables and menu
            loadTablesForOrder();
            loadMenuForOrder();
            
            // Reset form
            selectedItems = {};
            document.getElementById('create-order-form').reset();
            goToStep1();
            
            // Pre-select table if provided
            if (tableId) {
                setTimeout(() => {
                    const tableSelect = document.getElementById('order-table');
                    if (tableSelect) {
                        tableSelect.value = tableId;
                    }
                }, 500);
            }
        }
        
        function closeCreateOrderModal() {
            document.getElementById('create-order-modal').classList.remove('active');
            selectedItems = {};
        }
        
        function loadTablesForOrder() {
            
            fetch(`${BASE_PATH}/?req=api&action=staff_get_tables`, {
                method: 'GET',
                credentials: 'include',
                headers: {
                    'Accept': 'application/json'
                }
            })
            .then(r => {
                return r.json();
            })
            .then(data => {
                
                if (data.status === 'OK') {
                    tables = data.data || [];
                    const select = document.getElementById('order-table');
                    
                    if (tables.length === 0) {
                        select.innerHTML = '<option value="">No tables available</option>';
                        return;
                    }
                    
                    select.innerHTML = '<option value="">Select a table...</option>' +
                        tables.map(t => {
                            const isOccupied = t.status === 'occupied';
                            const statusLabel = t.status ? t.status.charAt(0).toUpperCase() + t.status.slice(1) : 'Unknown';
                            return `<option value="${t.id}" ${isOccupied ? 'disabled' : ''}>Table ${escapeHtml(t.table_number)} - ${statusLabel} (${t.seats} seats)${isOccupied ? ' [OCCUPIED]' : ''}</option>`;
                        }).join('');
                } else {
                    alert('Error loading tables: ' + (data.message || 'Unknown error'));
                }
            })
            .catch(err => {
                alert('Failed to load tables. Please check the console for details.');
            });
        }
        
        function loadMenuForOrder() {
            
            fetch(`${BASE_PATH}/?req=api&action=staff_get_menu`, {
                method: 'GET',
                credentials: 'include',
                headers: {
                    'Accept': 'application/json'
                }
            })
            .then(r => {
                return r.json();
            })
            .then(data => {
                
                if (data.status === 'OK') {
                    menuItems = (data.data || []).filter(item => item.is_available == 1);
                    
                    // Populate category dropdown
                    const categories = [...new Set(menuItems.map(item => item.category).filter(Boolean))];
                    const categoryFilter = document.getElementById('category-filter');
                    if (categoryFilter) {
                        categoryFilter.innerHTML = '<option value="">All Categories</option>' +
                            categories.map(cat => `<option value="${escapeHtml(cat)}">${escapeHtml(cat)}</option>`).join('');
                    }
                    
                    renderMenuItems();
                } else {
                    alert('Error loading menu: ' + (data.message || 'Unknown error'));
                }
            })
            .catch(err => {
                alert('Failed to load menu. Please check the console for details.');
            });
        }
        
        function renderMenuItems() {
            const grid = document.getElementById('menu-items-grid');
            const categoryFilter = document.getElementById('category-filter');
            const selectedCategory = categoryFilter ? categoryFilter.value : '';
            
            // Filter items by selected category
            const filteredItems = selectedCategory 
                ? menuItems.filter(item => item.category === selectedCategory)
                : menuItems;
            
            if (filteredItems.length === 0) {
                grid.innerHTML = '<p style="grid-column: 1/-1; text-align: center; color: #999;">No menu items available in this category</p>';
                return;
            }
            
            grid.innerHTML = filteredItems.map(item => {
                const qty = selectedItems[item.id]?.quantity || 0;
                const isAvailable = item.is_available == 1;
                const unavailableStyle = !isAvailable ? 'opacity: 0.5; background: #f5f5f5;' : '';
                
                return `
                    <div style="border: 1px solid #ddd; border-radius: 8px; padding: 15px; background: white; ${unavailableStyle}">
                        <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 10px;">
                            <strong style="flex: 1;">${escapeHtml(item.name)}</strong>
                            <span class="badge ${isAvailable ? 'badge-success' : 'badge-secondary'}" style="font-size: 11px;">${formatCurrency(item.price)}</span>
                        </div>
                        <div style="color: #666; font-size: 13px; margin-bottom: 10px;">
                            ${escapeHtml(item.category || '')}
                            ${!isAvailable ? '<span style="color: #dc3545; font-weight: bold; margin-left: 5px;">[UNAVAILABLE]</span>' : ''}
                        </div>
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <button type="button" class="btn" onclick="changeQuantity(${item.id}, -1)" style="padding: 5px 10px;" ${qty === 0 || !isAvailable ? 'disabled' : ''}>
                                <i class="fas fa-minus"></i>
                            </button>
                            <input type="number" value="${qty}" min="0" readonly style="width: 50px; text-align: center; border: 1px solid #ddd; border-radius: 4px; padding: 5px;">
                            <button type="button" class="btn btn-primary" onclick="changeQuantity(${item.id}, 1)" style="padding: 5px 10px;" ${!isAvailable ? 'disabled' : ''}>
                                <i class="fas fa-plus"></i>
                            </button>
                        </div>
                    </div>
                `;
            }).join('');
        }
        
        function changeQuantity(menuItemId, delta) {
            const item = menuItems.find(i => i.id == menuItemId);
            
            // Check if item is available
            if (!item || item.is_available != 1) {
                alert('This item is currently unavailable');
                return;
            }
            
            if (!selectedItems[menuItemId]) {
                selectedItems[menuItemId] = {
                    menu_item_id: menuItemId,
                    name: item.name,
                    price: parseFloat(item.price),
                    quantity: 0
                };
            }
            
            selectedItems[menuItemId].quantity += delta;
            
            if (selectedItems[menuItemId].quantity <= 0) {
                delete selectedItems[menuItemId];
            }
            
            renderMenuItems();
            updateSelectedItemsPreview();
        }
        
        function updateSelectedItemsPreview() {
            const count = Object.keys(selectedItems).length;
            const preview = document.getElementById('selected-items-preview');
            const list = document.getElementById('selected-items-list');
            const countSpan = document.getElementById('items-count');
            
            countSpan.textContent = count;
            
            if (count > 0) {
                preview.style.display = 'block';
                list.innerHTML = Object.values(selectedItems).map(item => 
                    `<div style="font-size: 13px; padding: 3px 0;">${item.name} x${item.quantity}</div>`
                ).join('');
            } else {
                preview.style.display = 'none';
            }
        }
        
        function goToStep1() {
            document.getElementById('step-1').style.display = 'block';
            document.getElementById('step-2').style.display = 'none';
            document.getElementById('step-3').style.display = 'none';
        }
        
        function goToStep2() {
            const tableId = document.getElementById('order-table').value;
            if (!tableId) {
                alert('Please select a table first');
                return;
            }
            
            // Check if table is occupied
            const selectedTable = tables.find(t => t.id == tableId);
            if (selectedTable && selectedTable.status === 'occupied') {
                alert('This table is currently occupied. Please select an available or reserved table.');
                return;
            }
            
            document.getElementById('step-1').style.display = 'none';
            document.getElementById('step-2').style.display = 'block';
            document.getElementById('step-3').style.display = 'none';
            
            updateSelectedItemsPreview();
        }
        
        function goToStep3() {
            if (Object.keys(selectedItems).length === 0) {
                alert('Please select at least one item');
                return;
            }
            
            document.getElementById('step-1').style.display = 'none';
            document.getElementById('step-2').style.display = 'none';
            document.getElementById('step-3').style.display = 'block';
            
            renderOrderSummary();
        }
        
        function renderOrderSummary() {
            const tableId = document.getElementById('order-table').value;
            const table = tables.find(t => t.id == tableId);
            const customerName = document.getElementById('customer-name').value;
            const customerPhone = document.getElementById('customer-phone').value;
            
            let total = 0;
            const itemsHtml = Object.values(selectedItems).map(item => {
                const subtotal = item.price * item.quantity;
                total += subtotal;
                return `
                    <div style="display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #ddd;">
                        <div>
                            <strong>${escapeHtml(item.name)}</strong><br>
                            <small style="color: #666;">x${item.quantity} @ ${formatCurrency(item.price)}</small>
                        </div>
                        <div><strong>${formatCurrency(subtotal)}</strong></div>
                    </div>
                `;
            }).join('');
            
            document.getElementById('order-summary').innerHTML = `
                <div style="margin-bottom: 20px;">
                    <strong>Table:</strong> ${table ? table.table_number : 'N/A'}<br>
                    ${customerName ? `<strong>Customer:</strong> ${escapeHtml(customerName)}<br>` : ''}
                    ${customerPhone ? `<strong>Phone:</strong> ${escapeHtml(customerPhone)}<br>` : ''}
                </div>
                <h4 style="margin-bottom: 10px;">Order Items</h4>
                ${itemsHtml}
                <div style="display: flex; justify-content: space-between; padding: 15px 0; font-size: 18px; font-weight: bold;">
                    <div>TOTAL:</div>
                    <div>${formatCurrency(total)}</div>
                </div>
            `;
        }
        
        function submitOrder(event) {
            event.preventDefault();
            
            const tableId = document.getElementById('order-table').value;
            const specialInstructions = document.getElementById('special-instructions').value;
            const customerName = document.getElementById('customer-name').value;
            const customerPhone = document.getElementById('customer-phone').value;
            
            if (!tableId || Object.keys(selectedItems).length === 0) {
                alert('Please complete all required fields');
                return;
            }
            
            const btn = document.getElementById('submit-order-btn');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Creating...';
            
            const orderData = {
                table_id: parseInt(tableId),
                items: Object.values(selectedItems),
                special_instructions: specialInstructions,
                customer_name: customerName,
                customer_phone: customerPhone
            };
            
            fetch(`${BASE_PATH}/?req=api&action=staff_create_order`, {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify(orderData),
                credentials: 'include'
            })
            .then(r => r.json())
            .then(data => {
                if (data.status === 'OK') {
                    alert(`Order created successfully! Order #${data.order_id}\nTotal: ${formatCurrency(data.total_amount)}`);
                    closeCreateOrderModal();
                    location.reload();
                } else {
                    alert('Error: ' + (data.message || 'Failed to create order'));
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-check"></i> Create Order';
                }
            })
            .catch(err => {
                alert('Error: ' + err.message);
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-check"></i> Create Order';
            });
        }
        
        // Assign waiter modal functions
        let waitersCache = null;
        
        function showAssignWaiterModal(orderId, tableNumber) {
            document.getElementById('assign-order-id').value = orderId;
            document.getElementById('assign-table-number').textContent = tableNumber;
            
            // Load waiters if not cached
            if (!waitersCache) {
                loadWaiters();
            } else {
                populateWaiterSelect(waitersCache);
            }
            
            document.getElementById('assign-waiter-modal').style.display = 'flex';
        }
        
        function closeAssignWaiterModal() {
            document.getElementById('assign-waiter-modal').style.display = 'none';
            document.getElementById('waiter-select').value = '';
        }
        
        function loadWaiters() {
            fetch(`${BASE_PATH}/?req=staff&action=get_staff_list`, {
                method: 'GET',
                credentials: 'include'
            })
            .then(r => {
                if (!r.ok) {
                    throw new Error('HTTP ' + r.status);
                }
                return r.json();
            })
            .then(data => {
                if (data.status === 'OK' && data.staff) {
                    // Filter ONLY waiters who are active
                    waitersCache = data.staff.filter(s => 
                        s.role === 'waiter' && s.status === 'active'
                    );
                    // Sort by shift status - on-shift first
                    waitersCache.sort((a, b) => {
                        const aOnShift = a.is_on_shift == 1 ? 1 : 0;
                        const bOnShift = b.is_on_shift == 1 ? 1 : 0;
                        return bOnShift - aOnShift;
                    });
                    populateWaiterSelect(waitersCache);
                } else {
                    alert('Failed to load staff list: ' + (data.message || 'Unknown error'));
                }
            })
            .catch((error) => {
                alert('Failed to load staff list: ' + error.message);
            });
        }
        
        function populateWaiterSelect(waiters) {
            const select = document.getElementById('waiter-select');
            select.innerHTML = '<option value="">-- Select Waiter --</option>';
            
            // Only show on-shift waiters
            const onShiftWaiters = waiters.filter(w => w.is_on_shift == 1);
            const offShiftWaiters = waiters.filter(w => w.is_on_shift != 1);
            
            if (onShiftWaiters.length > 0) {
                const onShiftGroup = document.createElement('optgroup');
                onShiftGroup.label = '✓ Available (On Shift)';
                onShiftWaiters.forEach(waiter => {
                    const option = document.createElement('option');
                    option.value = waiter.id;
                    option.textContent = `${waiter.name}`;
                    onShiftGroup.appendChild(option);
                });
                select.appendChild(onShiftGroup);
            }
            
            if (offShiftWaiters.length > 0) {
                const offShiftGroup = document.createElement('optgroup');
                offShiftGroup.label = '✗ Unavailable (Off Shift)';
                offShiftWaiters.forEach(waiter => {
                    const option = document.createElement('option');
                    option.value = waiter.id;
                    option.textContent = `${waiter.name}`;
                    option.disabled = true; // Disable off-shift waiters
                    option.style.color = '#999';
                    offShiftGroup.appendChild(option);
                });
                select.appendChild(offShiftGroup);
            }
            
            // Show warning if no on-shift waiters
            if (onShiftWaiters.length === 0) {
                const warningOption = document.createElement('option');
                warningOption.disabled = true;
                warningOption.textContent = 'No waiters currently on shift';
                warningOption.style.color = 'red';
                select.appendChild(warningOption);
            }
        }
        
        function assignWaiterToOrder() {
            const orderId = document.getElementById('assign-order-id').value;
            const waiterId = document.getElementById('waiter-select').value;
            
            if (!waiterId) {
                alert('Please select a waiter');
                return;
            }
            
            // Check if selected waiter is on shift
            const selectedWaiter = waitersCache.find(w => w.id == waiterId);
            if (selectedWaiter && selectedWaiter.is_on_shift != 1) {
                alert('Cannot assign order to off-shift waiter. Please select a waiter who is currently on shift.');
                return;
            }
            
            const formData = new FormData();
            formData.append('order_id', orderId);
            formData.append('waiter_id', waiterId);
            
            fetch(`${BASE_PATH}/?req=staff&action=assign_waiter_to_order`, {
                method: 'POST',
                body: formData,
                credentials: 'include'
            })
            .then(r => r.json())
            .then(data => {
                if (data.status === 'OK') {
                    alert(`Waiter assigned successfully to order #${orderId}`);
                    closeAssignWaiterModal();
                    loadOrders(); // Reload orders list
                } else {
                    alert('Error: ' + (data.message || 'Failed to assign waiter'));
                }
            })
            .catch(err => {
                console.error('Failed to assign waiter:', err);
                alert('Error: ' + err.message);
            });
        }
        
        // Mobile menu toggle functions
        function toggleMobileMenu() {
            const sidebar = document.querySelector('.sidebar');
            const overlay = document.querySelector('.mobile-overlay');
            if (sidebar && overlay) {
                sidebar.classList.toggle('mobile-open');
                overlay.classList.toggle('active');
                document.body.style.overflow = sidebar.classList.contains('mobile-open') ? 'hidden' : '';
            }
        }
        
        function closeMobileMenu() {
            const sidebar = document.querySelector('.sidebar');
            const overlay = document.querySelector('.mobile-overlay');
            if (sidebar && overlay) {
                sidebar.classList.remove('mobile-open');
                overlay.classList.remove('active');
                document.body.style.overflow = '';
            }
        }
    </script>
</body>
</html>

