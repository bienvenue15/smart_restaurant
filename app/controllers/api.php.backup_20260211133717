            $stats['pending_orders'] = $stmt->fetchColumn();
            
            // Active tables (with current orders)
            $query = "SELECT COUNT(DISTINCT table_uuid) as count FROM orders 
                     WHERE restaurant_uuid = ? AND status NOT IN ('completed', 'cancelled')";
            $stmt = $this->db->prepare($query);
            $stmt->execute([$restaurantId]);
            $stats['active_tables'] = $stmt->fetchColumn();
            
            // For cashiers - cash balance
            if ($role === 'cashier') {
                $query = "SELECT COALESCE(SUM(CASE 
                                WHEN type = 'deposit' OR type = 'cash_payment' THEN amount 
                                WHEN type = 'withdrawal' OR type = 'expense' THEN -amount 
                                ELSE 0 END), 0) as balance
                         FROM cash_transactions 
                         WHERE staff_uuid = ? AND session_id IN (
                             SELECT uuid FROM cash_sessions WHERE staff_uuid = ? AND status = 'open'
                         )";
                $stmt = $this->db->prepare($query);
                $stmt->execute([$userId, $userId]);
                $stats['cash_balance'] = $stmt->fetchColumn();
            }
            
            // Waiter calls count - for all staff who can see calls
            if (in_array($role, ['admin', 'manager', 'waiter'])) {
                try {
                    $query = "SELECT COUNT(*) as count FROM waiter_calls 
                             WHERE restaurant_uuid = ? AND status = 'pending'";
                    $stmt = $this->db->prepare($query);
                    $stmt->execute([$restaurantId]);
                    $stats['waiter_calls_count'] = $stmt->fetchColumn();
                } catch (PDOException $e) {
                    // Table might not exist yet, default to 0
                    $stats['waiter_calls_count'] = 0;
                }
            }
            
            // Pending approvals count - for admins and managers
            if (in_array($role, ['admin', 'manager'])) {
                try {
                    $query = "SELECT COUNT(*) as count FROM approval_requests 
                             WHERE restaurant_uuid = ? AND status = 'pending'";
                    $stmt = $this->db->prepare($query);
                    $stmt->execute([$restaurantId]);
                    $stats['pending_approvals'] = $stmt->fetchColumn();
                } catch (PDOException $e) {
                    // Table might not exist yet, default to 0
                    $stats['pending_approvals'] = 0;
                }
            }
            
            $this->sendResponse([
                'status' => 'OK',
                'data' => $stats
            ]);
            
        } catch (PDOException $e) {
            error_log("Dashboard Stats Error: " . $e->getMessage());
            $this->sendResponse([
                'status' => 'FAIL',
                'message' => 'Database error: ' . $e->getMessage()
            ], 500);
        }
    }
    
