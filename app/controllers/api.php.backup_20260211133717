    /**
     * Update individual item status (kitchen/waiter workflow)
     */
    private function staffUpdateItemStatus() {
        $role = $_SESSION['staff_role'] ?? '';
        
        // Kitchen, waiters, managers, and admins can update item status
        if (!in_array($role, ['kitchen', 'waiter', 'manager', 'admin'])) {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Permission denied'], 403);
            return;
        }
        
        if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Method not allowed'], 405);
            return;
        }
        
        $input = file_get_contents('php://input');
        $data = json_decode($input, true);
        
        if (!$data || !isset($data['order_item_id']) || !isset($data['status'])) {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Missing required fields'], 400);
            return;
        }
        
        $orderItemId = intval($data['order_item_id']);
        $newStatus = $data['status'];
        
        // Validate status
        $validStatuses = ['pending', 'preparing', 'ready', 'served'];
        if (!in_array($newStatus, $validStatuses)) {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Invalid status'], 400);
            return;
        }
        
        // Role-based status restrictions
        if ($role === 'kitchen' && !in_array($newStatus, ['preparing', 'ready'])) {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Kitchen can only mark items as preparing or ready'], 403);
            return;
        }
        
        try {
            $this->orderModel->db->beginTransaction();
            
            // Get item and order details including category
            $query = "SELECT oi.*, o.status as order_status, o.id as order_id, 
                      mi.name as item_name, mc.name as category_name
                      FROM order_items oi 
                      INNER JOIN orders o ON oi.order_id = o.id
                      INNER JOIN menu_items mi ON oi.menu_item_id = mi.id
                      LEFT JOIN menu_categories mc ON mi.category_id = mc.id
                      WHERE oi.id = ?";
            $stmt = $this->orderModel->db->prepare($query);
            $stmt->execute([$orderItemId]);
            $item = $stmt->fetch(PDO::FETCH_ASSOC);
            
            if (!$item) {
                $this->orderModel->db->rollBack();
                $this->sendResponse(['status' => 'FAIL', 'message' => 'Order item not found'], 404);
                return;
            }
            
            // Waiters can only update status for beverage items
            if ($role === 'waiter') {
                $categoryName = strtolower($item['category_name'] ?? '');
                $isBeverage = in_array($categoryName, ['beverages', 'beverage', 'drinks', 'drink', 'beer', 'wine', 'cocktails', 'soft drinks']);
                
                if (!$isBeverage) {
                    $this->orderModel->db->rollBack();
                    $this->sendResponse(['status' => 'FAIL', 'message' => 'Waiters can only update status for beverage items'], 403);
                    return;
                }
            }
            
            // Don't allow updates on completed/cancelled orders
            if (in_array($item['order_status'], ['completed', 'cancelled'])) {
                $this->orderModel->db->rollBack();
                $this->sendResponse(['status' => 'FAIL', 'message' => 'Cannot update items in ' . $item['order_status'] . ' orders'], 400);
                return;
            }
            
            // Update item status
            $updateQuery = "UPDATE order_items SET status = ? WHERE uuid = ?";
            $updateStmt = $this->orderModel->db->prepare($updateQuery);
            $updateStmt->execute([$newStatus, $orderItemId]);
            
            // Auto-update order status based on all items
            $this->updateOrderStatusFromItems($item['order_id']);
            
            $this->orderModel->db->commit();
            
            $this->sendResponse([
                'status' => 'OK',
                'message' => 'Item status updated successfully',
                'new_status' => $newStatus
            ]);
            
        } catch (PDOException $e) {
            $this->orderModel->db->rollBack();
            error_log('[API] Update item status error: ' . $e->getMessage());
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Database error'], 500);
        }
    }
    
    /**
     * Update order status based on all items' statuses
     */
    private function updateOrderStatusFromItems($orderId) {
        // Get all item statuses
        $query = "SELECT status, COUNT(*) as count FROM order_items WHERE order_uuid = ? GROUP BY status";
        $stmt = $this->orderModel->db->prepare($query);
        $stmt->execute([$orderId]);
        $statusCounts = $stmt->fetchAll(PDO::FETCH_KEY_PAIR);
        
        $totalItems = array_sum($statusCounts);
        
        // Determine new order status
        $newOrderStatus = null;
        
        if (isset($statusCounts['served']) && $statusCounts['served'] == $totalItems) {
            // All items served
            $newOrderStatus = 'ready'; // Order is ready to be marked as served/completed by waiter
        } elseif (isset($statusCounts['ready']) && ($statusCounts['ready'] + ($statusCounts['served'] ?? 0)) > 0) {
            // At least one item ready or served
            $newOrderStatus = 'ready';
        } elseif (isset($statusCounts['preparing']) && $statusCounts['preparing'] > 0) {
            // At least one item preparing
            $newOrderStatus = 'preparing';
        } elseif (isset($statusCounts['pending']) && $statusCounts['pending'] == $totalItems) {
            // All items still pending
            $newOrderStatus = 'confirmed';
        }
        
        // Update order status if determined
        if ($newOrderStatus) {
            $updateQuery = "UPDATE orders SET status = ?, updated_at = NOW() WHERE uuid = ?";
            $updateStmt = $this->orderModel->db->prepare($updateQuery);
            $updateStmt->execute([$newOrderStatus, $orderId]);
        }
    }
    
    /**
     * Kitchen staff updates menu item availability
     */
    private function kitchenUpdateAvailability() {
        // Clear any output buffers to ensure clean JSON response
        while (ob_get_level()) {
            ob_end_clean();
        }
        ob_start();
        
        // Log request for debugging
        error_log('[Kitchen Availability] Request received - Role: ' . ($_SESSION['staff_role'] ?? 'NOT SET') . ', User: ' . ($_SESSION['staff_name'] ?? 'UNKNOWN'));
        
        $role = $_SESSION['staff_role'] ?? '';
        
        // Allow kitchen, manager, and admin to update availability
        if (!in_array($role, ['kitchen', 'manager', 'admin'])) {
            error_log('[Kitchen Availability] Permission denied for role: ' . $role);
            ob_end_clean();
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Permission denied'], 403);
            return;
        }
        
        if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
            ob_end_clean();
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Method not allowed'], 405);
            return;
        }
        
        $input = file_get_contents('php://input');
        $data = json_decode($input, true);
        
        if (!$data || !isset($data['item_id']) || !isset($data['is_available'])) {
            ob_end_clean();
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Missing required fields'], 400);
            return;
        }
        
        $itemId = intval($data['item_id']);
        $isAvailable = (bool)$data['is_available'];
        $reason = $data['reason'] ?? '';
        
        try {
            // Get item details before update
            $query = "SELECT mi.*, mc.name as category_name, mi.restaurant_id 
                      FROM menu_items mi 
                      LEFT JOIN menu_categories mc ON mi.category_id = mc.id 
                      WHERE mi.id = ?";
            $stmt = $this->db->prepare($query);
            $stmt->execute([$itemId]);
            $item = $stmt->fetch(PDO::FETCH_ASSOC);
            
            if (!$item) {
                error_log('[Kitchen Availability] Menu item not found - ID: ' . $itemId);
                ob_end_clean();
                $this->sendResponse(['status' => 'FAIL', 'message' => 'Menu item not found'], 404);
                return;
            }
            
            // Kitchen staff cannot update beverages category items
            if ($role === 'kitchen' && strtolower($item['category_name']) === 'beverages') {
                error_log('[Kitchen Availability] Beverage restriction - Item: ' . $item['name'] . ', Role: ' . $role);
                ob_end_clean();
                $this->sendResponse(['status' => 'FAIL', 'message' => 'Kitchen staff cannot update beverage availability'], 403);
                return;
            }
            
            // Update availability
            error_log('[Kitchen Availability] Updating item: ' . $item['name'] . ' to ' . ($isAvailable ? 'AVAILABLE' : 'UNAVAILABLE'));
            $updateQuery = "UPDATE menu_items SET is_available = ?, updated_at = NOW() WHERE uuid = ?";
            $updateStmt = $this->db->prepare($updateQuery);
            $updateStmt->execute([$isAvailable ? 1 : 0, $itemId]);
            
            $staffId = $_SESSION['staff_uuid'] ?? $_SESSION['staff_user']['uuid'] ?? null;
            $staffName = $_SESSION['staff_name'] ?? $_SESSION['staff_user']['full_name'] ?? 'Kitchen Staff';
            
            // Send notification to manager and owner (wrapped in try-catch)
            try {
                $this->notifyAvailabilityChange(
                    $item['restaurant_id'],
                    $item['name'],
                    $item['category_name'],
                    $isAvailable,
                    $staffName,
                    $reason
                );
                error_log('[Kitchen Availability] Notification sent successfully');
            } catch (Exception $notifError) {
                error_log('[Kitchen] Notification failed but continuing: ' . $notifError->getMessage());
                // Don't fail the main operation if notification fails
            }
            
            // Log the change
            $changeLog = [
                'item_id' => $itemId,
                'item_name' => $item['name'],
                'old_status' => $item['is_available'] ? 'available' : 'unavailable',
                'new_status' => $isAvailable ? 'available' : 'unavailable',
                'changed_by' => $staffName,
                'reason' => $reason,
                'timestamp' => date('Y-m-d H:i:s')
            ];
            error_log('[Kitchen] Menu availability changed: ' . json_encode($changeLog));
            
            ob_end_clean();
            $this->sendResponse([
                'status' => 'OK',
                'message' => 'Item availability updated successfully',
                'is_available' => $isAvailable
            ]);
            
        } catch (PDOException $e) {
            error_log('[API] Kitchen update availability error: ' . $e->getMessage());
            ob_end_clean();
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Database error'], 500);
        } catch (Exception $e) {
            error_log('[API] Kitchen update availability error: ' . $e->getMessage());
            ob_end_clean();
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Server error'], 500);
        }
    }
    
    /**
     * Send notification about menu availability change
     */
    private function notifyAvailabilityChange($restaurantId, $itemName, $categoryName, $isAvailable, $staffName, $reason) {
        try {
            // Get manager and owner staff users
            $query = "SELECT uuid, full_name, email FROM staff_users 
                      WHERE restaurant_uuid = ? 
                      AND role IN ('manager', 'admin') 
