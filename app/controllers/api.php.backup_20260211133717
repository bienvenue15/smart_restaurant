    /**
     * Get waiter performance summary (manager/admin only)
     */
    private function staffGetWaiterPerformance() {
        // Check authentication
        if (!isset($_SESSION['staff_user']) || !isset($_SESSION['staff_id'])) {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Unauthorized'], 401);
            return;
        }
        
        $role = $_SESSION['staff_user']['role'] ?? '';
        if (!in_array($role, ['admin', 'manager'])) {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Access denied - Manager/Admin only'], 403);
            return;
        }
        
        $restaurantId = $_SESSION['staff_user']['restaurant_id'] ?? null;
        
        if (!$restaurantId) {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Restaurant context not found'], 400);
            return;
        }
        
        try {
            // Get waiter performance from liability summary view
            $query = "SELECT 
                        su.id,
                        su.full_name,
                        su.role,
                        COALESCE(vls.active_count, 0) as liability_count,
                        COALESCE(vls.active_amount, 0) as total_amount,
                        NULL as avg_age_hours,
                        NULL as oldest_liability
                      FROM staff_users su
                      LEFT JOIN v_waiter_liability_summary vls 
                        ON su.id = vls.waiter_id AND su.restaurant_id = vls.restaurant_id
                      WHERE su.restaurant_id = ? 
                      AND su.role = 'waiter'
                      AND su.is_active = 1
                      ORDER BY COALESCE(vls.active_amount, 0) DESC, su.full_name ASC";
            
            $stmt = $this->orderModel->db->prepare($query);
            $stmt->execute([$restaurantId]);
            $waiters = $stmt->fetchAll(PDO::FETCH_ASSOC);
            
            $this->sendResponse([
                'status' => 'OK',
                'data' => $waiters
            ]);
            
        } catch (Exception $e) {
            error_log("Get Waiter Performance Error: " . $e->getMessage());
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Failed to retrieve waiter performance'], 500);
        }
    }
    
    /**
     * Auto-release table and device locks if no active orders remain
     * Call this after order cancellation or payment completion
     */
    private function autoReleaseTableIfNoActiveOrders($tableId) {
        if (!$tableId) return;
        
        try {
            // Check if there are any active/unpaid orders on this table
            $remainingOrdersQuery = "SELECT COUNT(*) FROM orders 
                                    WHERE table_uuid = ? 
                                    AND (status IN ('pending', 'confirmed', 'preparing', 'ready', 'served')
                                         OR (status = 'completed' AND payment_status = 'pending'))";
            $stmt = $this->db->prepare($remainingOrdersQuery);
            $stmt->execute([$tableId]);
            $remainingOrders = $stmt->fetchColumn();
            
            // Only release table and device locks if NO active/unpaid orders remain
            if ($remainingOrders == 0) {
                // Make table available for new customers
                $releaseTableQuery = "UPDATE restaurant_tables SET status = 'available' WHERE uuid = ?";
                $releaseStmt = $this->db->prepare($releaseTableQuery);
                $releaseStmt->execute([$tableId]);
                
                // Release ALL device locks for this table
                require_once __DIR__ . '/../core/DeviceTableLock.php';
                $deviceLock = new DeviceTableLock();
                $result = $deviceLock->forceReleaseTableLocks($tableId);
                
                error_log("[AUTO_RELEASE] ✓ Table $tableId freed - no active orders remain. Device locks released.");
                return true;
            } else {
                error_log("[AUTO_RELEASE] Table $tableId kept occupied - $remainingOrders active/unpaid order(s) remain");
                return false;
            }
            
        } catch (Exception $e) {
            error_log("[AUTO_RELEASE] Error for table $tableId: " . $e->getMessage());
            return false;
        }
    }
    
    /**
     * Send JSON response
     */
    private function sendResponse($data, $statusCode = 200) {
        // Clear all output buffers to ensure clean JSON
        while (ob_get_level()) {
            ob_end_clean();
        }
        
        // Set headers
        header('Content-Type: application/json', true);
        http_response_code($statusCode);
        
        // Output JSON and exit
        echo json_encode($data, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE);
        exit();
    }
