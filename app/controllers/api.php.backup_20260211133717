                'quantity' => intval($item['quantity']),
                'price' => floatval($item['price']),
                'special_request' => isset($item['special_request']) ? 
                                   $this->sanitize($item['special_request']) : ''
            ];
        }
        
        // Add items to order
        $result = $this->orderModel->addItemsToOrder($orderId, $sanitizedItems);
        
        // If successful, send notification to assigned waiter and manager
        if ($result['status'] === 'OK') {
            $this->notifyStaffAboutOrderUpdate($orderId, 'items_added', $order);
        }
        
        $this->sendResponse($result);
