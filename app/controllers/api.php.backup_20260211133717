    /**
     * Process payment (staff only)
     */
    private function staffProcessPayment() {
        // Clear any output buffer to ensure clean JSON response
        while (ob_get_level() > 0) {
            ob_end_clean();
        }
        ob_start();
        
        try {
            Permission::require('accept_payment');
        } catch (Exception $e) {
            ob_end_clean();
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Permission denied: ' . $e->getMessage()], 403);
            return;
        }
        
        // Cashiers don't need to be on shift for processing payments (can be done at any time)
        
        if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
            ob_end_clean();
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Method not allowed'], 405);
            return;
        }
        
        // Handle both JSON and FormData inputs
        $data = null;
        $contentType = $_SERVER['CONTENT_TYPE'] ?? '';
        
        if (strpos($contentType, 'application/json') !== false) {
            $input = file_get_contents('php://input');
            $data = json_decode($input, true);
        } else {
            // FormData sent via multipart/form-data
            $data = $_POST;
        }
        
        if (!$data || !isset($data['order_uuid']) || !isset($data['payment_method']) || !isset($data['amount'])) {
            ob_end_clean();
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Missing required fields (order_uuid, payment_method, amount)'], 400);
            return;
        }
        
        // Validate UUID format
        if (!UuidHelper::isValidUuid($data['order_uuid'])) {
            ob_end_clean();
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Invalid UUID format. For security, only UUIDs are accepted, not integer IDs.'], 400);
            return;
        }
        
        // Get order ID from UUID
        $orderId = $this->uuidHelper->getOrderIdByUuid($data['order_uuid']);
        if (!$orderId) {
            ob_end_clean();
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Order not found'], 404);
            return;
        }
        
        $orderUuid = $data['order_uuid'];
        $paymentMethod = $this->sanitize($data['payment_method']);
        $amount = floatval($data['amount']);
        $receivedAmount = isset($data['received_amount']) ? floatval($data['received_amount']) : $amount;
        $reference = isset($data['reference']) ? $this->sanitize($data['reference']) : null;
        $isCashForMomo = isset($data['is_cash_for_momo']) && ($data['is_cash_for_momo'] === true || $data['is_cash_for_momo'] === '1' || $data['is_cash_for_momo'] === 1);
        $staffId = $_SESSION['staff_uuid'] ?? $_SESSION['staff_user']['uuid'] ?? null;
        
        if (!$staffId) {
            ob_end_clean();
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Staff ID not found in session'], 401);
            return;
        }
        
        // Calculate change for cash payments
        $change = ($paymentMethod === 'cash' && $receivedAmount > $amount) ? ($receivedAmount - $amount) : 0;
        
        // ALL payment methods affect cash_in_hand:
        // - Cash: Direct payment
        // - Mobile Money: Customer gives cash, cashier sends via USSD (*182*8*1#)
        // - Card: Customer gives cash, cashier processes via POS
        // In all cases, cashier receives physical cash from customer
        $addCashToDrawer = true;
        
        try {
            // Start transaction
            $this->orderModel->db->beginTransaction();
            
            // Verify order exists and get total
            $query = "SELECT total_amount, status, payment_status FROM orders WHERE uuid = ?";
            $stmt = $this->orderModel->db->prepare($query);
            $stmt->execute([$orderId]);
            $order = $stmt->fetch(PDO::FETCH_ASSOC);
            
            if (!$order) {
                $this->orderModel->db->rollBack();
                $this->sendResponse(['status' => 'FAIL', 'message' => 'Order not found'], 404);
                return;
            }
            
            if ($order['payment_status'] === 'paid') {
                $this->orderModel->db->rollBack();
                $this->sendResponse(['status' => 'FAIL', 'message' => 'Order payment already completed'], 400);
                return;
            }
            
            // Insert payment record directly
            $paymentQuery = "INSERT INTO payments (restaurant_id, order_id, payment_method, amount, received_amount, change_amount, received_by, payment_reference, status, payment_date) 
                            VALUES (?, ?, ?, ?, ?, ?, ?, ?, 'completed', NOW())";
            $paymentStmt = $this->orderModel->db->prepare($paymentQuery);
            $paymentStmt->execute([$this->restaurantId, $orderId, $paymentMethod, $amount, $receivedAmount, $change, $staffId, $reference]);
            $paymentId = $this->orderModel->db->lastInsertId();
            
            if (!$paymentId) {
                $this->orderModel->db->rollBack();
                error_log('[PAYMENT] Failed to insert payment record');
                $this->sendResponse(['status' => 'FAIL', 'message' => 'Failed to record payment'], 500);
                return;
            }
            
            // Get order table_id before updating
            $tableQuery = "SELECT table_id FROM orders WHERE uuid = ?";
            $tableStmt = $this->orderModel->db->prepare($tableQuery);
            $tableStmt->execute([$orderId]);
            $tableId = $tableStmt->fetchColumn();
            
            // Update order payment status and mark as completed
            $query = "UPDATE orders SET payment_status = 'paid', status = 'completed', paid_amount = ?, paid_at = NOW(), paid_to = ?, payment_method = ?, updated_at = NOW() WHERE uuid = ?";
            $stmt = $this->orderModel->db->prepare($query);
            $stmt->execute([$amount, $staffId, $paymentMethod, $orderId]);
            
            // Auto-release table when order is paid
            if ($tableId) {
                // Check if there are any remaining UNPAID orders on this table
                $remainingOrdersQuery = "SELECT COUNT(*) FROM orders 
                                        WHERE table_uuid = ? 
                                        AND (status IN ('pending', 'confirmed', 'preparing', 'ready', 'served')
                                             OR (status = 'completed' AND payment_status = 'pending'))";
                $remainingStmt = $this->orderModel->db->prepare($remainingOrdersQuery);
                $remainingStmt->execute([$tableId]);
                $remainingOrders = $remainingStmt->fetchColumn();
                
                // Only release table and device locks if NO unpaid orders remain
                if ($remainingOrders == 0) {
                    // Make table available for new customers
                    $releaseTableQuery = "UPDATE restaurant_tables SET status = 'available' WHERE uuid = ?";
                    $releaseTableStmt = $this->orderModel->db->prepare($releaseTableQuery);
                    $releaseTableStmt->execute([$tableId]);
                    
                    // Release device locks
                    try {
                        require_once __DIR__ . '/../core/DeviceTableLock.php';
                        $deviceLock = new DeviceTableLock();
                        $deviceLock->forceReleaseTableLocks($tableId);
                        error_log("[PAYMENT] All orders paid - table $tableId released and device locks cleared");
                    } catch (Exception $e) {
                        error_log("[PAYMENT] Failed to release device locks: " . $e->getMessage());
                    }
                } else {
                    error_log("[PAYMENT] $remainingOrders unpaid order(s) remain on table $tableId - keeping visible for theft prevention");
                }
            }
            
            $cashSessionId = null;
            
            // Update cash in hand if cash was received (direct cash OR cash for mobile money)
            if ($addCashToDrawer && $receivedAmount > 0) {
                // Get active cash session
                $cashQuery = "SELECT uuid FROM cash_sessions 
                             WHERE staff_uuid = ? AND status = 'open' 
                             ORDER BY opened_at DESC LIMIT 1";
                $cashStmt = $this->orderModel->db->prepare($cashQuery);
                $cashStmt->execute([$staffId]);
                $session = $cashStmt->fetch(PDO::FETCH_ASSOC);
                
                if ($session) {
                    $cashSessionId = $session['id'];
                    
                    // Record cash transaction for audit trail and cash_in_hand calculation
                    $transactionDescription = "Payment for Order #$orderId";
                    if ($paymentMethod === 'mobile_money') {
                        $transactionDescription .= " (Cash received, sent via MoMo)";
                    } elseif ($paymentMethod === 'card') {
                        $transactionDescription .= " (Cash received, processed via POS)";
                    }
                    
                    $cashTransactionData = [
                        'cash_session_id' => $cashSessionId,
                        'restaurant_id' => $this->restaurantId,
                        'staff_id' => $staffId,
                        'transaction_type' => 'sale',
                        'amount' => $receivedAmount,
                        'description' => $transactionDescription,
                        'reference_number' => $reference,
                        'order_id' => $orderId,
                        'payment_id' => $paymentId
                    ];
                    
                    $this->staffModel->save('cash_transactions', $cashTransactionData);
                } else {
                    // No open session - log warning
                    error_log("WARNING: Cash received but no open cash session for staff_id: $staffId");
                }
            }
            
            // Commit transaction
            $this->orderModel->db->commit();
            
            // Clear waiter liability if exists
            try {
                require_once __DIR__ . '/../models/WaiterLiability.php';
                $liabilityModel = new WaiterLiability($this->orderModel->db);
                $liabilityModel->clearLiability($orderId, $staffId, $paymentMethod);
            } catch (Exception $e) {
                error_log('[PAYMENT] Failed to clear liability: ' . $e->getMessage());
                // Don't fail payment if liability clearing fails
            }
            
            // Log audit trail
            Permission::logAudit('accept_payment', 'payments', $paymentId, null, 
                               json_encode(['order_id' => $orderId, 'amount' => $amount, 'method' => $paymentMethod, 'change' => $change]));
            
            ob_end_clean();
            
            // Generate appropriate success message based on payment method
            $message = 'Payment recorded successfully';
            if ($cashSessionId) {
                $message .= ' - Cash drawer updated';
                if ($paymentMethod === 'mobile_money' && $reference) {
                    $message .= ' (MoMo Ref: ' . $reference . ')';
                } elseif ($paymentMethod === 'card' && $reference) {
                    $message .= ' (Card Auth: ' . $reference . ')';
                }
            }
            
            $this->sendResponse([
                'status' => 'OK', 
                'message' => $message,
                'payment_id' => $paymentId,
                'change' => $change
            ]);
            
        } catch (PDOException $e) {
            // Rollback on error
            if ($this->orderModel->db->inTransaction()) {
                $this->orderModel->db->rollBack();
            }
            ob_end_clean();
            error_log('[PAYMENT] Database error: ' . $e->getMessage());
            error_log('[PAYMENT] SQL State: ' . $e->getCode());
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Database error: ' . $e->getMessage()], 500);
        } catch (Exception $e) {
            // Rollback on error
            if ($this->orderModel->db->inTransaction()) {
                $this->orderModel->db->rollBack();
            }
            ob_end_clean();
            error_log('[PAYMENT] Processing error: ' . $e->getMessage());
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Payment processing failed: ' . $e->getMessage()], 500);
        }
    }
    
