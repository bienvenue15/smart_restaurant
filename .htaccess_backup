# ============================================
# Smart Restaurant System - Production .htaccess
# ============================================

# Enable Rewrite Engine
RewriteEngine On

# ============================================
# HTTPS Redirect (Production Only)
# ============================================
# Uncomment for production to force HTTPS
# RewriteCond %{HTTPS} off
# RewriteCond %{HTTP_HOST} !^localhost [NC]
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ============================================
# Security Headers (Always applied last)
# ============================================
<IfModule mod_headers.c>
    # Only set headers for non-PHP responses to avoid conflicts with session
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ============================================
# Hide Sensitive Files
# ============================================
<FilesMatch "(^\.htaccess|^\.env|^\.git|\.sql$|\.md$|deploy.*\.(sh|ps1)$|^composer\.(json|lock)$)">
    Order allow,deny
    Deny from all
</FilesMatch>

# Protect config files from direct browser access
<Files "config.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

# ============================================
# Performance Optimization
# ============================================

# Enable Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Images
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    
    # CSS and JavaScript
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    
    # Fonts
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    
    # HTML (no cache for dynamic content)
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ============================================
# File Upload Limits
# ============================================
php_value upload_max_filesize 5M
php_value post_max_size 6M
php_value max_execution_time 60
php_value max_input_time 60

# ============================================
# Directory Index
# ============================================
DirectoryIndex index.php index.html

# Prevent directory listing
Options -Indexes

# ============================================
# URL Rewriting
# ============================================
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-l
RewriteRule ^(.+)$ index.php?req=$1 [QSA,L]

# ============================================
# Error Pages (Optional - customize as needed)
# ============================================
# ErrorDocument 404 /404.html
# ErrorDocument 500 /500.html

