    /**
     * Helper: Calculate order progress percentage
     */
    private function calculateOrderProgress($status) {
        $progressMap = [
            'pending' => 10,
            'confirmed' => 30,
            'preparing' => 60,
            'ready' => 85,
            'served' => 100,
            'completed' => 100,
            'cancelled' => 0
        ];
        
        return $progressMap[$status] ?? 0;
    }
    
    /**
     * Helper: Estimate order completion time
     */
    private function estimateOrderTime($order) {
        if (in_array($order['status'], ['served', 'completed', 'cancelled'])) {
            return null;
        }
        
        // Simple estimation: average 15 minutes per order
        $items = $order['items'] ?? [];
        $maxPrepTime = 15; // default
        
        foreach ($items as $item) {
            if (isset($item['preparation_time']) && $item['preparation_time'] > $maxPrepTime) {
                $maxPrepTime = $item['preparation_time'];
            }
        }
        
        // Add buffer time based on status
        $bufferTime = match($order['status']) {
            'pending' => 5,
            'confirmed' => 2,
            'preparing' => 0,
            default => 0
        };
        
        return $maxPrepTime + $bufferTime;
    }
    
