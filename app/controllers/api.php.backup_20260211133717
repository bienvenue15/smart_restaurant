    /**
     * Cancel an order (Admin/Manager only)
     * Cannot cancel orders that are already ready or served
     */
    private function staffCancelOrder() {
        // Check if user is logged in
        if (!isset($_SESSION['staff_user']) || !isset($_SESSION['staff_id'])) {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Unauthorized - Please log in'], 401);
            return;
        }
        
        // Check role - only admin and manager can cancel
        $role = $_SESSION['staff_user']['role'] ?? '';
        if (!in_array($role, ['admin', 'manager'])) {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Unauthorized - Only admin and manager can cancel orders'], 403);
            return;
        }
        
        if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
            error_log("[CANCEL ORDER] Wrong method: " . $_SERVER['REQUEST_METHOD']);
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Method not allowed'], 405);
            return;
        }
        
        $input = file_get_contents('php://input');
        $data = json_decode($input, true);
        
        error_log("[CANCEL ORDER] Request data: " . json_encode($data));
        
        if (!isset($data['order_id']) || !isset($data['reason'])) {
            error_log("[CANCEL ORDER] Missing data - order_id: " . (isset($data['order_id']) ? 'YES' : 'NO') . ", reason: " . (isset($data['reason']) ? 'YES' : 'NO'));
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Missing order_id or reason'], 400);
            return;
        }
        
        $orderId = intval($data['order_id']);
        $reason = $this->sanitize($data['reason']);
        $restaurantId = $_SESSION['staff_user']['restaurant_id'] ?? 0;
        $staffId = $_SESSION['staff_user']['id'] ?? 0;
        
        if ($restaurantId <= 0 || $staffId <= 0) {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Invalid session'], 401);
            return;
        }
        
        // Get order details to check status
        $query = "SELECT id, order_number, status, restaurant_id FROM orders WHERE uuid = ? AND restaurant_uuid = ?";
        $stmt = $this->db->prepare($query);
        $stmt->execute([$orderId, $restaurantId]);
        $order = $stmt->fetch(PDO::FETCH_ASSOC);
        
        if (!$order) {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Order not found'], 404);
            return;
        }
        
        // Check if order can be cancelled
        if (in_array($order['status'], ['ready', 'served', 'completed', 'cancelled'])) {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Cannot cancel order at this stage: ' . $order['status']], 400);
            return;
        }
        
        // Cancel the order
        try {
            error_log("[CANCEL ORDER] Attempting to cancel order ID: {$orderId}");
            
            // Use simpler update without updated_at (it will auto-update)
            $updateQuery = "UPDATE orders SET status = 'cancelled' WHERE uuid = ?";
            $stmt = $this->db->prepare($updateQuery);
            $result = $stmt->execute([$orderId]);
            
            if (!$result) {
                throw new PDOException("Failed to execute update query");
            }
            
            $rowsAffected = $stmt->rowCount();
            error_log("[CANCEL ORDER] Rows affected: {$rowsAffected}");
            
            if ($rowsAffected === 0) {
                error_log("[CANCEL ORDER] WARNING: No rows updated for order ID {$orderId}");
            }
            
            error_log("[CANCEL ORDER] Order {$orderId} status updated to cancelled");
            
            // Try to log the cancellation (table might not exist)
            try {
                $logQuery = "INSERT INTO order_logs (order_id, action, performed_by, notes, created_at) 
                             VALUES (?, 'cancelled', ?, ?, NOW())";
                $stmt = $this->db->prepare($logQuery);
                $stmt->execute([$orderId, $staffId, 'Order cancelled: ' . $reason]);
                error_log("[CANCEL ORDER] Log entry created");
            } catch (PDOException $logError) {
                // Log table might not exist, just log and continue
                error_log("[CANCEL ORDER] Log insert failed (table may not exist): " . $logError->getMessage());
            }
            
            error_log("[CANCEL ORDER] Success - Order {$order['order_number']} cancelled by staff {$staffId}");
            
            $this->sendResponse([
                'status' => 'OK',
                'message' => 'Order cancelled successfully',
                'order_number' => $order['order_number']
            ]);
            
        } catch (PDOException $e) {
            error_log("[CANCEL ORDER] Database error: " . $e->getMessage());
            error_log("[CANCEL ORDER] Error details: " . print_r($e, true));
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Database error: ' . $e->getMessage()], 500);
        }
    }
    
    /**
     * Check for delayed orders and send escalation notifications
     * Called by background polling (every 30 seconds)
     */
    private function checkDelayedOrders() {
        if ($_SERVER['REQUEST_METHOD'] !== 'GET') {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Method not allowed'], 405);
            return;
        }
        
        if (!isset($_SESSION['staff_id']) || !isset($_SESSION['staff_user'])) {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Unauthorized'], 401);
            return;
        }
        
        $restaurantId = $_SESSION['staff_user']['restaurant_id'];
        
        try {
            // Get orders that are in preparing status with estimated completion time passed
            $query = "
                SELECT 
                    o.id,
                    o.order_number,
                    o.table_id,
                    o.confirmed_at,
                    o.escalation_level,
                    o.first_reminder_at,
                    o.escalated_at,
                    o.served_by,
                    t.table_number,
                    TIMESTAMPDIFF(MINUTE, o.confirmed_at, NOW()) as minutes_since_confirmed,
                    (
                        SELECT MAX(mi.preparation_time)
                        FROM order_items oi
                        JOIN menu_items mi ON oi.menu_item_id = mi.id
                        WHERE oi.order_id = o.id
                    ) as estimated_prep_time
                FROM orders o
                JOIN tables t ON o.table_id = t.id
                WHERE o.restaurant_id = ?
                AND o.status IN ('confirmed', 'preparing')
                AND o.confirmed_at IS NOT NULL
            ";
            
            $stmt = $this->db->prepare($query);
            $stmt->execute([$restaurantId]);
            $orders = $stmt->fetchAll(PDO::FETCH_ASSOC);
            
            $notificationsSent = [];
            
            foreach ($orders as $order) {
                $estimatedTime = intval($order['estimated_prep_time']) ?: 15; // Default 15 mins
                $minutesSinceConfirmed = intval($order['minutes_since_confirmed']);
                $delayMinutes = $minutesSinceConfirmed - $estimatedTime;
                $escalationLevel = intval($order['escalation_level']);
                
                // First reminder at 5 minutes delay
                if ($delayMinutes >= 5 && $escalationLevel == 0) {
                    // Send reminder to waiter
                    $this->sendDelayNotification($order, 'waiter_reminder', $restaurantId);
                    
                    // Update escalation level
                    $updateStmt = $this->db->prepare("
                        UPDATE orders 
                        SET escalation_level = 1, first_reminder_at = NOW() 
                        WHERE uuid = ?
                    ");
                    $updateStmt->execute([$order['id']]);
                    
                    $notificationsSent[] = [
                        'order_id' => $order['id'],
                        'order_number' => $order['order_number'],
                        'type' => 'waiter_reminder',
                        'delay_minutes' => $delayMinutes
                    ];
                }
                
                // Escalate to admin and manager at 10 minutes delay
                if ($delayMinutes >= 10 && $escalationLevel == 1) {
                    // Send escalation to admin and manager
                    $this->sendDelayNotification($order, 'management_escalation', $restaurantId);
                    
                    // Update escalation level
                    $updateStmt = $this->db->prepare("
                        UPDATE orders 
                        SET escalation_level = 2, escalated_at = NOW() 
                        WHERE uuid = ?
                    ");
                    $updateStmt->execute([$order['id']]);
                    
                    $notificationsSent[] = [
                        'order_id' => $order['id'],
                        'order_number' => $order['order_number'],
                        'type' => 'management_escalation',
                        'delay_minutes' => $delayMinutes
                    ];
                }
            }
            
            $this->sendResponse([
                'status' => 'OK',
                'checked_orders' => count($orders),
                'notifications_sent' => $notificationsSent
            ]);
            
        } catch (Exception $e) {
            error_log("Delayed orders check error: " . $e->getMessage());
            $this->sendResponse([
                'status' => 'FAIL',
                'message' => 'Error checking delayed orders: ' . $e->getMessage()
            ], 500);
        }
    }
    
    /**
     * Send delay notification based on type
     */
    private function sendDelayNotification($order, $type, $restaurantId) {
        try {
            if ($type === 'waiter_reminder') {
                // Notify the waiter assigned to the order
                if ($order['served_by']) {
                    $message = "Order #{$order['order_number']} (Table {$order['table_number']}) is delayed by 5+ minutes. Please check the kitchen.";
                    
                    $stmt = $this->db->prepare("
                        INSERT INTO notifications (type, user_id, restaurant_id, message, reference_id, created_at)
                        VALUES ('order_delay_reminder', ?, ?, ?, ?, NOW())
                    ");
                    $stmt->execute([
                        $order['served_by'],
                        $restaurantId,
                        $message,
                        $order['id']
                    ]);
                }
            } elseif ($type === 'management_escalation') {
                // Notify all managers and admins
                $message = "⚠️ ESCALATION: Order #{$order['order_number']} (Table {$order['table_number']}) is delayed by 10+ minutes!";
                
                $staffQuery = "
                    SELECT id FROM staff_users 
                    WHERE restaurant_uuid = ? 
                    AND role IN ('admin', 'manager')
                    AND is_active = 1
                ";
                $staffStmt = $this->db->prepare($staffQuery);
                $staffStmt->execute([$restaurantId]);
                $managers = $staffStmt->fetchAll(PDO::FETCH_ASSOC);
                
                $insertStmt = $this->db->prepare("
                    INSERT INTO notifications (type, user_id, restaurant_id, message, reference_id, created_at)
                    VALUES ('order_delay_escalation', ?, ?, ?, ?, NOW())
                ");
                
                foreach ($managers as $manager) {
                    $insertStmt->execute([
                        $manager['id'],
                        $restaurantId,
                        $message,
                        $order['id']
                    ]);
                }
                
                // Also notify the waiter again
                if ($order['served_by']) {
                    $waiterMessage = "⚠️ URGENT: Order #{$order['order_number']} (Table {$order['table_number']}) is now 10+ minutes delayed. Management has been notified.";
                    $insertStmt->execute([
                        $order['served_by'],
                        $restaurantId,
                        $waiterMessage,
                        $order['id']
                    ]);
                }
            }
            
            return true;
        } catch (Exception $e) {
            error_log("Error sending delay notification: " . $e->getMessage());
            return false;
        }
    }
    
    /**
     * Submit contact message (public endpoint)
     */
    private function submitContactMessage() {
        // Comprehensive API validation
        $validation = ApiValidator::validateRequest([
            'methods' => ['POST'],
            'require_json' => true,
            'require_auth' => false,
            'required_params' => ['contact_name', 'contact_email', 'subject', 'message'],
            'max_size' => 2097152, // 2MB
            'rate_limit' => [
                'identifier' => $_SERVER['REMOTE_ADDR'],
                'max' => 10, // Only 10 contact form submissions per hour
                'window' => 3600
            ]
        ]);
        
        if (!$validation['valid']) {
            ApiValidator::sendError($validation['error']);
            return;
        }
        
        $data = $validation['data'];
        
        try {
            // Server-side validation (matches frontend validation)
            $rules = [
                'contact_name' => ['required' => true, 'length' => [2, 100]],
                'contact_email' => ['required' => true, 'email' => true],
                'subject' => ['required' => true, 'length' => [3, 200]],
                'message' => ['required' => true, 'length' => [10, 2000]]
            ];
            
            $validationData = [
                'contact_name' => $data['contact_name'] ?? '',
                'contact_email' => $data['contact_email'] ?? '',
                'subject' => $data['subject'] ?? '',
                'message' => $data['message'] ?? ''
            ];
            
            $errors = ValidationHelper::validateMultiple($rules, $validationData);
            
            if (!empty($errors)) {
                throw new Exception('Validation failed: ' . implode(', ', $errors));
            }
            
            // Sanitize inputs
            $contactName = ValidationHelper::sanitize($data['contact_name']);
            $contactEmail = ValidationHelper::sanitize($data['contact_email']);
            $subject = ValidationHelper::sanitize($data['subject']);
            $message = ValidationHelper::sanitize($data['message']);
            
            // Get database connection
            $db = new PDO(
                "mysql:host=" . DB_HOST . ";dbname=" . DB_NAME,
                DB_USER,
                DB_PWD,
                [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION]
            );
            
            // Check if restaurant exists by name (optional)
            $restaurantId = null;
            if (!empty($data['restaurant_name'])) {
                $stmt = $db->prepare("
                    SELECT id FROM restaurants 
                    WHERE name LIKE ? OR slug LIKE ?
                    LIMIT 1
                ");
                $searchTerm = '%' . ValidationHelper::sanitizeLike($data['restaurant_name']) . '%';
                $stmt->execute([$searchTerm, $searchTerm]);
                $restaurant = $stmt->fetch();
                if ($restaurant) {
                    $restaurantId = $restaurant['id'];
                }
            }
            
            // Insert message into support_messages table
            $stmt = $db->prepare("
                INSERT INTO support_messages 
                (restaurant_id, subject, message, channel, status, contact_name, contact_email, created_at)
                VALUES (?, ?, ?, 'web', 'new', ?, ?, NOW())
            ");
            
            $stmt->execute([
                $restaurantId,
                $subject,
                $message,
                $contactName,
                $contactEmail
            ]);
            
            $this->sendResponse([
                'status' => 'OK',
                'message' => 'Message sent successfully'
            ]);
            
        } catch (Exception $e) {
            $this->sendResponse([
                'status' => 'FAIL',
                'message' => $e->getMessage()
            ], 400);
        }
    }
    
