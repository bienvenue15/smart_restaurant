    /**
     * Export report in various formats
     */
    private function exportReport() {
        Permission::requireAny(['view_reports', 'manage_restaurant']);
        
        $type = $_GET['type'] ?? 'daily';
        $format = $_GET['format'] ?? 'csv';
        $restaurantId = $this->getRestaurantId();
        
        if (!$restaurantId) {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Restaurant ID not found'], 400);
            return;
        }
        
        try {
            // Fetch data based on report type
            $data = [];
            $filename = 'report_' . $type . '_' . date('Y-m-d');
            
            switch ($type) {
                case 'daily':
                    $date = $_GET['date'] ?? date('Y-m-d');
                    $filename = 'daily_report_' . $date;
                    $data = $this->fetchDailyReportData($restaurantId, $date);
                    break;
                    
                case 'weekly':
                    $weekStart = $_GET['week_start'] ?? date('Y-m-d', strtotime('monday this week'));
                    $filename = 'weekly_report_' . $weekStart;
                    $data = $this->fetchWeeklyReportData($restaurantId, $weekStart);
                    break;
                    
                case 'monthly':
                    $month = $_GET['month'] ?? date('Y-m');
                    $filename = 'monthly_report_' . $month;
                    $data = $this->fetchMonthlyReportData($restaurantId, $month);
                    break;
                    
                case 'yearly':
                    $year = $_GET['year'] ?? date('Y');
                    $filename = 'yearly_report_' . $year;
                    $data = $this->fetchYearlyReportData($restaurantId, $year);
                    break;
                    
                case 'custom':
                    $startDate = $_GET['start_date'] ?? date('Y-m-d', strtotime('-7 days'));
                    $endDate = $_GET['end_date'] ?? date('Y-m-d');
                    $filename = 'custom_report_' . $startDate . '_to_' . $endDate;
                    $data = $this->fetchCustomReportData($restaurantId, $startDate, $endDate);
                    break;
            }
            
            // Export based on format
            switch ($format) {
                case 'csv':
                    $this->exportAsCSV($data, $filename, $type);
                    break;
                case 'excel':
                    $this->exportAsExcel($data, $filename, $type);
                    break;
                case 'pdf':
                    $this->exportAsPDF($data, $filename, $type);
                    break;
                default:
                    $this->sendResponse(['status' => 'FAIL', 'message' => 'Invalid format'], 400);
            }
            
        } catch (Exception $e) {
            error_log('[EXPORT] Error: ' . $e->getMessage());
            $this->sendResponse(['status' => 'FAIL', 'message' => $e->getMessage()], 500);
        }
    }
    
