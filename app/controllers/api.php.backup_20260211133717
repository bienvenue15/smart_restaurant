    private function exportCSV($type, $date, $data) {
        $filename = "report_{$type}_{$date}.csv";
        
        header('Content-Type: text/csv');
        header('Content-Disposition: attachment; filename="' . $filename . '"');
        
        $output = fopen('php://output', 'w');
        
        // Write header
        fputcsv($output, ['SmartMenu - ' . ucfirst($type) . ' Report']);
        fputcsv($output, ['Generated: ' . date('Y-m-d H:i:s')]);
        fputcsv($output, ['Period: ' . $date]);
        fputcsv($output, []);
        
        // Write summary stats
        fputcsv($output, ['Summary']);
        fputcsv($output, ['Total Revenue', 'RWF ' . number_format($data['total_revenue'], 0)]);
        fputcsv($output, ['Total Orders', $data['total_orders']]);
        fputcsv($output, ['Average Order', 'RWF ' . number_format($data['avg_order'], 0)]);
        fputcsv($output, []);
        
        // Write detailed data if available
        if ($type === 'daily' && !empty($data['orders'])) {
            fputcsv($output, ['Order Details']);
            fputcsv($output, ['Order ID', 'Table', 'Time', 'Items', 'Amount', 'Status']);
            
            foreach ($data['orders'] as $order) {
                fputcsv($output, [
                    $order['id'],
                    $order['table_number'],
                    $order['created_at'],
                    $order['item_count'],
                    'RWF ' . number_format($order['total_amount'], 0),
                    $order['status']
                ]);
            }
        }
        
        fclose($output);
        exit();
    }
    
