    public function __construct() {
        parent::__construct();
        
        // Initialize database connection
        try {
            $dbPass = defined('DB_PASS') ? DB_PASS : (defined('DB_PWD') ? DB_PWD : '');
            $this->db = new PDO(
                "mysql:host=" . DB_HOST . ";dbname=" . DB_NAME,
                DB_USER,
                $dbPass,
                [
                    PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
                    PDO::ATTR_EMULATE_PREPARES => false,
                    PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC
                ]
            );
        } catch (PDOException $e) {
            error_log('[API] Database connection failed: ' . $e->getMessage());
            $this->sendResponse([
                'status' => 'FAIL',
                'message' => 'Database connection failed'
            ], 500);
            exit;
        }
        
        // Initialize UUID helper
        $this->uuidHelper = new UuidHelper($this->db);
        
        // Configure session ONLY if not already active
        if (session_status() === PHP_SESSION_NONE) {
            $sessionPath = $_SERVER['DOCUMENT_ROOT'] . '/sessions';
            if (!isset($_SERVER['DOCUMENT_ROOT']) || empty($_SERVER['DOCUMENT_ROOT'])) {
                $sessionPath = sys_get_temp_dir() . '/restaurant_sessions';
            }
            if (!is_dir($sessionPath)) {
                @mkdir($sessionPath, 0777, true);
            }
            if (is_dir($sessionPath) && is_writable($sessionPath)) {
                ini_set('session.save_path', $sessionPath);
            }
            session_start();
        }
        
        // Initialize subscription manager
        $this->subscriptionManager = SubscriptionManager::getInstance();
        
        // Initialize restaurant context
        $action = $_GET['action'] ?? '';
        $skipRestaurantCheck = in_array($action, ['get_plans', 'check_availability', 'submit_contact', 'get_announcements', 'dismiss_announcement']);
        $skipSubscriptionCheck = in_array($action, ['get_plans', 'check_availability', 'submit_contact', 'staff_logout', 'get_subscription_status', 'get_announcements', 'dismiss_announcement']);
        
        // For staff endpoints, use session-based restaurant ID
        $staffTicketActions = ['create_staff_ticket', 'get_staff_tickets', 'get_staff_ticket_detail'];
        $cashierActions = ['get_pending_payment_orders', 'get_today_transactions', 'get_session_summary'];
        $reportActions = ['get_daily_report', 'get_weekly_report', 'get_monthly_report', 'get_yearly_report', 'get_custom_report', 'export_report'];
        $kitchenActions = ['kitchen_update_availability'];
        $isStaffEndpoint = strpos($action, 'staff_') === 0 || in_array($action, array_merge($staffTicketActions, $cashierActions, $reportActions, $kitchenActions));
        
        if (!$skipRestaurantCheck) {
            if ($isStaffEndpoint) {
                // Staff endpoints: Get restaurant from staff session
                if (isset($_SESSION['staff_user']['restaurant_uuid'])) {
                    $this->restaurantId = $_SESSION['staff_user']['restaurant_uuid'];
                    
                    // ALL staff members must be on shift to perform actions (no exemptions)
                    $staffId = $_SESSION['staff_user']['uuid'] ?? null;
                    
                    // Only allow clock in/out, shift status, and read-only dashboard stats without being on shift
                    $allowedWithoutShift = [
                        'staff_clock_in', 
                        'staff_clock_out', 
                        'staff_get_shift_status',
                        'staff_get_dashboard_stats',
                        'staff_get_notifications',
                        'staff_get_all_liabilities',
                        'staff_check_delayed_orders',
                        'get_menu_data'
                    ];
                    $isAllowedAction = in_array($action, $allowedWithoutShift);
                    
                    // Require active shift for ALL actions except whitelisted ones
                    if ($staffId && !$isAllowedAction) {
                        // Check if staff is on shift by querying database directly
                        require_once __DIR__ . '/../models/Staff.php';
                        $staffModel = new Staff($this->db);
                        
                        if (!$staffModel->isOnShift($staffId)) {
                            $this->sendResponse([
                                'status' => 'FAIL',
                                'message' => 'You must clock in before performing any actions. Please clock in from the dashboard.'
                            ], 403);
                            exit;
                        }
                    }
                } else {
                    $this->sendResponse([
                        'status' => 'FAIL',
                        'message' => 'Staff session not found. Please login.'
                    ], 401);
                    exit;
                }
            } else {
                // Customer endpoints: Get restaurant from session (set by menu controller)
                if (isset($_SESSION['restaurant_id'])) {
                    $this->restaurantId = $_SESSION['restaurant_id'];
                } elseif (class_exists('Restaurant')) {
                    // Fallback to URL context for tenant-based access
                    Restaurant::initialize();
                    $this->restaurantId = Restaurant::getCurrentId();
                }
                
                // Check if restaurant context is set
                if ($this->restaurantId === null) {
                    $this->sendResponse([
                        'status' => 'FAIL',
                        'message' => 'Restaurant context not set. Please access via proper URL.'
                    ], 400);
                    exit;
                }
            }
            
            // Enforce subscription for all endpoints (except whitelisted)
            if (!$skipSubscriptionCheck && $this->restaurantId) {
                if (!$this->subscriptionManager->isActive($this->restaurantId)) {
                    $daysRemaining = $this->subscriptionManager->getDaysRemaining($this->restaurantId);
                    $isExpired = $this->subscriptionManager->isExpired($this->restaurantId);
                    
                    $this->sendResponse([
                        'status' => 'SUBSCRIPTION_EXPIRED',
                        'message' => $isExpired 
                            ? 'Your subscription has expired. Please renew to continue using the service.'
                            : 'Your restaurant account is inactive. Please contact support.',
                        'days_remaining' => $daysRemaining,
                        'is_expired' => $isExpired,
                        'restaurant_id' => $this->restaurantId
                    ], 403);
                    exit;
                }
            }
        }
        
        $this->menuModel = new Menu();
        $this->orderModel = new Order();
        $this->staffModel = new Staff();
        
        // Set JSON header
        header('Content-Type: application/json');
        
        // Enable CORS for local development
        header('Access-Control-Allow-Origin: *');
        header('Access-Control-Allow-Methods: GET, POST, PUT, DELETE, OPTIONS');
        header('Access-Control-Allow-Headers: Content-Type');
        
        // Handle preflight requests
        if ($_SERVER['REQUEST_METHOD'] === 'OPTIONS') {
            http_response_code(200);
            exit();
        }
    }
    
