        .modal.active, .modal[style*="display: flex"], .modal[style*="display:flex"] { display: flex !important; }
        .modal-content { background: white; border-radius: 12px; padding: 0; max-width: 90%; max-height: 90vh; overflow: auto; box-shadow: 0 10px 40px rgba(0,0,0,0.3); }
        .modal-header { padding: 20px 24px; border-bottom: 1px solid #e0e0e0; display: flex; justify-content: space-between; align-items: center; }
        .modal-header h3 { margin: 0; font-size: 20px; color: #2c3e50; }
        .modal-body { padding: 24px; }
        .modal-footer { padding: 16px 24px; border-top: 1px solid #e0e0e0; display: flex; justify-content: flex-end; gap: 12px; }
        .close-modal { background: none; border: none; font-size: 28px; cursor: pointer; color: #999; line-height: 1; padding: 0; width: 32px; height: 32px; }
        .close-modal:hover { color: #333; }
        .call-assigned { background: #e8f5e9; padding: 8px 12px; border-radius: 6px; margin-top: 8px; font-size: 13px; color: #2e7d32; }
        .form-group { margin-bottom: 16px; }
        .form-group label { display: block; margin-bottom: 8px; font-weight: 600; color: #555; }
        .form-control { width: 100%; padding: 10px 12px; border: 1px solid #ddd; border-radius: 6px; font-size: 14px; }
        
        /* Subscription Warning Banner */
        .subscription-warning-banner {
            background: linear-gradient(135deg, #ff9800, #ff5722);
            color: white;
            padding: 16px 24px;
            margin: 0 0 20px 0;
            border-radius: 8px;
            box-shadow: 0 4px 12px rgba(255, 87, 34, 0.3);
            animation: slideIn 0.5s ease-out;
        }
        .subscription-warning-banner.expired {
            background: linear-gradient(135deg, #f44336, #d32f2f);
        }
        .subscription-warning-banner.expiring {
            background: linear-gradient(135deg, #ff9800, #f57c00);
        }
        .warning-content {
            display: flex;
            align-items: center;
            gap: 16px;
        }
        .warning-content i {
            font-size: 32px;
            flex-shrink: 0;
        }
        .warning-info {
            flex: 1;
        }
        .warning-info strong {
            display: block;
            font-size: 18px;
            margin-bottom: 4px;
        }
        .warning-info span {
            font-size: 14px;
            opacity: 0.95;
        }
        .btn-renew {
            padding: 10px 20px;
            background: white;
            color: #f44336;
            border: none;
            border-radius: 6px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            white-space: nowrap;
        }
        .btn-renew:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        }
        .expiring .btn-renew {
            color: #ff9800;
        }
        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        /* Responsive Design */
        @media (max-width: 768px) {
