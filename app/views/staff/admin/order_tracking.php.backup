                </span>
            </h1>
            <p>Real-time order monitoring and management • Last updated: <span id="lastUpdate">Just now</span> • Next refresh: <span id="nextRefresh">5s</span></p>
        </div>

        <!-- Stats Grid -->
        <div class="stats-grid">
            <div class="stat-card pending" onclick="filterByStatus('pending')">
                <span class="stat-trend" id="trend-pending"><i class="fas fa-minus"></i></span>
                <div class="stat-icon">
                    <i class="fas fa-clock"></i>
                </div>
                <div class="stat-value" id="stat-pending">0</div>
                <div class="stat-label">Pending Orders</div>
            </div>

            <div class="stat-card preparing" onclick="filterByStatus('preparing')">
                <span class="stat-trend" id="trend-preparing"><i class="fas fa-minus"></i></span>
                <div class="stat-icon">
                    <i class="fas fa-fire"></i>
                </div>
                <div class="stat-value" id="stat-preparing">0</div>
                <div class="stat-label">In Kitchen</div>
            </div>

            <div class="stat-card ready" onclick="filterByStatus('ready')">
                <span class="stat-trend" id="trend-ready"><i class="fas fa-minus"></i></span>
                <div class="stat-icon">
                    <i class="fas fa-check-circle"></i>
                </div>
                <div class="stat-value" id="stat-ready">0</div>
                <div class="stat-label">Ready to Serve</div>
            </div>

            <div class="stat-card delayed" onclick="showDelayedOrders()">
                <span class="stat-trend" id="trend-delayed"><i class="fas fa-minus"></i></span>
                <div class="stat-icon">
                    <i class="fas fa-exclamation-triangle"></i>
                </div>
                <div class="stat-value" id="stat-delayed">0</div>
                <div class="stat-label">Delayed (>5 mins)</div>
            </div>
        </div>

        <!-- Filters -->
        <div class="filters-section">
            <div class="filter-row">
                <div class="filter-group">
                    <label><i class="fas fa-filter"></i> Status</label>
                    <select class="form-control" id="statusFilter" onchange="loadOrders()">
                        <option value="all">All Statuses</option>
                        <option value="pending">Pending</option>
                        <option value="confirmed">Confirmed</option>
                        <option value="preparing">Preparing</option>
                        <option value="ready">Ready</option>
                        <option value="served">Served</option>
                        <option value="completed">Completed</option>
                    </select>
                </div>

                <div class="filter-group">
                    <label><i class="fas fa-calendar"></i> Date</label>
                    <input type="date" class="form-control" id="dateFilter" value="<?php echo date('Y-m-d'); ?>" onchange="loadOrders()">
                </div>

                <div class="filter-group">
                    <label><i class="fas fa-search"></i> Search</label>
                    <input type="text" class="form-control" id="searchFilter" placeholder="Order #, Table #..." oninput="loadOrders()">
                </div>

                <div class="filter-group">
                    <label>&nbsp;</label>
                    <button class="btn btn-primary" onclick="loadOrders()">
                        <i class="fas fa-sync-alt"></i> Refresh
                    </button>
                </div>
            </div>
        </div>

        <!-- View Toggle -->
        <div class="timeline-view">
            <div class="timeline-header">
                <h2>Active Orders</h2>
                <div class="view-toggle">
                    <button class="active" onclick="switchView('kanban')">
                        <i class="fas fa-columns"></i> Kanban
                    </button>
                    <button onclick="switchView('list')">
                        <i class="fas fa-list"></i> List
                    </button>
                    <button onclick="switchView('timeline')">
                        <i class="fas fa-stream"></i> Timeline
                    </button>
                </div>
            </div>

            <!-- Kanban View -->
            <div id="kanbanView" class="orders-board">
                <div class="status-column">
                    <div class="status-column-header">
                        <h3><i class="fas fa-hourglass-start"></i> Confirmed</h3>
                        <span class="status-badge" id="badge-confirmed">0</span>
                    </div>
                    <div id="column-confirmed" class="order-cards-container"></div>
                </div>

                <div class="status-column">
                    <div class="status-column-header">
                        <h3><i class="fas fa-fire"></i> Preparing</h3>
                        <span class="status-badge" id="badge-preparing">0</span>
                    </div>
                    <div id="column-preparing" class="order-cards-container"></div>
                </div>

                <div class="status-column">
                    <div class="status-column-header">
                        <h3><i class="fas fa-bell"></i> Ready</h3>
                        <span class="status-badge" id="badge-ready">0</span>
                    </div>
                    <div id="column-ready" class="order-cards-container"></div>
                </div>

                <div class="status-column">
                    <div class="status-column-header">
                        <h3><i class="fas fa-utensils"></i> Served</h3>
                        <span class="status-badge" id="badge-served">0</span>
                    </div>
                    <div id="column-served" class="order-cards-container"></div>
                </div>
            </div>

            <!-- List View (Hidden by default) -->
            <div id="listView" style="display: none;">
                <div class="table-responsive">
                    <table style="width: 100%; border-collapse: collapse;">
                        <thead>
                            <tr style="background: #f8f9fa;">
                                <th style="padding: 12px; text-align: left;">Order #</th>
                                <th style="padding: 12px; text-align: left;">Table</th>
                                <th style="padding: 12px; text-align: left;">Status</th>
                                <th style="padding: 12px; text-align: left;">Time</th>
                                <th style="padding: 12px; text-align: left;">Items</th>
                                <th style="padding: 12px; text-align: left;">Total</th>
                                <th style="padding: 12px; text-align: left;">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="listViewBody"></tbody>
                    </table>
                </div>
            </div>

            <!-- Timeline View (Hidden by default) -->
            <div id="timelineView" style="display: none;">
                <div id="timelineContent"></div>
            </div>
        </div>
    </div>

    <!-- Order Details Modal -->
    <div class="modal-overlay" id="orderDetailsModal">
        <div class="modal-content">
            <div class="modal-header">
                <h2><i class="fas fa-receipt"></i> Order Details</h2>
                <button class="modal-close" onclick="closeOrderModal()">&times;</button>
            </div>
            <div class="modal-body" id="modalOrderDetails">
                <!-- Order details will be loaded here -->
            </div>
            <div class="modal-actions">
                <button class="btn btn-secondary" onclick="closeOrderModal()">
                    <i class="fas fa-times"></i> Close
                </button>
                <button class="btn btn-danger" id="btnCancelOrder" onclick="cancelOrder()" style="display: none;">
                    <i class="fas fa-ban"></i> Cancel Order
                </button>
            </div>
        </div>
    </div>

    <script>
        const BASE_URL = '<?php echo BASE_URL; ?>';
        let ordersData = [];
        let currentView = 'kanban';
        let previousStats = { pending: 0, preparing: 0, ready: 0, delayed: 0 };
        let refreshCountdown = 5;
        let newOrderIds = new Set();
        let currentOrderDetails = null;

        // Load orders on page load
        document.addEventListener('DOMContentLoaded', function() {
            // Ensure kanban view is visible on load
            document.getElementById('kanbanView').style.display = 'grid';
            document.getElementById('listView').style.display = 'none';
            document.getElementById('timelineView').style.display = 'none';
            
            loadOrders();
            setInterval(loadOrders, 5000); // Auto-refresh every 5 seconds
            updateClock();
            setInterval(updateClock, 1000);
            startRefreshCountdown();
        });

        // Countdown timer for next refresh
        function startRefreshCountdown() {
            setInterval(() => {
                refreshCountdown--;
                if (refreshCountdown <= 0) {
                    refreshCountdown = 5;
                }
                document.getElementById('nextRefresh').textContent = refreshCountdown + 's';
            }, 1000);
        }

        // Update clock
        function updateClock() {
            const now = new Date();
            document.getElementById('lastUpdate').textContent = now.toLocaleTimeString();
        }

        // Load orders from API with loading indicator
        function loadOrders() {
            const status = document.getElementById('statusFilter')?.value || 'all';
            const date = document.getElementById('dateFilter')?.value || '';
            const search = document.getElementById('searchFilter')?.value.trim() || '';
            
            console.log('Loading orders with filters:', { status, date, search });
            
            // Show refresh indicator
            const indicator = document.getElementById('refreshIndicator');
            if (indicator) indicator.classList.add('active');

            fetch(`${BASE_URL}/?req=api&action=staff_get_orders&status=${status}&date=${date}&search=${encodeURIComponent(search)}&include_items=true`)
                .then(response => response.json())
                .then(data => {
                    console.log('API Response:', data);
                    if (data.status === 'OK') {
                        const previousOrderIds = ordersData.map(o => o.id);
                        ordersData = data.data || [];
                        
                        console.log(`Loaded ${ordersData.length} orders`);
                        
                        // Detect new orders
                        const currentOrderIds = ordersData.map(o => o.id);
                        newOrderIds = new Set(currentOrderIds.filter(id => !previousOrderIds.includes(id)));
                        
                        renderOrders();
                        updateStats();
                        
                        // Play sound for new orders
                        if (newOrderIds.size > 0) {
                            playNotificationSound();
                        }
                        
                        // Remove new order highlighting after 3 seconds
                        setTimeout(() => {
                            newOrderIds.clear();
                        }, 3000);
                    } else {
                        console.error('API Error:', data);
                    }
                    if (indicator) indicator.classList.remove('active');
                })
                .catch(error => {
                    console.error('Error loading orders:', error);
                    ordersData = [];
                    renderOrders();
                    updateStats();
                    if (indicator) indicator.classList.remove('active');
                });
        }
        
        // Play notification sound for new orders
        function playNotificationSound() {
            try {
                const audio = new Audio('data:audio/wav;base64,UklGRnoGAABXQVZFZm10IBAAAAABAAEAQB8AAEAfAAABAAgAZGF0YQoGAACBhYqFbF1fdJivrJBhNjVgodDbq2EcBj+a2/LDciUFLIHO8tiJNwgZaLvt559NEAxQp+PwtmMcBjiR1/LMeSwFJHfH8N2QQAoUXrTp66hVFApGn+DyvmwhBjtly/DiamYdCTGH0fPTgjMGHm7A7+OZQQ0IX67k8LNlGgcrfczy0YEzBh5uwO/jmUENB16050p5Hx0');
                audio.volume = 0.3;
                audio.play().catch(e => console.log('Audio play failed:', e));
            } catch (e) {
                console.log('Sound notification not supported');
            }
        }

        // Update statistics with trend indicators
        function updateStats() {
            const stats = {
                pending: 0,
                preparing: 0,
                ready: 0,
                delayed: 0
            };

            const now = new Date();
            ordersData.forEach(order => {
                if (order.status === 'pending') stats.pending++;
                if (order.status === 'preparing') stats.preparing++;
                if (order.status === 'ready') stats.ready++;

                // Check if delayed (>5 mins since confirmed)
                if (order.confirmed_at && ['confirmed', 'preparing'].includes(order.status)) {
                    const confirmedTime = new Date(order.confirmed_at);
                    const diffMinutes = (now - confirmedTime) / 1000 / 60;
                    if (diffMinutes > 5) stats.delayed++;
                }
            });

            // Update stat values with animation and trends
            Object.keys(stats).forEach(key => {
                const element = document.getElementById('stat-' + key);
                const card = element.closest('.stat-card');
                const trendElement = document.getElementById('trend-' + key);
                
                if (element) {
                    const oldValue = parseInt(element.textContent) || 0;
                    const newValue = stats[key];
                    
                    // Animate value change
                    if (oldValue !== newValue) {
                        card.classList.add('updating');
                        setTimeout(() => {
                            element.textContent = newValue;
                            card.classList.remove('updating');
                            card.classList.add('updated');
                            setTimeout(() => card.classList.remove('updated'), 600);
                        }, 200);
                        
                        // Update trend indicator
                        if (trendElement) {
                            if (newValue > oldValue) {
                                trendElement.className = 'stat-trend up';
                                trendElement.innerHTML = '<i class=\"fas fa-arrow-up\"></i> +' + (newValue - oldValue);
                            } else if (newValue < oldValue) {
                                trendElement.className = 'stat-trend down';
                                trendElement.innerHTML = '<i class=\"fas fa-arrow-down\"></i> -' + (oldValue - newValue);
                            } else {
                                trendElement.className = 'stat-trend same';
                                trendElement.innerHTML = '<i class=\"fas fa-minus\"></i>';
                            }
                        }
                    } else {
                        element.textContent = newValue;
                    }
                }
            });

            // Store for next comparison
            previousStats = stats;
        }

        // Render orders based on current view
        function renderOrders() {
            console.log(`Rendering ${ordersData.length} orders in ${currentView} view`);
            if (currentView === 'kanban') {
                renderKanban();
            } else if (currentView === 'list') {
                renderList();
            } else {
                renderTimeline();
            }
        }

        // Render Kanban view
        function renderKanban() {
            console.log('renderKanban called with', ordersData.length, 'orders');
            const columns = {
                confirmed: document.getElementById('column-confirmed'),
                preparing: document.getElementById('column-preparing'),
                ready: document.getElementById('column-ready'),
                served: document.getElementById('column-served')
            };

            // Verify all columns exist
            Object.keys(columns).forEach(key => {
                if (!columns[key]) {
                    console.error(`Column ${key} not found!`);
                }
            });

            // Clear all columns
            Object.values(columns).forEach(col => {
                if (col) col.innerHTML = '';
            });

            // Count orders per status
            const counts = { confirmed: 0, preparing: 0, ready: 0, served: 0 };

            // Group orders by status with animation
            ordersData.forEach((order, index) => {
                const status = order.status;
                
                // Map statuses to kanban columns
                let targetStatus = null;
                if (status === 'pending' || status === 'confirmed') targetStatus = 'confirmed';
                else if (status === 'preparing') targetStatus = 'preparing';
                else if (status === 'ready') targetStatus = 'ready';
                else if (status === 'served' || status === 'completed') targetStatus = 'served';
                
                // Skip cancelled orders and unmapped statuses
                if (!targetStatus || status === 'cancelled') {
                    console.log(`Skipping order #${order.order_number} with status: ${status}`);
                    return;
                }
                
                console.log(`Order #${order.order_number} status: ${status} -> ${targetStatus}`);
                
                if (columns[targetStatus]) {
                    counts[targetStatus]++;
                    const cardHtml = createOrderCard(order);
                    const tempDiv = document.createElement('div');
                    tempDiv.innerHTML = cardHtml;
                    const cardElement = tempDiv.firstElementChild;
                    
                    if (!cardElement) {
                        console.error(`Failed to create card element for order #${order.order_number}`, cardHtml);
                        return;
                    }
                    
                    // Add new-order class if this is a new order
                    if (newOrderIds.has(order.id)) {
                        cardElement.classList.add('new-order');
                    }
                    
                    // Set animation delay
                    cardElement.style.animationDelay = (index * 0.03) + 's';
                    columns[targetStatus].appendChild(cardElement);
                } else {
                    console.warn(`No column for status: ${targetStatus}`);
                }
            });

            console.log('Kanban counts:', counts);

            // Update badges
            Object.keys(counts).forEach(status => {
                const badge = document.getElementById(`badge-${status}`);
                if (badge) badge.textContent = counts[status];
            });

            // Show empty state if no orders
            Object.keys(columns).forEach(status => {
                if (counts[status] === 0 && columns[status]) {
                    columns[status].innerHTML = `
                        <div class="empty-state">
                            <i class="fas fa-inbox"></i>
                            <p>No ${status} orders</p>
                        </div>
                    `;
                }
            });
        }

        // Create order card HTML
        function createOrderCard(order) {
            const now = new Date();
            const confirmedTime = order.confirmed_at ? new Date(order.confirmed_at) : new Date(order.created_at);
            const diffMinutes = Math.floor((now - confirmedTime) / 1000 / 60);
            const isDelayed = diffMinutes > 5 && ['confirmed', 'preparing'].includes(order.status);
            
            // Format time display - show hours after 59 minutes
            let timeDisplay;
            if (diffMinutes > 59) {
                const hours = Math.floor(diffMinutes / 60);
                const mins = diffMinutes % 60;
                timeDisplay = mins > 0 ? `${hours}h ${mins}m` : `${hours}h`;
            } else {
                timeDisplay = `${diffMinutes} mins`;
            }
            
            const items = order.items || [];
            const itemsHtml = items.slice(0, 3).map(item => 
                `<div class="order-item"><strong>${item.quantity}×</strong> ${item.item_name || item.name}</div>`
            ).join('');
            
            const moreItems = items.length > 3 ? `<div class="order-item">+${items.length - 3} more...</div>` : '';

            return `
                <div class="order-card ${isDelayed ? 'delayed' : ''}" onclick="viewOrderDetails(${order.id})">
                    <div class="order-card-header">
                        <span class="order-number">#${order.order_number}</span>
                        <span class="order-time ${isDelayed ? 'urgent' : ''}">
                            <i class="fas fa-clock"></i> ${timeDisplay}
                        </span>
                    </div>
                    
                    <div class="order-details">
                        <div class="order-detail-row">
                            <span class="label"><i class="fas fa-chair"></i> Table:</span>
                            <span class="value">${order.table_number}</span>
                        </div>
                        <div class="order-detail-row">
                            <span class="label"><i class="fas fa-user"></i> Waiter:</span>
                            <span class="value">${order.table_assigned_waiter || order.created_by_name || 'Unassigned'}</span>
                        </div>
                        <div class="order-detail-row">
                            <span class="label"><i class="fas fa-money-bill"></i> Total:</span>
                            <span class="value">${parseFloat(order.total_amount || 0).toLocaleString()} RWF</span>
                        </div>
                    </div>

                    <div class="order-items">
                        ${itemsHtml}
                        ${moreItems}
                    </div>

                    <div class="order-progress">
                        <div class="order-progress-bar" style="width: ${getProgressPercentage(order.status)}%"></div>
                    </div>

                    ${isDelayed ? '<div style="color: #e74c3c; font-size: 11px; margin-top: 8px; font-weight: 600;"><i class="fas fa-exclamation-triangle"></i> DELAYED - Check kitchen!</div>' : ''}
                </div>
            `;
        }

        // Get progress percentage
        function getProgressPercentage(status) {
            const progress = {
                pending: 10,
                confirmed: 25,
                preparing: 50,
                ready: 75,
                served: 90,
                completed: 100
            };
            return progress[status] || 0;
        }

        // Render list view with dynamic updates
        function renderList() {
            const tbody = document.getElementById('listViewBody');
            tbody.innerHTML = '';

            if (ordersData.length === 0) {
                tbody.innerHTML = '<tr><td colspan="7" style="text-align: center; padding: 40px; color: #95a5a6;"><i class="fas fa-inbox" style="font-size: 48px; display: block; margin-bottom: 15px; opacity: 0.5;"></i>No orders found</td></tr>';
                return;
            }

            ordersData.forEach((order, index) => {
                const row = document.createElement('tr');
                row.style.borderBottom = '1px solid #e0e6ed';
                row.style.opacity = '0';
                row.style.animation = 'fadeInCard 0.3s ease forwards';
                row.style.animationDelay = (index * 0.02) + 's';
                
                // Highlight new orders
                if (newOrderIds.has(order.id)) {
                    row.style.background = '#fff3cd';
                    setTimeout(() => {
                        row.style.transition = 'background 1s ease';
                        row.style.background = 'white';
                    }, 2000);
                }
                
                row.innerHTML = `
                    <td style="padding: 12px; font-weight: 600;">#${order.order_number}</td>
                    <td style="padding: 12px;">Table ${order.table_number}</td>
                    <td style="padding: 12px;">${getStatusBadge(order.status)}</td>
                    <td style="padding: 12px;">${getTimeAgo(order.created_at)}</td>
                    <td style="padding: 12px;">${(order.items || []).length} items</td>
                    <td style="padding: 12px; font-weight: 600;">${parseFloat(order.total_amount || 0).toLocaleString()} RWF</td>
                    <td style="padding: 12px;">
                        <button class="btn btn-sm btn-primary" onclick="viewOrderDetails(${order.id})" style="transition: all 0.3s;">
                            <i class="fas fa-eye"></i> View
                        </button>
                    </td>
                `;
                tbody.appendChild(row);
            });
        }

        // Render timeline view
        function renderTimeline() {
            const container = document.getElementById('timelineContent');
            
            if (ordersData.length === 0) {
                container.innerHTML = `
                    <div class="timeline-empty">
                        <i class="fas fa-clock"></i>
                        <h3>No Orders Yet</h3>
                        <p>Orders will appear here in chronological order</p>
                    </div>
                `;
                return;
            }
            
            // Sort orders by created_at (newest first)
            const sortedOrders = [...ordersData].sort((a, b) => {
                return new Date(b.created_at) - new Date(a.created_at);
            });
            
            const now = new Date();
            let html = '<div class="timeline-container"><div class="timeline-line"></div>';
            
            sortedOrders.forEach(order => {
                const createdTime = new Date(order.created_at);
                const confirmedTime = order.confirmed_at ? new Date(order.confirmed_at) : null;
                const diffMinutes = confirmedTime ? Math.floor((now - confirmedTime) / 1000 / 60) : 0;
                const isDelayed = diffMinutes > 5 && ['confirmed', 'preparing'].includes(order.status);
                
                // Format time
                const timeStr = createdTime.toLocaleTimeString('en-US', { 
                    hour: '2-digit', 
                    minute: '2-digit' 
                });
                
                // Get items summary
                const items = order.items || [];
                const itemsSummary = items.slice(0, 2).map(item => 
                    `${item.quantity}× ${item.item_name || item.name}`
                ).join(', ');
                const moreItems = items.length > 2 ? ` +${items.length - 2} more` : '';
                
                // Calculate elapsed time
                const elapsed = Math.floor((now - createdTime) / 1000 / 60);
                const elapsedStr = elapsed < 60 ? `${elapsed} mins` : `${Math.floor(elapsed/60)}h ${elapsed%60}m`;
                
                html += `
                    <div class="timeline-item">
                        <div class="timeline-dot ${order.status} ${isDelayed ? 'delayed' : ''}"></div>
                        <div class="timeline-content ${isDelayed ? 'delayed' : ''}">
                            <div class="timeline-time"><i class="fas fa-clock"></i>${timeStr}</div>
                            <div class="timeline-order-header">
                                <span class="timeline-order-number">
                                    #${order.order_number}
                                    ${isDelayed ? `<span class="timeline-delay-badge"><i class="fas fa-exclamation-triangle"></i> DELAYED ${diffMinutes} mins</span>` : ''}
                                </span>
                                ${getStatusBadge(order.status)}
                            </div>
                            
                            <div class="timeline-order-meta">
                                <div class="timeline-meta-item">
                                    <span class="timeline-meta-label"><i class="fas fa-chair"></i> Table</span>
                                    <span class="timeline-meta-value">${order.table_number}</span>
                                </div>
                                <div class="timeline-meta-item">
                                    <span class="timeline-meta-label"><i class="fas fa-user"></i> Waiter</span>
                                    <span class="timeline-meta-value">${order.table_assigned_waiter || order.created_by_name || 'N/A'}</span>
                                </div>
                                <div class="timeline-meta-item">
                                    <span class="timeline-meta-label"><i class="fas fa-money-bill"></i> Amount</span>
                                    <span class="timeline-meta-value">${parseFloat(order.total_amount || 0).toLocaleString()} RWF</span>
                                </div>
                            </div>
                            
                            <div class="timeline-items-list">
                                <strong>${items.length} item${items.length !== 1 ? 's' : ''}:</strong> 
                                ${itemsSummary}${moreItems}
                            </div>
                            
                            <div style="margin-top: 10px; display: flex; justify-content: space-between; align-items: center;">
                                <span style="font-size: 11px; color: #7f8c8d;">
                                    <i class="fas fa-clock"></i> ${elapsedStr} ago
                                </span>
                                <button 
                                    onclick="viewOrderDetails(${order.id})" 
                                    style="padding: 6px 12px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); 
                                           color: white; border: none; border-radius: 6px; cursor: pointer; 
                                           font-size: 12px; font-weight: 600;"
                                >
                                    <i class="fas fa-eye"></i> View Details
                                </button>
                            </div>
                        </div>
                    </div>
                `;
            });
            
            html += '</div>';
            container.innerHTML = html;
        }

        // Get status badge
        function getStatusBadge(status) {
            const colors = {
                pending: '#ffc107',
                confirmed: '#17a2b8',
                preparing: '#fd7e14',
                ready: '#28a745',
                served: '#6c757d',
                completed: '#007bff',
                cancelled: '#dc3545'
            };
            const icons = {
                pending: 'clock',
                confirmed: 'check',
                preparing: 'fire',
                ready: 'bell',
                served: 'utensils',
                completed: 'check-circle',
                cancelled: 'ban'
            };
            return `<span style="background: ${colors[status] || '#6c757d'}; color: white; padding: 4px 12px; border-radius: 12px; font-size: 11px; font-weight: 600;"><i class="fas fa-${icons[status] || 'info'}"></i> ${status.toUpperCase()}</span>`;
        }

        // Get time ago
        function getTimeAgo(timestamp) {
            const now = new Date();
            const time = new Date(timestamp);
            const diff = Math.floor((now - time) / 1000 / 60);
            if (diff < 1) return 'Just now';
            if (diff < 60) return diff + ' mins ago';
            return Math.floor(diff / 60) + ' hrs ago';
        }

        // Switch view with smooth transitions
        function switchView(view) {
            currentView = view;
            
            // Update active button
            document.querySelectorAll('.view-toggle button').forEach(btn => {
                btn.classList.remove('active');
            });
            event.target.closest('button').classList.add('active');

            // Smooth transition
            const allViews = ['kanbanView', 'listView', 'timelineView'];
            allViews.forEach(v => {
                const el = document.getElementById(v);
                el.style.transition = 'opacity 0.3s ease';
                el.style.opacity = '0';
            });

            setTimeout(() => {
                // Show/hide views
                document.getElementById('kanbanView').style.display = view === 'kanban' ? 'grid' : 'none';
                document.getElementById('listView').style.display = view === 'list' ? 'block' : 'none';
                document.getElementById('timelineView').style.display = view === 'timeline' ? 'block' : 'none';

                // Fade in active view
                const activeView = document.getElementById(view + 'View');
                setTimeout(() => {
                    activeView.style.opacity = '1';
                    renderOrders();
                }, 50);
            }, 300);
        }

        // Filter by status with visual feedback
        function filterByStatus(status) {
            document.getElementById('statusFilter').value = status;
            const filterSection = document.querySelector('.filters-section');
            filterSection.style.transform = 'scale(0.98)';
            filterSection.style.transition = 'transform 0.2s ease';
            setTimeout(() => {
                filterSection.style.transform = 'scale(1)';
            }, 200);
            loadOrders();
        }

        // Show delayed orders with visual highlighting
        function showDelayedOrders() {
            const delayedOrders = ordersData.filter(order => {
                if (!order.confirmed_at || !['confirmed', 'preparing'].includes(order.status)) return false;
                const confirmedTime = new Date(order.confirmed_at);
                const now = new Date();
                const diffMinutes = (now - confirmedTime) / 1000 / 60;
                return diffMinutes > 5;
            });

            if (delayedOrders.length === 0) {
                alert('No delayed orders! Kitchen is running smoothly.');
                return;
            }

            // Switch to kanban view if not already there
            if (currentView !== 'kanban') {
                const kanbanBtn = document.querySelector('.view-toggle button:first-child');
                kanbanBtn.click();
            }

            // Highlight delayed cards after view loads
            setTimeout(() => {
                const delayedCards = document.querySelectorAll('.order-card.delayed');
                delayedCards.forEach((card, index) => {
                    setTimeout(() => {
                        card.style.boxShadow = '0 0 30px rgba(231, 76, 60, 0.8)';
                        card.style.transform = 'scale(1.02)';
                        setTimeout(() => {
                            card.style.boxShadow = '';
                            card.style.transform = '';
                        }, 1500);
                    }, index * 200);
                });
            }, 500);

            alert(`Found ${delayedOrders.length} delayed order${delayedOrders.length > 1 ? 's' : ''}!\n\nThey are highlighted in red with pulsing animation.`);
        }

        // View order details in modal
        function viewOrderDetails(orderId) {
            const order = ordersData.find(o => o.id === orderId);
            if (!order) {
                alert('Order not found!');
                return;
            }
            
            currentOrderDetails = order;
            
            // Build order details HTML
            const items = order.items || [];
            const itemsHtml = items.map(item => `
                <div class="item-row">
                    <div>
                        <strong>${item.quantity}× ${item.item_name || item.name}</strong>
                        ${item.special_instructions ? `<div style="font-size: 12px; color: #7f8c8d; margin-top: 3px;"><i class="fas fa-comment"></i> ${item.special_instructions}</div>` : ''}
                    </div>
                    <div style="font-weight: 600;">${parseFloat(item.price || 0).toLocaleString()} RWF</div>
                </div>
            `).join('');
            
            const modalBody = document.getElementById('modalOrderDetails');
            modalBody.innerHTML = `
                <div class="detail-row">
                    <span class="detail-label"><i class="fas fa-hashtag"></i> Order Number</span>
                    <span class="detail-value"><strong>${order.order_number}</strong></span>
                </div>
                <div class="detail-row">
                    <span class="detail-label"><i class="fas fa-chair"></i> Table</span>
                    <span class="detail-value">${order.table_number}</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label"><i class="fas fa-signal"></i> Status</span>
                    <span class="detail-value">${getStatusBadge(order.status)}</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label"><i class="fas fa-user"></i> Waiter</span>
                    <span class="detail-value">${order.table_assigned_waiter || order.created_by_name || 'Unassigned'}</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label"><i class="fas fa-clock"></i> Order Time</span>
                    <span class="detail-value">${new Date(order.created_at).toLocaleString()}</span>
                </div>
                ${order.special_instructions ? `
                <div class="detail-row">
                    <span class="detail-label"><i class="fas fa-comment"></i> Special Instructions</span>
                    <span class="detail-value">${order.special_instructions}</span>
                </div>
                ` : ''}
                
                <div class="items-list">
                    <h3><i class="fas fa-utensils"></i> Order Items (${items.length})</h3>
                    ${itemsHtml}
                </div>
                
                <div class="detail-row" style="margin-top: 20px; padding-top: 20px; border-top: 2px solid #e0e6ed;">
                    <span class="detail-label" style="font-size: 18px;"><i class="fas fa-money-bill"></i> Total Amount</span>
                    <span class="detail-value" style="font-size: 20px; font-weight: 700; color: #27ae60;">${parseFloat(order.total_amount || 0).toLocaleString()} RWF</span>
                </div>
            `;
            
            // Show/hide cancel button based on status
            const btnCancel = document.getElementById('btnCancelOrder');
            if (['pending', 'confirmed', 'preparing'].includes(order.status)) {
                btnCancel.style.display = 'inline-block';
            } else {
                btnCancel.style.display = 'none';
            }
            
            // Show modal
            document.getElementById('orderDetailsModal').classList.add('active');
        }
        
        // Close order modal
        function closeOrderModal() {
            document.getElementById('orderDetailsModal').classList.remove('active');
            currentOrderDetails = null;
        }
        
        // Cancel order
        function cancelOrder() {
            if (!currentOrderDetails) return;
            
            const order = currentOrderDetails;
            
            // Check if order can be cancelled
            if (['ready', 'served', 'completed', 'cancelled'].includes(order.status)) {
                alert('Cannot cancel order at this stage!');
                return;
            }
            
            const reason = prompt('Enter cancellation reason (required):');
            if (!reason || reason.trim() === '') {
                alert('Cancellation reason is required!');
                return;
            }
            
            if (!confirm(`Cancel order ${order.order_number}?\\n\\nReason: ${reason}`)) {
                return;
            }
            
            // Show loading
            const btnCancel = document.getElementById('btnCancelOrder');
            btnCancel.disabled = true;
            btnCancel.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Cancelling...';
            
            // Send cancel request
            fetch(`${BASE_URL}/?req=api&action=staff_cancel_order`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    order_id: order.id,
                    reason: reason
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.status === 'OK') {
                    alert('Order cancelled successfully!');
                    closeOrderModal();
                    loadOrders(); // Refresh orders
                } else {
                    alert('Failed to cancel order: ' + (data.message || 'Unknown error'));
                }
            })
            .catch(error => {
                console.error('Cancel error:', error);
                alert('Error cancelling order. Please try again.');
            })
            .finally(() => {
                btnCancel.disabled = false;
                btnCancel.innerHTML = '<i class=\"fas fa-ban\"></i> Cancel Order';
            });
        }
        
        // Close modal on overlay click
        document.getElementById('orderDetailsModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeOrderModal();
            }
        });
        
        // Mobile menu toggle functions
        function toggleMobileMenu() {
            const sidebar = document.querySelector('.sidebar');
            const overlay = document.querySelector('.mobile-overlay');
            if (sidebar && overlay) {
                sidebar.classList.toggle('mobile-open');
                overlay.classList.toggle('active');
                document.body.style.overflow = sidebar.classList.contains('mobile-open') ? 'hidden' : '';
            }
        }
        
        function closeMobileMenu() {
            const sidebar = document.querySelector('.sidebar');
            const overlay = document.querySelector('.mobile-overlay');
            if (sidebar && overlay) {
                sidebar.classList.remove('mobile-open');
                overlay.classList.remove('active');
                document.body.style.overflow = '';
            }
        }
    </script>
</body>
</html>
