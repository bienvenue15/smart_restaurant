    /**
     * Get single menu item
     */
    private function getMenuItem() {
        $itemUuid = isset($_GET['uuid']) ? $this->sanitize($_GET['uuid']) : '';
        
        if (empty($itemUuid)) {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Invalid item UUID'], 400);
            return;
        }
        
        // Validate UUID format
        if (!preg_match('/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i', $itemUuid)) {
            $this->sendResponse(['status' => 'FAIL', 'message' => 'Invalid UUID format'], 400);
            return;
        }
        
        $result = $this->menuModel->getItemByUuid($itemUuid);
        $this->sendResponse($result);
    }
    
