        function showTodayTransactions() {
            const section = document.getElementById('cashierTransactions');
            const content = document.getElementById('transactionsContent');
            section.style.display = 'block';
            content.innerHTML = '<div class="loading" style="text-align: center; padding: 40px;"><i class="fas fa-spinner fa-spin" style="font-size: 2rem; color: #667eea;"></i><p>Loading transactions...</p></div>';
            
            // Fetch both order transactions and cash transactions
            Promise.all([
                fetch(`${BASE_URL}/?req=api&action=get_today_transactions&restaurant_id=${RESTAURANT_ID}`).then(r => r.json()),
                fetch(`${BASE_URL}/?req=api&action=staff_get_cash_transactions`).then(r => r.json())
            ])
            .then(([ordersData, cashData]) => {
                const orders = (ordersData.status === 'OK' && ordersData.data) ? ordersData.data : [];
                const cashTransactions = (cashData.status === 'OK' && cashData.data) ? cashData.data : [];
                
                if (orders.length === 0 && cashTransactions.length === 0) {
                    content.innerHTML = '<div class="empty-state" style="text-align: center; padding: 60px; color: #6b7280;"><i class="fas fa-receipt" style="font-size: 4rem; color: #d1d5db; margin-bottom: 20px;"></i><h3>No Transactions Yet</h3><p>No transactions recorded for today.</p></div>';
                    return;
                }
                
                let html = '<div style="display: flex; flex-direction: column; gap: 30px;">';
                
                // Display Cash Transactions (Deposits, Withdrawals, Expenses)
                if (cashTransactions.length > 0) {
                    html += `
                        <div>
                            <h3 style="margin: 0 0 15px 0; color: #1f2937; display: flex; align-items: center; gap: 10px;">
                                <i class="fas fa-money-bill-wave"></i> Cash Transactions
                            </h3>
                            <div style="overflow-x: auto;">
                                <table style="width: 100%; border-collapse: collapse;">
                                    <thead>
                                        <tr style="background: #f9fafb; border-bottom: 2px solid #e5e7eb;">
                                            <th style="padding: 12px; text-align: left; font-weight: 600;">Type</th>
                                            <th style="padding: 12px; text-align: left; font-weight: 600;">Description</th>
                                            <th style="padding: 12px; text-align: left; font-weight: 600;">Time</th>
                                            <th style="padding: 12px; text-align: right; font-weight: 600;">Amount</th>
                                            <th style="padding: 12px; text-align: left; font-weight: 600;">Reference</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        ${cashTransactions.map(trans => {
                                            const isNegative = ['withdrawal', 'expense', 'refund'].includes(trans.transaction_type);
                                            const typeColors = {
                                                deposit: { bg: '#d1fae5', text: '#065f46' },
                                                withdrawal: { bg: '#fee2e2', text: '#991b1b' },
                                                expense: { bg: '#fed7aa', text: '#92400e' },
                                                sale: { bg: '#dbeafe', text: '#1e40af' },
                                                refund: { bg: '#fecaca', text: '#7f1d1d' }
                                            };
                                            const colors = typeColors[trans.transaction_type] || { bg: '#f3f4f6', text: '#374151' };
                                            
                                            return `
                                            <tr style="border-bottom: 1px solid #f3f4f6;">
                                                <td style="padding: 12px;">
                                                    <span style="background: ${colors.bg}; color: ${colors.text}; padding: 4px 12px; border-radius: 12px; font-size: 12px; font-weight: 600; text-transform: capitalize;">
                                                        ${trans.transaction_type}
                                                    </span>
                                                </td>
                                                <td style="padding: 12px;">${trans.description || 'N/A'}</td>
                                                <td style="padding: 12px; color: #6b7280;">${new Date(trans.created_at).toLocaleTimeString()}</td>
                                                <td style="padding: 12px; text-align: right; font-weight: 600; color: ${isNegative ? '#dc2626' : '#10b981'};">
                                                    ${isNegative ? '-' : '+'}RWF ${parseInt(trans.amount || 0).toLocaleString()}
                                                </td>
                                                <td style="padding: 12px; color: #6b7280; font-size: 12px;">${trans.reference_number || '-'}</td>
                                            </tr>
                                        `}).join('')}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    `;
                }
                
                // Display Order Transactions
                if (orders.length > 0) {
                    html += `
                        <div>
                            <h3 style="margin: 0 0 15px 0; color: #1f2937; display: flex; align-items: center; gap: 10px;">
                                <i class="fas fa-shopping-cart"></i> Orders
                            </h3>
                            <div style="overflow-x: auto;">
                                <table style="width: 100%; border-collapse: collapse;">
                                    <thead>
                                        <tr style="background: #f9fafb; border-bottom: 2px solid #e5e7eb;">
                                            <th style="padding: 12px; text-align: left; font-weight: 600;">Order #</th>
                                            <th style="padding: 12px; text-align: left; font-weight: 600;">Table</th>
                                            <th style="padding: 12px; text-align: left; font-weight: 600;">Time</th>
                                            <th style="padding: 12px; text-align: right; font-weight: 600;">Amount</th>
                                            <th style="padding: 12px; text-align: center; font-weight: 600;">Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        ${orders.map(order => `
                                            <tr style="border-bottom: 1px solid #f3f4f6;">
                                                <td style="padding: 12px; font-weight: 600;">${order.order_number || '#' + order.id}</td>
                                                <td style="padding: 12px;">${order.table_number || 'N/A'}</td>
                                                <td style="padding: 12px; color: #6b7280;">${new Date(order.created_at).toLocaleTimeString()}</td>
                                                <td style="padding: 12px; text-align: right; font-weight: 600; color: #10b981;">RWF ${parseInt(order.total_amount || 0).toLocaleString()}</td>
                                                <td style="padding: 12px; text-align: center;">
                                                    <span style="background: ${order.payment_status === 'paid' ? '#d1fae5' : '#fef3c7'}; color: ${order.payment_status === 'paid' ? '#065f46' : '#92400e'}; padding: 4px 12px; border-radius: 12px; font-size: 12px; font-weight: 600;">
                                                        ${order.payment_status === 'paid' ? 'Paid' : 'Pending'}
                                                    </span>
                                                </td>
                                            </tr>
                                        `).join('')}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    `;
                }
                
                html += '</div>';
                content.innerHTML = html;
            })
            .catch(err => {
                content.innerHTML = '<div class="empty-state" style="text-align: center; padding: 40px; color: #dc3545;"><i class="fas fa-exclamation-circle" style="font-size: 3rem; margin-bottom: 15px;"></i><p>Failed to load transactions. Please try again.</p></div>';
            });
        }
        
